@Override
    public RequisitionDictDto getRequisitionDict() {
        List<TabEntity> tabEntities = tabRepository.findAll();
        List<StatusMappingEntity> statusMappingEntities = statusMappingRepository.findDistinctOnLkrCodeStatusMapping();
        List<RequisitionStatusItem> requisitionStatusItemList = new ArrayList<>();
        List<RequisitionTabItem> tabItemList = new ArrayList<>();
        if (!tabEntities.isEmpty()) {
            for (TabEntity tabEntity : tabEntities) {
                tabItemList.add(mapperService.mapTabEntity(tabEntity));
            }
        }
        if (!tabEntities.isEmpty()) {
            for (StatusMappingEntity statusMappingEntity : statusMappingEntities) {
                List<TabMappingEntity> tabMappingEntities = tabMappingRepository.findTabMappingEntitiesByLkrCode(statusMappingEntity.getLkrCode());
                List<String> availableTabs = tabMappingEntities.stream().map(TabMappingEntity::getTabCode).toList();
                requisitionStatusItemList.add(mapperService.mapStatusMappingEntity(statusMappingEntity, availableTabs));

            }
        }

        // этапы рассмотрения кандидатов
        List<CandidateStageItem> stageList = new ArrayList<>();
        List<CandidateStageEntity> stageEntities = candidateStageRepository.findAll();
        Map<Integer, CandidateStageEntity> stages = new HashMap<>();
        if (!stageEntities.isEmpty()) {
            stageEntities.forEach(e -> {
                stages.put(e.getId(), e);
                stageList.add(mapperService.mapCandidateStageEntity(e));
            });
        }

        // статусы этапов рассмотрения
        List<CandidateStageStatusItem> stageStatusList = new ArrayList<>();

        List<CandidateStatusEntity> statusEntities = candidateStatusRepository.findAll();
        Map<Integer, CandidateStatusEntity> statuses = getCandidateStatusEntitiesMap(statusEntities);

        List<CandidateStageStatusEntity> stageStatusEntities = candidateStageStatusRepository.findAll();
        if (!stageStatusEntities.isEmpty()) {
            stageStatusEntities.forEach(stageStatus -> {
                CandidateStageStatusItem item = mapperService.mapStageStatusEntities(
                        stages.get(stageStatus.getStageId()),
                        statuses.get(stageStatus.getStatusId())
                );
                stageStatusList.add(item);
            });
        }

        // действия с кандидатами
        List<CandidateActionItem> candidateActionList = new ArrayList<>();
        List<CandidateActionEntity> actionEntities = candidateActionRepository.findAll();
        if (!actionEntities.isEmpty()) {
            actionEntities.forEach(e -> {
                candidateActionList.add(mapperService.mapCandidateActionEntity(e));
            });
        }

        // вкладки кандидатов
        List<CandidateTabItem> candidateTabList = new ArrayList<>();
        List<CandidateTabEntity> candidateTabEntities = candidateTabRepository.findAll();
        if (!candidateTabEntities.isEmpty()) {
            candidateTabEntities.forEach(e -> {
                candidateTabList.add(mapperService.mapCandidateTabEntity(e));
            });
        }

        // действия с интервьюерами
        List<InterviewersActionItem> interviewersActionList = new ArrayList<>();
        List<InterviewersActionEntity> interviewersActionEntities = interviewersActionRepository.findAllSorted();
        if (!interviewersActionEntities.isEmpty()) {
            interviewersActionEntities.forEach(e -> {
                if (!e.getCode().equals("create")) { //TODO Убрать костыль когда кнопка создания должна появиться
                    interviewersActionList.add(mapperService.mapInterviewersActionEntity(e));
                }
            });
        }


        RequisitionPagination pagination = new RequisitionPagination();
        pagination.setDefaultPageSize(defaultPageSize);
        pagination.setPageSizeOptionList(defaultPageSizeOptions);
        RequisitionDictDto dto = new RequisitionDictDto();
        dto.setTabList(tabItemList);
        dto.setStatusList(requisitionStatusItemList);
        dto.setPagination(pagination);
        dto.setStageList(stageList);
        dto.setStageStatusList(stageStatusList);
        dto.setCandidateActionList(candidateActionList);
        dto.setCandidateTabList(candidateTabList);
        dto.setInterviewersActionList(interviewersActionList);
        return dto;
    }
