    private List<StructUnitPath> fillStructUnitPathList(OrgUnitEntity orgUnitEntity, LocalDateTime currentDateTime) {
        List<StructUnitPath> structUnitPathList = new ArrayList<>();

        OrgUnitEntity parentOrgUnitEntity;
        String parentOrgUnitId = orgUnitEntity.getOrgUnitParentId();

        do {
            structUnitPathList = addElementToList(orgUnitEntity, structUnitPathList);
            parentOrgUnitEntity = getParentOrgUnitEntity(parentOrgUnitId, currentDateTime);
            if (parentOrgUnitEntity.getOrgUnitIndependence().equals("0")) {
                orgUnitEntity = parentOrgUnitEntity;
                parentOrgUnitId = orgUnitEntity.getOrgUnitParentId();
            }
        } while (!(parentOrgUnitEntity.getOrgUnitIndependence().equals("1")));

        return structUnitPathList;
    }
