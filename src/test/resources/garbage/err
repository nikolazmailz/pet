package ru.ntdev.srhr.common.filestorage;

import ru.ntdev.srhr.common.dto.api.request.filestorage.FilePostRequestDto;
import ru.ntdev.srhr.common.dto.api.request.filestorage.MessagePostRequestDto;
import ru.ntdev.srhr.common.dto.api.response.filestorage.FileGetByIdDto;
import ru.ntdev.srhr.common.dto.api.response.filestorage.FilePostDto;
import ru.ntdev.srhr.common.dto.api.response.filestorage.MessageGetByIdDto;
import ru.ntdev.srhr.common.dto.api.response.filestorage.MessagePostDto;

public class FileStorageServiceImpl implements FileStorageService {

    private static final String URL_PUT_FILE = "/filestorage/file";
    private static final String URL_GET_FILE_BY_ID = "/filestorage/file/%s?nodel=%s";
    private static final String URL_PUT_MESSAGE = "/filestorage/message";
    private static final String URL_GET_MESSAGE_BY_ID = "/filestorage/message/%s?nodel=%s";

    /** Признак «не удалять после чтения»; в исходном коде всегда 1. */
    private static final int NODEL = 1;

    private final FileStorageRestClient restClient;

    public FileStorageServiceImpl(FileStorageRestClient restClient) {
        this.restClient = restClient;
    }

    @Override
    public FilePostDto putFileToDb(String adLogin, String sessionId, String traceId,
                                   String requestUid, String filename, String content) {
        FilePostDto result = restClient.post(
                URL_PUT_FILE,
                new FilePostRequestDto(requestUid, filename, content),
                FilePostDto.class,
                adLogin,
                sessionId,
                traceId);

        if (result == null || result.getFileUID() == null) {
            throw new IllegalStateException(
                    "FileStorage returned empty response for requestUid=" + requestUid);
        }
        return result;
    }

    @Override
    public FileGetByIdDto getFileById(String adLogin, String sessionId, String traceId,
                                      String fileUid) {
        FileGetByIdDto result = restClient.get(
                String.format(URL_GET_FILE_BY_ID, fileUid, NODEL),
                FileGetByIdDto.class,
                adLogin,
                sessionId,
                traceId);

        if (result == null) {
            throw new IllegalStateException(
                    "FileStorage returned empty response for fileUid=" + fileUid);
        }
        return result;
    }

    @Override
    public MessagePostDto putMessageToDb(String adLogin, String sessionId, String traceId,
                                         String requestUid, String messageName, String messageContent) {
        MessagePostDto result = restClient.post(
                URL_PUT_MESSAGE,
                new MessagePostRequestDto(requestUid, messageName, messageContent),
                MessagePostDto.class,
                adLogin,
                sessionId,
                traceId);

        if (result == null || result.getMessageUID() == null) {
            throw new IllegalStateException(
                    "FileStorage returned empty response for requestUid=" + requestUid);
        }
        return result;
    }

    @Override
    public MessageGetByIdDto getMessageById(String adLogin, String sessionId, String traceId,
                                            String messageUid) {
        MessageGetByIdDto result = restClient.get(
                String.format(URL_GET_MESSAGE_BY_ID, messageUid, NODEL),
                MessageGetByIdDto.class,
                adLogin,
                sessionId,
                traceId);

        if (result == null) {
            throw new IllegalStateException(
                    "FileStorage returned empty response for messageUid=" + messageUid);
        }
        return result;
    }
}