    public String execute(RequisitionContext req) {
        try {
            FinishProcessingMessageDto messageDto = execute(
                    req.requestEntity(),
                    req.systemParams(),
                    req.requestValues());
            return requisitionResponseProcessor.finishProcessingMessage(
                    messageDto.getStart(),
                    messageDto.getSystemParams(),
                    messageDto.getDto(),
                    messageDto.getRequestEntity(),
                    messageDto.getCode()
            );
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    public FinishProcessingMessageDto execute(
            RequisitionRequestEntity requestEntity,
            SapSystemParamsDto systemParams,
            RequisitionRequestDto requestValues) throws Exception {

        long start = System.currentTimeMillis();

        PendingCandidatesApiInnerResponse out = new PendingCandidatesApiInnerResponse();
        out.setSystemParams(systemParams.getAdLogin(), systemParams.getSessionId(), systemParams.getChannel());

        String code = StatusCode.CODE_200.getCode();
        try {
            PendingCandidatesApiRequest request = objectMapper.treeToValue(requestValues.getPayload(), PendingCandidatesApiRequest.class);

            String pernr = bscsIntegrationService.getStaffByLogin(
                    requestValues.getAdLogin(),
                    requestValues.getSessionId(),
                    requestValues.getTraceId()
            ).getId();

            PendingCandidatesResponse pendingCandidatesResponse = masterDataIntegrationService.getPendingCandidates(systemParams, new PendingCandidatesRequest(
                    new PendingCandidatesRequest.Request(pernr)
            )).getBody();

            databaseService.replaceForApprover(pernr, pendingCandidatesResponse);

            out = definePendingCandidatePage(pernr, request);

            entityService.updateRequestStatus(systemParams.getUuid(), RequestStatusConstant.REPLY);

        } catch (HttpClientErrorException | HttpServerErrorException e) {
            code = e.getStatusCode().toString();
            httpErrorExceptionHandler.handleHttpClientOrServerErrorException(e, out, systemParams, ErrorResponse.REQUISITION_INFO_NOT_FOUND);
        } catch (Exception e) {
            code = StatusCode.CODE_500.getCode();
            httpErrorExceptionHandler.handleException(e, out, systemParams, ErrorResponse.REQUISITION_UNEXPECTED_ERROR);
        }

        out.setResponseCode(code);

        return new FinishProcessingMessageDto(
                start,
                systemParams,
                out,
                requestEntity,
                code
        );
    }

    /**
     * 1. Реализовать получение кандидатов, ожидающих решения из `pending_candidates` учитывая фильтр по **eventCode (условие ИЛИ)** (то есть выборка кадидатов, у которых есть хотя бы один этап из массива eventCode), свободный поиск по фио (полное вхождение, как в кандидатах на вакансию) и пагинацию.
     * 2. Заполнить поле `count` - сколько ВСЕГО кандидатов, ожидающих решения текущего пользователя с учетом фильтров.
     * 3. Отсортировать для каждого кандидата массив events по полю `status_date` от раннего к позднему.
     * 4. Массив `eventCode` **заполнить ВСЕМИ уникальными кодами этапов** по всем кандидатам (на всех страницах), ожидающим решения текущего пользователя (руководителя), учитывая фильтры.
     * 5. Обогатить ответ данными заявки на подбор (в ответе получили vacancyId → таблица vacancy → по requisition_guid → таблица requisitions и связь structure_unit).
     * */
    private PendingCandidatesApiInnerResponse definePendingCandidatePage(String pernr, PendingCandidatesApiRequest request) {
        String search = request.filter() != null ? request.filter().search() : null;
        List<String> codes = request.filter() != null && request.filter().eventCodeList() != null ? request.filter().eventCodeList() : List.of();

        List<Integer> idsCandidate = pendingCandidateEntityRepository.findPageIds(
                pernr,
                search,
                codes,
                codes.isEmpty(),
                request.pageSize(),
                (request.page() - 1) * request.pageSize()
        );

        long countCandidates = pendingCandidateEntityRepository.countByFilter(
                pernr,
                search,
                codes,
                codes.isEmpty()
        );

        List<String> eventCodes = pendingCandidateEntityRepository.findDistinctEventCodes(
                pernr,
                search,
                codes,
                codes.isEmpty()
        );

        if (idsCandidate.isEmpty()) {
            return new PendingCandidatesApiInnerResponse(
                    new PendingCandidatesPage(
                            request.page(),
                            request.pageSize(),
                            countCandidates,
                            eventCodes.stream().map(EventCodeView::new).toList(),
                            List.of()
                    )
            );
        }

        List<PendingCandidateRow> candidates = pendingCandidateEntityRepository.findRowsByIds(
                idsCandidate.toArray(Integer[]::new)
        );

        Map<String, RequisitionEnrichment> enrichRequisitionByVacancyId = loadEnrichment(candidates);

        Map<Integer, List<PendingCandidateEventRow>> eventsByCandidateId =
                pendingCandidateEntityRepository.findEventRowsByCandidateIds(idsCandidate).stream()
                        .collect(Collectors.groupingBy(
                                PendingCandidateEventRow::getPendingCandidateId,
                                LinkedHashMap::new,
                                Collectors.toList()));

        return new PendingCandidatesApiInnerResponse(
                new PendingCandidatesPage(
                        request.page(),
                        request.pageSize(),
                        countCandidates,
                        eventCodes.stream().map(EventCodeView::new).toList(),
                        candidates.stream().map(candidate -> new PendingCandidateView(
                                candidate.getCandidateId(),
                                candidate.getVacancyId(),
                                candidate.getFullName(),
                                new RequisitionView(
                                        enrichRequisitionByVacancyId.get(candidate.getVacancyId()).guid,
                                        enrichRequisitionByVacancyId.get(candidate.getVacancyId()).number,
                                        enrichRequisitionByVacancyId.get(candidate.getVacancyId()).positionType,
                                        new StaffPositionView(
                                                enrichRequisitionByVacancyId.get(candidate.getVacancyId()).staffPositionId,
                                                enrichRequisitionByVacancyId.get(candidate.getVacancyId()).staffPositionName
                                        ),
                                        enrichRequisitionByVacancyId.get(candidate.getVacancyId()).structUnitName,
                                        enrichRequisitionByVacancyId.get(candidate.getVacancyId()).structUnitId,
                                        enrichRequisitionByVacancyId.get(candidate.getVacancyId()).path.stream().map(structUnitPathNode ->
                                                new StructUnitPathView(
                                                        structUnitPathNode.id, structUnitPathNode.typeDesc, structUnitPathNode.name)
                                        ).toList()
                                ),
                                eventsByCandidateId.getOrDefault(candidate.getId(), List.of()).stream().map(event ->
                                        new PendingCandidateEventView(
                                                event.getEventCode(),
                                                event.getDays(),
                                                event.getExpirationZone()
                                        )
                                ).toList()

                        )).toList()
                )
        );
    }

    private Map<String, RequisitionEnrichment> loadEnrichment(List<PendingCandidateRow> candidates) {
        Set<String> vacancyIds = candidates.stream()
                .map(PendingCandidateRow::getVacancyId)
                .map(Object::toString)
                .collect(Collectors.toSet());
        if (vacancyIds.isEmpty()) {
            return Map.of();
        }

        List<RequisitionEnrichmentRow> reqRows =
                requisitionRepository.findEnrichmentByVacancyIds(vacancyIds.toArray(String[]::new));

        Map<String, List<StructUnitPathNode>> pathsByGuid =
                structureUnitRepository.findPathsByRequisitionGuids(
                                reqRows.stream().map(RequisitionEnrichmentRow::getGuid).collect(Collectors.toSet()))
                        .stream()
                        .collect(Collectors.groupingBy(
                                StructUnitPathRow::getRequisitionGuid,
                                LinkedHashMap::new,   // сохранить order_number из SQL
                                Collectors.mapping(p -> new StructUnitPathNode(
                                        p.getId(), p.getTypeDesc(), p.getName()), Collectors.toList())));

        return reqRows.stream().collect(Collectors.toMap(
                RequisitionEnrichmentRow::getVacancyId,
                r -> new RequisitionEnrichment(
                        r.getVacancyId(), r.getGuid(), r.getNumber(), r.getPositionType(),
                        r.getStaffPositionId(), r.getStaffPositionName(),
                        r.getStructUnitId(), r.getStructUnitName(),
                        pathsByGuid.getOrDefault(r.getGuid(), List.of()))));
    }

    public record RequisitionEnrichment(
            String vacancyId,
            String guid,
            String number,
            String positionType,
            String staffPositionId,
            String staffPositionName,
            String structUnitId,
            String structUnitName,
            List<StructUnitPathNode> path
    ) {

    }

    public record StructUnitPathNode(String id, String typeDesc, String name) {
    }
