    public FilePostDto putFileToDb(String adlogin, String sessionId, String traceId, String requestUID, String filename, String content) {
        RestTemplate restTemplate = filestorageRestClient.buildRestTemplate(adlogin, sessionId, traceId);
        String uri = String.format(integrationUrlPutFile);
        uri = filestorageRestServiceUrl + uri;
        ResponseEntity<FilePostDto> filestorageResponse;
        FilePostRequestDto requestDto = new FilePostRequestDto(requestUID, filename, content);
//        filestorageResponse = restTemplate.postForEntity(uri, requestDto, FilePostDto.class);

        HttpEntity<Void> request = new HttpEntity<>(ClientHttpHeaders.minimal(adlogin, sessionId, traceId));
        filestorageResponse = loggingRestTemplate.exchange(uri, HttpMethod.POST, request, FilePostDto.class);
        
        return filestorageResponse.hasBody() ? filestorageResponse.getBody() : null;
    }
