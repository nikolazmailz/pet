private <R> ResponseEnvelope<R> awaitResponse(
        String correlationId,
        Class<R> responseType
) throws InterruptedException, JsonProcessingException {

    int attempts = 0;

    while (attempts < timeoutLimit) {
        try {
            RedisResponse redisResponse =
                    redisAdapter.getObjectFromDb(correlationId, RedisResponse.class);

            if (redisResponse != null) {
                JavaType type = objectMapper.getTypeFactory()
                        .constructParametricType(ResponseEnvelope.class, responseType);

                return objectMapper.readValue(redisResponse.getBody(), type);
            }
        } catch (Exception e) {
            // пока сохраняем текущее поведение
        }

        attempts++;
        Thread.sleep(50);
    }

    return null;
}


