public record ResponseEnvelope<T>(
        String correlationId,
        String requestType,
        T payload,
        String responseCode,
        String errorMessage
) {

    public static <T> ResponseEnvelope<T> success(
            String correlationId,
            String requestType,
            T payload
    ) {
        return new ResponseEnvelope<>(
                correlationId,
                requestType,
                payload,
                "200",
                null
        );
    }

    public static <T> ResponseEnvelope<T> error(
            String correlationId,
            String requestType,
            String responseCode,
            String errorMessage
    ) {
        return new ResponseEnvelope<>(
                correlationId,
                requestType,
                null,
                responseCode,
                errorMessage
        );
    }
}



public interface RequestHandler<T, R> {

    String requestType();

    Class<T> requestClass();

    R handle(T request);
}


public class HandlerNotFoundException extends RuntimeException {

    public HandlerNotFoundException(String requestType) {
        super("Handler not found for requestType: " + requestType);
    }
}



import org.springframework.stereotype.Component;
import ru.example.requestreply.exception.HandlerNotFoundException;

import java.util.List;
import java.util.Map;
import java.util.function.Function;
import java.util.stream.Collectors;

@Component
public class RequestHandlerResolver {

    private final Map<String, RequestHandler<?, ?>> handlers;

    public RequestHandlerResolver(List<RequestHandler<?, ?>> handlers) {
        this.handlers = handlers.stream()
                .collect(Collectors.toMap(
                        RequestHandler::requestType,
                        Function.identity()
                ));
    }

    public RequestHandler<?, ?> resolve(String requestType) {
        RequestHandler<?, ?> handler = handlers.get(requestType);

        if (handler == null) {
            throw new HandlerNotFoundException(requestType);
        }

        return handler;
    }
}




import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Component;
import ru.example.requestreply.model.RequestEnvelope;
import ru.example.requestreply.model.ResponseEnvelope;

@Component
@RequiredArgsConstructor
public class RequestHandlerExecutor {

    private final ObjectMapper objectMapper;

    public ResponseEnvelope<?> execute(
            RequestEnvelope<JsonNode> envelope,
            RequestHandler<?, ?> handler
    ) throws JsonProcessingException {

        return executeTyped(envelope, handler);
    }

    private <T, R> ResponseEnvelope<R> executeTyped(
            RequestEnvelope<JsonNode> envelope,
            RequestHandler<T, R> handler
    ) throws JsonProcessingException {

        T request = objectMapper.treeToValue(
                envelope.payload(),
                handler.requestClass()
        );

        R response = handler.handle(request);

        return ResponseEnvelope.success(
                envelope.correlationId(),
                envelope.requestType(),
                response
        );
    }
}


 package ru.example.kafka;

 import com.fasterxml.jackson.databind.JavaType;
 import com.fasterxml.jackson.databind.JsonNode;
 import com.fasterxml.jackson.databind.ObjectMapper;
 import lombok.RequiredArgsConstructor;
 import org.springframework.kafka.annotation.KafkaListener;
 import org.springframework.stereotype.Component;
 import ru.example.requestreply.handler.RequestHandler;
 import ru.example.requestreply.handler.RequestHandlerExecutor;
 import ru.example.requestreply.handler.RequestHandlerResolver;
 import ru.example.requestreply.model.RequestEnvelope;
 import ru.example.requestreply.model.ResponseEnvelope;

 @Component
 @RequiredArgsConstructor
 public class RequestKafkaListener {

     private final ObjectMapper objectMapper;
     private final RequestHandlerResolver handlerResolver;
     private final RequestHandlerExecutor handlerExecutor;
     private final KafkaProducerService kafkaProducerService;

     @KafkaListener(
             topics = "${spring.kafka.topic.request}",
             groupId = "${spring.kafka.listener.group-id}"
     )
     public void listen(String data) {
         RequestEnvelope<JsonNode> envelope = null;

         try {
             JavaType envelopeType = objectMapper.getTypeFactory()
                     .constructParametricType(
                             RequestEnvelope.class,
                             JsonNode.class
                     );

             envelope = objectMapper.readValue(
                     data,
                     envelopeType
             );

             RequestHandler<?, ?> handler =
                     handlerResolver.resolve(
                             envelope.requestType()
                     );

             ResponseEnvelope<?> response =
                     handlerExecutor.execute(
                             envelope,
                             handler
                     );

             kafkaProducerService.produce(
                     objectMapper.writeValueAsString(response)
             );

         } catch (Exception e) {

             if (envelope == null) {
                 throw new IllegalStateException(
                         "Failed to deserialize request envelope",
                         e
                 );
             }

             ResponseEnvelope<?> response =
                     ResponseEnvelope.error(
                             envelope.correlationId(),
                             envelope.requestType(),
                             "500",
                             e.getMessage()
                     );

             try {
                 kafkaProducerService.produce(
                         objectMapper.writeValueAsString(response)
                 );
             } catch (Exception ex) {
                 throw new IllegalStateException(
                         "Failed to send error response",
                         ex
                 );
             }
         }
     }
 }


 import com.fasterxml.jackson.core.JsonProcessingException;
 import com.fasterxml.jackson.databind.ObjectMapper;
 import lombok.RequiredArgsConstructor;
 import org.springframework.stereotype.Service;
 import ru.example.requestreply.model.RequestEnvelope;

 @Service
 @RequiredArgsConstructor
 public class RequestSender {

     private final ObjectMapper objectMapper;
     private final RedisAdapter redisAdapter;

     public <T> void send(RequestEnvelope<T> request)
             throws JsonProcessingException {

         String json = objectMapper.writeValueAsString(request);

         redisAdapter.putToQueue(
                 "request-queue",
                 json
         );
     }
 }


 import com.fasterxml.jackson.databind.JavaType;
 import com.fasterxml.jackson.databind.JsonNode;
 import com.fasterxml.jackson.databind.ObjectMapper;
 import lombok.RequiredArgsConstructor;
 import org.springframework.kafka.annotation.KafkaListener;
 import org.springframework.kafka.support.Acknowledgment;
 import org.springframework.stereotype.Component;
 import ru.example.requestreply.model.ResponseEnvelope;

 @Component
 @RequiredArgsConstructor
 public class ResponseKafkaListener {

     private final ObjectMapper objectMapper;
     private final RedisAdapter redisAdapter;

     @KafkaListener(
             topics = "${spring.kafka.topic.response}",
             groupId = "${spring.kafka.response-listener.group-id}"
     )
     public void listen(
             String data,
             Acknowledgment acknowledgment
     ) {
         try {

             JavaType envelopeType = objectMapper.getTypeFactory()
                     .constructParametricType(
                             ResponseEnvelope.class,
                             JsonNode.class
                     );

             ResponseEnvelope<JsonNode> response =
                     objectMapper.readValue(
                             data,
                             envelopeType
                     );

             redisAdapter.putObjectToDb(
                     response.correlationId(),
                     response,
                     1000
             );

             acknowledgment.acknowledge();

         } catch (Exception e) {
             acknowledgment.acknowledge();

             throw new IllegalStateException(
                     "Failed to process response from Kafka",
                     e
             );
         }
     }
 }



 import com.fasterxml.jackson.databind.JsonNode;
 import com.fasterxml.jackson.databind.ObjectMapper;
 import lombok.RequiredArgsConstructor;
 import org.springframework.stereotype.Service;
 import ru.example.requestreply.model.RequestEnvelope;
 import ru.example.requestreply.model.ResponseEnvelope;

 @Service
 @RequiredArgsConstructor
 public class RequestReplyService {

     private final RequestSender requestSender;
     private final RedisAdapter redisAdapter;
     private final ObjectMapper objectMapper;

     private final int timeoutLimit = 200;

     public <T, R> ResponseEnvelope<R> getResponse(
             RequestEnvelope<T> request,
             Class<R> responseClass
     ) throws Exception {

         requestSender.send(request);

         return awaitResponse(
                 request.correlationId(),
                 responseClass
         );
     }

     private <R> ResponseEnvelope<R> awaitResponse(
             String correlationId,
             Class<R> responseClass
     ) throws InterruptedException {

         int attempts = 0;

         while (attempts < timeoutLimit) {

             try {
                 ResponseEnvelope<?> storedResponse =
                         redisAdapter.getObjectFromDb(
                                 correlationId,
                                 ResponseEnvelope.class
                         );

                 if (storedResponse != null) {

                     JsonNode payload = objectMapper.valueToTree(
                             storedResponse.payload()
                     );

                     R responsePayload = null;

                     if (payload != null && !payload.isNull()) {
                         responsePayload = objectMapper.treeToValue(
                                 payload,
                                 responseClass
                         );
                     }

                     return new ResponseEnvelope<>(
                             storedResponse.correlationId(),
                             storedResponse.requestType(),
                             responsePayload,
                             storedResponse.responseCode(),
                             storedResponse.errorMessage()
                     );
                 }

             } catch (Exception e) {
                 // логируем, но продолжаем polling
             }

             attempts++;

             Thread.sleep(50);
         }

         return null;
     }
 }