private String awaitResponse(String correlationId) throws InterruptedException {
    int attempts = 0;

    while (attempts < timeoutLimit) {
        try {
            RedisResponse response =
                    redisAdapter.getObjectFromDb(correlationId, RedisResponse.class);

            if (response != null) {
                return response.getBody();
            }
        } catch (Exception e) {
            // пока сохраняем текущее поведение
        }

        attempts++;
        Thread.sleep(50);
    }

    return null;
}


