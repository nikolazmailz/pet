package ru.ntdev.srhr.ms.requisition.kafka.service.consumer;

import org.apache.kafka.clients.consumer.ConsumerConfig;
import org.apache.kafka.common.serialization.StringDeserializer;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.kafka.core.ConsumerFactory;
import org.springframework.kafka.core.DefaultKafkaConsumerFactory;
import org.springframework.stereotype.Component;
import org.springframework.util.DigestUtils;

import java.util.HashMap;
import java.util.Map;

@Component
public class SrhrKafkaConsumerFactory {
    private Map<String, ConsumerFactory<String, String>> consumerFactoryMap;

    public SrhrKafkaConsumerFactory() {
        this.consumerFactoryMap = new HashMap<>();
    }

    @Value("${spring.kafka.consumer.group-id}")
    private String kafkaConsumerGroupId;
    @Value("${spring.kafka.bootstrap-servers}")
    private String bootstrapServers;
    @Value("${spring.kafka.ssl.key-store-location}")
    private String sslKeystoreLocation;
    @Value("${spring.kafka.ssl.key-store-password}")
    private String sslKeystorePassword;
    @Value("${spring.kafka.ssl.trust-store-location}")
    private String sslTruststoreLocation;
    @Value("${spring.kafka.ssl.trust-store-password}")
    private String sslTruststorePassword;
    @Value("${spring.kafka.ssl.key-password}")
    private String sslKeyPassword;
    @Value("${spring.kafka.ssl.trust-store-type}")
    private String sslTruststoreType;
    @Value("${spring.kafka.ssl.key-store-type}")
    private String sslKeystoreType;
    @Value("${spring.kafka.ssl.enabled}")
    boolean sslEnabled;

    public ConsumerFactory<String, String> getConsumerFactory(String clientId, String instanceId, Integer pollLimit) {
        String _paramsStr = clientId.concat(instanceId).concat(pollLimit.toString());
        String _hashKey = DigestUtils.md5DigestAsHex(_paramsStr.getBytes()).toUpperCase();

        if(consumerFactoryMap.containsKey(_hashKey)){
            return consumerFactoryMap.get(_hashKey);
        }else{
            Map<String, Object> props = new HashMap<>();
            props.put(ConsumerConfig.BOOTSTRAP_SERVERS_CONFIG,bootstrapServers);
            props.put(ConsumerConfig.GROUP_ID_CONFIG,kafkaConsumerGroupId);
            props.put(ConsumerConfig.KEY_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class);
            props.put(ConsumerConfig.VALUE_DESERIALIZER_CLASS_CONFIG,StringDeserializer.class);
            props.put(ConsumerConfig.AUTO_OFFSET_RESET_CONFIG,"earliest");
            props.put(ConsumerConfig.MAX_POLL_RECORDS_CONFIG,pollLimit);
            props.put(ConsumerConfig.ENABLE_AUTO_COMMIT_CONFIG, false);
            props.put(ConsumerConfig.CLIENT_ID_CONFIG,clientId);
            props.put(ConsumerConfig.GROUP_INSTANCE_ID_CONFIG,instanceId);
            if(sslEnabled) {
                props.put("security.protocol", "SSL");
                props.put("ssl.keystore.location", sslKeystoreLocation);
                props.put("ssl.keystore.password", sslKeystorePassword);
                props.put("ssl.truststore.location", sslTruststoreLocation);
                props.put("ssl.truststore.password", sslTruststorePassword);
                props.put("ssl.key.password", sslKeyPassword);
                props.put("ssl.keystore.type", sslKeystoreType);
                props.put("ssl.truststore.type", sslTruststoreType);
            }
            ConsumerFactory<String, String> _factory = new DefaultKafkaConsumerFactory<>(props);
            consumerFactoryMap.put(_hashKey,_factory);
            return _factory;
        }
    }

}



package ru.ntdev.srhr.ms.requisition.kafka.service.listener;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.kafka.support.Acknowledgment;
import org.springframework.stereotype.Component;
import ru.ntdev.srhr.common.redis.RedisAdapter;
import ru.ntdev.srhr.common.redis.RedisResponse;
import ru.ntdev.srhr.common.util.LogUtil;
import ru.ntdev.srhr.common.util.StringUtil;

import java.util.Map;

@Component
@RequiredArgsConstructor
@Slf4j
public class KafkaStaffListener implements Runnable {

    private final RedisAdapter redisAdapter;

    @Value("${spring.kafka.topic.name.from-staff}")
    String kafkaTopicNameFromStaff;

    @org.springframework.kafka.annotation.KafkaListener(
            id = "${spring.kafka.listener.id}",
            topics = "${spring.kafka.topic.name.from-staff}",
            groupId = "${spring.kafka.listener.group-id}",
            concurrency = "${spring.kafka.listener.partition.number}",
            autoStartup = "true",
            containerFactory = "kafkaListenerContainerFactory"
    )
    public void listen(String data, Acknowledgment ack) {
             try {
                 RedisResponse redisResponse = new RedisResponse();
                 Map<String, String> requestValues = StringUtil.convertStringToMap(data);
                 String uuid = requestValues.get("uuid");
                 uuid = uuid+"_staff";
                 String requestType = requestValues.get("type");
                 String sessionId = requestValues.get("sessionId");
                 String adLogin = requestValues.get("adLogin");
                 String traceId = requestValues.get("traceId");
                 LogUtil.logKafkaMessageGot(adLogin, sessionId, requestType, kafkaTopicNameFromStaff, traceId);
                 redisResponse.setUid(uuid);
                 redisResponse.setBody(data);
                 redisAdapter.putObjectToDb(uuid, redisResponse, 1000);
                 ack.acknowledge();
             } catch (Exception e) {
                 log.warn("Ошибка в листенере [staff_info_listener]: [{}]", e.getMessage());
                 ack.acknowledge();
             }
    }

    @Override
    public void run() {
    }
}


