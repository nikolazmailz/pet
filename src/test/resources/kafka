package ru.ntdev.srhr.ms.requisition.kafka.service.consumer;

import lombok.extern.slf4j.Slf4j;
import org.apache.kafka.clients.consumer.Consumer;
import org.apache.kafka.clients.consumer.ConsumerRecord;
import org.apache.kafka.clients.consumer.ConsumerRecords;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;

import java.time.Duration;
import java.util.*;
import java.util.regex.Pattern;

@Service
@Slf4j
public class KafkaToEasupConsumerServiceImpl implements KafkaConsumerService {

    private Map<String , Consumer<String, String>> consumerMap;
    private List<Consumer<String, String>> consumerAccessList;

    @Autowired
    private SrhrKafkaConsumerFactory kafkaConsumerFactory;

    public KafkaToEasupConsumerServiceImpl()
    {
        this.consumerMap = new HashMap<>();
        this.consumerAccessList = new ArrayList<>();
        this.kafkaConsumerGroupId = kafkaConsumerGroupId;
        this.bootstrapServers = bootstrapServers;
    }

    @Value("${spring.kafka.consumer.group-id}")
    private String kafkaConsumerGroupId;
    @Value("${spring.kafka.bootstrap-servers}")
    private String bootstrapServers;

    @Override
    public void createConsumer(String consumerId, String topic, Integer pollLimit) throws Exception {
        Consumer<String, String> _consumer = null;
        String newConsumerId = consumerId+"_"+ UUID.randomUUID();
        _consumer = kafkaConsumerFactory.getConsumerFactory(newConsumerId, newConsumerId, pollLimit).createConsumer();
        if(_consumer != null) {
            consumerMap.put(newConsumerId, _consumer);
            consumerMap.get(newConsumerId).subscribe(Pattern.compile(topic));
            consumerAccessList.add(_consumer);
        }

    }

    @Override
    public boolean isConsumerExists(String consumerId) {
        if(consumerMap.containsKey(consumerId) && consumerMap.get(consumerId) != null) {
            return true;
        }
        return false;
    }

    public Integer isEnoughConsumers(Integer partitionCount) {
        return partitionCount - consumerMap.size();
    }

    public synchronized Consumer<String, String> getFreeConsumer(){
        if(!consumerAccessList.isEmpty()) {
            Consumer<String, String> _consumer = consumerAccessList.get(0);
            consumerAccessList.remove(_consumer);
            return _consumer;
        }
        return null;
    }

    public synchronized void returnFreeConsumer(Consumer<String, String> _consumer) {
        consumerAccessList.add(_consumer);
    }

    @Override
    public List<String> pollObjects(String consumerId) {
        List<String> _resultList = new ArrayList<>();

        if(consumerMap.containsKey(consumerId) && consumerMap.get(consumerId) != null) {
            ConsumerRecords<String, String> _records = consumerMap.get(consumerId).poll(Duration.ofSeconds(1));
            for (ConsumerRecord<String, String> record : _records) {
                _resultList.add(record.value());
            }
        }

        return _resultList;
    }

    @Override
    public void commit(String consumerId) {
        if(consumerMap.containsKey(consumerId) && consumerMap.get(consumerId) != null){
            consumerMap.get(consumerId).commitAsync();
        }
    }

    @Override
    public void rollback(String consumerId) {
        if(consumerMap.containsKey(consumerId) && consumerMap.get(consumerId) != null){
            close(consumerId);
        }
    }

    @Override
    public void close(String consumerId){
        if(consumerMap.containsKey(consumerId) && consumerMap.get(consumerId) != null) {
            consumerMap.get(consumerId).close(Duration.ofSeconds(1));
            var consumer = consumerMap.get(consumerId);
            consumer = null;
            consumerMap.remove(consumerId);
        }
    }
}



