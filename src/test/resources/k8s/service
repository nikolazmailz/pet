kind: Service
apiVersion: v1
metadata:
  name: {{ .Release.Name }}
  labels:
    {{- include "chart.labels" . | nindent 4 }}
  annotations:
    description: Service for {{ .Release.Name }}
    {{- if .Values.prometheus.enabled }}
    tsam.vtb.ru/scrape: 'true'
    tsam.vtb.ru/path: '/actuator/prometheus'
    tsam.vtb.ru/port: {{ .Values.server.portService | squote }}
    tsam.vtb.ru/project-code: {{ .Values.risCode | squote }}
    tsam.vtb.ru/ris-code: {{ .Values.risId | squote }}
    tsam.vtb.ru/esm-passthrough: {{ .Values.ESMmetrics.enabled | squote  }}
    {{- end }}
spec:
  ports:
    - name: http
      port: {{ .Values.server.portService }}
      protocol: TCP
      targetPort: {{ .Values.server.portService }}
  selector:
    app: {{ .Release.Name }}
