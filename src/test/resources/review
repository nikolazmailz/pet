 @Query(value = "select * from srhr_requisition.candidates cd where cd.vacancy_id = :vacancyId " +
            "and cast(:search as text) IS NULL or cd.full_name ILIKE :search", nativeQuery = true)
    List<CandidateEntity> findAllByVacancyIdAndSearchString(
            @Param("vacancyId") Integer vacancyId,
            @Param("search") String searchString
    );


private Map<Integer, List<CandidateEventEntity>> createCandidateEventsMapByVacancyId(Integer vacancyId) {
        List<CandidateEntity> candidates = candidateRepository
                .findAllByVacancyId(vacancyId);

        List<Integer> candidateIdList = candidates.stream()
                .map(CandidateEntity::getId)
                .distinct()
                .toList();

        List<CandidateEventEntity> candidateEventEntities =
                candidateEventRepository.findAllByCandidateIds(candidateIdList);

        return getCandidateEventsMap(candidateEventEntities, candidateIdList);
    }

