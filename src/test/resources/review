    private Map<Integer, List<CandidateEventEntity>> getCandidateEventsMap(
            List<CandidateEventEntity> candidateEventEntities,
            List<Integer> candidateIdList
    ) {
        Map<Integer, List<CandidateEventEntity>> candidateEventEntityMap = new HashMap<>();
        List<CandidateEventEntity> candidateEventsList = new ArrayList<>();

        for (Integer candidateId : candidateIdList) {
            for (CandidateEventEntity candidateEventEntity : candidateEventEntities) {
                if (candidateEventEntity.getCandidateId().getId().equals(candidateId)) {
                    candidateEventsList.add(candidateEventEntity);
                }
            }
            candidateEventEntityMap.put(candidateId, candidateEventsList);
            candidateEventsList = new ArrayList<>();
        }

        return candidateEventEntityMap;
    }
