@Configuration(proxyBeanMethods = false)
public class CorsFilterConfiguration {
    @Bean
    public FilterRegistrationBean<CorsAllowOriginFilter> corsAllowOriginFilter() {
        var reg = new FilterRegistrationBean<>(new CorsAllowOriginFilter());
        reg.addUrlPatterns("/*");
        reg.setOrder(Ordered.HIGHEST_PRECEDENCE);
        return reg;
    }
}

public class CorsAllowOriginFilter implements Filter {
    @Override
    public void doFilter(ServletRequest req, ServletResponse res, FilterChain chain)
            throws IOException, ServletException {
        ((HttpServletResponse) res).setHeader("Access-Control-Allow-Origin", "*");
        chain.doFilter(req, res);
    }
}
