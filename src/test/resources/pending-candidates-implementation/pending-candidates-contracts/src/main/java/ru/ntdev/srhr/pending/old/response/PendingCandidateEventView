package ru.ntdev.srhr.pending.contracts;

import io.swagger.v3.oas.annotations.media.Schema;

@Schema(description = "Этап кандидата")
public record PendingCandidateEventView(

        @Schema(description = "Код этапа", example = "interview",
                requiredMode = Schema.RequiredMode.REQUIRED)
        String code,

        @Schema(description = "Дней на этапе", example = "5", nullable = true,
                requiredMode = Schema.RequiredMode.NOT_REQUIRED)
        Integer days,

        @Schema(description = "Зона истечения срока", example = "2", nullable = true,
                requiredMode = Schema.RequiredMode.NOT_REQUIRED)
        Integer expirationZone
) {}