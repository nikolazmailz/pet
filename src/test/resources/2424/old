@Override
    public PayavgCalculateDto getPayavgCalculation(SapSystemParamsDto systemParams, PayavgRequestDto request) throws JsonProcessingException, HttpClientErrorException {
        String url = sapGeneralUrl+sapUrlPayavgCalculate+sapMandantParam;
        ObjectMapper mapper = new ObjectMapper();
        String requestBody;
        PayavgCalculateRequest payavgCalculateRequest = new PayavgCalculateRequest();
        RestTemplate restTemplate = easupClient.buildRestTemplateWithRoles(systemParams);
        Map<String, List<String>> headerList = getCSRFTokenAndCookies(restTemplate);
        if (headerList==null||headerList.isEmpty()) {
           throw new HttpClientErrorException(HttpStatus.UNAUTHORIZED, "Не были получены токен и куки для CSRF аутентификации.");
        }
        RestTemplate restPostTemplate = easupClient.buildRestTemplateWithCSRFTokenWithRoles(systemParams,
                headerList);
        BeanUtils.copyProperties(request, payavgCalculateRequest);
        requestBody = mapper.writeValueAsString(payavgCalculateRequest);
        ResponseEntity<String> responseBody = restPostTemplate.postForEntity(url, requestBody, String.class);
        return mapper.readValue(responseBody.getBody(), PayavgCalculateDto.class);
    }


private Map<String, List<String>> getCSRFTokenAndCookies(RestTemplate restTemplate) {
        try {
            String url = sapGeneralUrl+sapUrlCsrfToken+sapMandantParam;
            String csrfToken;
            Map<String, List<String>> headerMap = new HashMap<>();
            ResponseEntity<String> responseBody = restTemplate.getForEntity(url, String.class);
            Map<String, List<String>> responseMap = responseBody.getHeaders();
            for (Map.Entry<String, List<String>> entry : responseMap.entrySet()) {
                if ("x-csrf-token".equals(entry.getKey())) {
                    csrfToken = entry.getValue().get(0);
                    headerMap.put("x-csrf-token", List.of(csrfToken));
                }
                if ("set-cookie".equals(entry.getKey())&&!entry.getValue().isEmpty()) {
                    headerMap.put("cookie", responseMap.get("set-cookie"));
                }
            }
            return headerMap;
        } catch (Exception e) {
            log.error("Не удалось получить CSRF токен: [{}]", e.getMessage());
        }
        return null;
    }


package ru.ntdev.srhr.ms.easup.integration.client;

import org.apache.hc.client5.http.classic.HttpClient;
import org.apache.hc.client5.http.impl.classic.HttpClients;
import org.apache.hc.client5.http.impl.io.BasicHttpClientConnectionManager;
import org.apache.hc.client5.http.socket.ConnectionSocketFactory;
import org.apache.hc.client5.http.socket.PlainConnectionSocketFactory;
import org.apache.hc.client5.http.ssl.NoopHostnameVerifier;
import org.apache.hc.client5.http.ssl.SSLConnectionSocketFactory;
import org.apache.hc.client5.http.utils.Base64;
import org.apache.hc.core5.http.Header;
import org.apache.hc.core5.http.HttpHeaders;
import org.apache.hc.core5.http.config.Registry;
import org.apache.hc.core5.http.config.RegistryBuilder;
import org.apache.hc.core5.http.message.BasicHeader;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.boot.web.client.RestTemplateBuilder;
import org.springframework.context.annotation.Scope;
import org.springframework.http.client.ClientHttpRequestInterceptor;
import org.springframework.http.client.HttpComponentsClientHttpRequestFactory;
import org.springframework.stereotype.Component;
import org.springframework.util.CollectionUtils;
import org.springframework.web.client.RestTemplate;
import ru.ntdev.srhr.common.constant.RealmConstant;
import ru.ntdev.srhr.common.dto.SapSystemParamsDto;
import ru.ntdev.srhr.common.jwt.OpenTelemetryTraceContextProvider;
import ru.ntdev.srhr.common.util.LogUtil;
import ru.ntdev.srhr.ms.easup.integration.config.EasupCertificateConfig;
import ru.ntdev.srhr.ms.easup.integration.filter.EasupClientSideMetricsInterceptor;
import ru.ntdev.srhr.ms.easup.integration.filter.EasupRequestInterceptor;

import javax.net.ssl.SSLContext;
import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Component
@Scope("prototype")
public class EasupClient {

    private final EasupCertificateConfig easupCertificateConfig;
    private final LogUtil logUtil;
    private final OpenTelemetryTraceContextProvider openTelemetryTraceContextProvider;

    @Autowired
    private EasupClientSideMetricsInterceptor easupClientSideMetricsInterceptor;

    @Value("${easup.basic-auth.enable}") Boolean easupBasicAuthEnable;
    @Value("${easup.basic-auth.login}") String easupBasicAuthLogin;
    @Value("${easup.basic-auth.password}") String easupBasicAuthPassword;
    @Value("${easup.headers.service-id-header-name}") String serviceIdHeaderName;
    @Value("${easup.headers.service-id-header-staff-value}") String serviceIdHeaderStaffValue;
    @Value("${easup.headers.service-id-header-staff-mobile-value}") String serviceIdHeaderStaffMobileValue;

    public EasupClient(EasupCertificateConfig easupCertificateConfig, LogUtil logUtil, OpenTelemetryTraceContextProvider openTelemetryTraceContextProvider) {
        this.easupCertificateConfig = easupCertificateConfig;
        this.logUtil = logUtil;
        this.openTelemetryTraceContextProvider = openTelemetryTraceContextProvider;
    }

    public RestTemplate buildRestTemplateWithRoles(SapSystemParamsDto systemParams) {

        SSLContext sslContext = easupCertificateConfig.configureHttpClientSsl(systemParams.getRole());

        Header headerPernr = new BasicHeader("pernr", systemParams.getTabNumber());
        Header headerSessionId = new BasicHeader("sessionId", systemParams.getSessionId());
        Header headerCSRFToken = new BasicHeader("x-csrf-token", "fetch");
        Header headerRoles = new BasicHeader("Roles", systemParams.getRolesHeader());
        Header headerLogId = new BasicHeader("logId", systemParams.getTraceId());
        Header headerServiceId;
        if(systemParams.getRealm()!=null) {
            headerServiceId = new BasicHeader(serviceIdHeaderName, chooseServiceIdBasedOnRealm(systemParams.getRealm()));
        } else {
            headerServiceId = new BasicHeader(serviceIdHeaderName, serviceIdHeaderStaffValue);
        }
        List<Header> headers = new ArrayList<>();
        if (easupBasicAuthEnable&&!easupBasicAuthLogin.isEmpty()&&!easupBasicAuthPassword.isEmpty()) {
            final String auth = easupBasicAuthLogin + ":" + easupBasicAuthPassword;
            final byte[] encodedAuth = Base64.encodeBase64(auth.getBytes(StandardCharsets.ISO_8859_1));
            final String authH = "Basic " + new String(encodedAuth);
            Header authHeader = new BasicHeader(HttpHeaders.AUTHORIZATION, authH);
            headers.add(headerPernr);
            headers.add(headerSessionId);
            headers.add(authHeader);
            headers.add(headerCSRFToken);
            headers.add(headerRoles);
            headers.add(headerLogId);
            headers.add(headerServiceId);
        } else {
            headers.add(headerPernr);
            headers.add(headerSessionId);
            headers.add(headerCSRFToken);
            headers.add(headerRoles);
            headers.add(headerLogId);
            headers.add(headerServiceId);
        }

        return finishSettings(sslContext, headers);
    }

    public RestTemplate buildRestTemplateWithCSRFTokenWithRoles(SapSystemParamsDto systemParams, Map<String, List<String>> headerMap ) {

        SSLContext sslContext = easupCertificateConfig.configureHttpClientSsl(systemParams.getRole());

        Header headerPernr = new BasicHeader("pernr", systemParams.getTabNumber());
        Header headerSessionId = new BasicHeader("sessionId", systemParams.getSessionId());
        Header headerCSRFToken = new BasicHeader("x-csrf-token", headerMap.get("x-csrf-token").get(0));
        Header headerRoles = new BasicHeader("Roles", systemParams.getRolesHeader());
        Header headerLogId = new BasicHeader("logId", systemParams.getTraceId());
        Header headerServiceId;
        if(systemParams.getRealm()!=null) {
            headerServiceId = new BasicHeader(serviceIdHeaderName, chooseServiceIdBasedOnRealm(systemParams.getRealm()));
        } else {
            headerServiceId = new BasicHeader(serviceIdHeaderName, serviceIdHeaderStaffValue);
        }
        List<String> cookiesList = headerMap.get("cookie");
        List<Header> headers = new ArrayList<>();
        if (easupBasicAuthEnable&&!easupBasicAuthLogin.isEmpty()&&!easupBasicAuthPassword.isEmpty()) {
            final String auth = easupBasicAuthLogin + ":" + easupBasicAuthPassword;
            final byte[] encodedAuth = Base64.encodeBase64(auth.getBytes(StandardCharsets.ISO_8859_1));
            final String authH = "Basic " + new String(encodedAuth);
            Header authHeader = new BasicHeader(HttpHeaders.AUTHORIZATION, authH);
            headers.add(headerPernr);
            headers.add(headerSessionId);
            headers.add(authHeader);
            headers.add(headerCSRFToken);
            headers.add(headerRoles);
            headers.add(headerLogId);
            headers.add(headerServiceId);
            for (String cookie : cookiesList ) {
                headers.add(new BasicHeader("Cookie",cookie));
            }
        } else {
            headers.add(headerPernr);
            headers.add(headerSessionId);
            headers.add(headerCSRFToken);
            headers.add(headerRoles);
            headers.add(headerLogId);
            headers.add(headerServiceId);
            for (String cookie : cookiesList ) {
                headers.add(new BasicHeader("Cookie",cookie));
            }
        }
        return finishSettings(sslContext, headers);
    }

    public RestTemplate finishSettings(SSLContext sslContext, List<Header> headers) {
        final SSLConnectionSocketFactory sslsf = new SSLConnectionSocketFactory(sslContext, NoopHostnameVerifier.INSTANCE);
        final Registry<ConnectionSocketFactory> socketFactoryRegistry = RegistryBuilder.<ConnectionSocketFactory> create()
                .register("https", sslsf)
                .register("http", new PlainConnectionSocketFactory())
                .build();

        final BasicHttpClientConnectionManager connectionManager =
                new BasicHttpClientConnectionManager(socketFactoryRegistry);

        final HttpClient httpClient = HttpClients.custom()
                .setDefaultHeaders(headers)
                .setConnectionManager(connectionManager)
                .build();
        
        Map<String,String> headersValue = new HashMap<>(headers.size());
        for (Header header : headers ) {
            headersValue.put(header.getName(),header.getValue());
        }

        RestTemplate restTemplate = new RestTemplateBuilder()
                .defaultHeader(HttpHeaders.CONTENT_TYPE,"application/json;charset=UTF-8")
                .defaultHeader("pernr", headersValue.get("pernr"))
                .defaultHeader("sessionId", headersValue.get("sessionId"))
                .defaultHeader("x-csrf-token", headersValue.get("x-csrf-token"))
                .defaultHeader("Roles", headersValue.get("Roles"))
                .defaultHeader("logId", headersValue.get("logId"))
                .defaultHeader("Cookie", headersValue.get("Cookie"))
                .defaultHeader(serviceIdHeaderName,headersValue.get(serviceIdHeaderName))
                .build();

        restTemplate.setRequestFactory(new HttpComponentsClientHttpRequestFactory(httpClient));
        List<ClientHttpRequestInterceptor> interceptors = restTemplate.getInterceptors();
        if (CollectionUtils.isEmpty(interceptors)) {
            interceptors = new ArrayList<>();
        }
        interceptors.add(new EasupRequestInterceptor(logUtil));
        interceptors.add(easupClientSideMetricsInterceptor);
        restTemplate.setInterceptors(interceptors);

        return restTemplate;
    }

    private String chooseServiceIdBasedOnRealm (String realm) {
        switch (realm) {
            case RealmConstant.STAFF_REALM:
                return serviceIdHeaderStaffValue;
            case RealmConstant.STAFF_MOBILE_REALM:
                return serviceIdHeaderStaffMobileValue;
            default:
                return serviceIdHeaderStaffValue;
        }
    }
}



package ru.ntdev.srhr.ms.easup.integration.config;


import lombok.extern.slf4j.Slf4j;
import org.apache.hc.client5.http.ssl.TrustAllStrategy;
import org.apache.hc.core5.ssl.SSLContextBuilder;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Configuration;
import org.springframework.util.ResourceUtils;
import ru.ntdev.srhr.common.constant.RolesConstant;

import javax.net.ssl.SSLContext;
import java.io.FileInputStream;
import java.io.IOException;
import java.security.*;
import java.security.cert.CertificateException;

@Slf4j
@Configuration
public class EasupCertificateConfig {

    @Value("${easup.ssl.mss-full.trust-store}") String mssFullTrustStorePath;
    @Value("${easup.ssl.mss-full.trust-store-password}") String  mssFullTrustStorePass;
    @Value("${easup.ssl.mss-full.trust-store-type}") String  mssFullTrustStoreType;
    @Value("${easup.ssl.mss-full.key-store}") String mssFullKeyStorePath;
    @Value("${easup.ssl.mss-full.key-store-password}") String mssFullKeyStorePass;
    @Value("${easup.ssl.mss-full.key-store-type}") String mssFullKeyStoreType;

    @Value("${easup.ssl.mss-limited.trust-store}") String mssLimitedTrustStorePath;
    @Value("${easup.ssl.mss-limited.trust-store-password}") String mssLimitedTrustStorePass;
    @Value("${easup.ssl.mss-limited.trust-store-type}") String mssLimitedTrustStoreType;
    @Value("${easup.ssl.mss-limited.key-store}") String mssLimitedKeyStorePath;
    @Value("${easup.ssl.mss-limited.key-store-password}") String mssLimitedKeyStorePass;
    @Value("${easup.ssl.mss-limited.key-store-type}") String mssLimitedKeyStoreType;

    @Value("${easup.ssl.mss-standard.trust-store}") String mssStandardTrustStorePath;
    @Value("${easup.ssl.mss-standard.trust-store-password}") String mssStandardTrustStorePass;
    @Value("${easup.ssl.mss-standard.trust-store-type}") String mssStandardTrustStoreType;
    @Value("${easup.ssl.mss-standard.key-store}") String mssStandardKeyStorePath;
    @Value("${easup.ssl.mss-standard.key-store-password}") String mssStandardKeyStorePass;
    @Value("${easup.ssl.mss-standard.key-store-type}") String mssStandardKeyStoreType;

    @Value("${easup.ssl.ess.trust-store}") String essTrustStorePath;
    @Value("${easup.ssl.ess.trust-store-password}") String essTrustStorePass;
    @Value("${easup.ssl.ess.trust-store-type}") String essTrustStoreType;
    @Value("${easup.ssl.ess.key-store}") String essKeyStorePath;
    @Value("${easup.ssl.ess.key-store-password}") String essKeyStorePass;
    @Value("${easup.ssl.ess.key-store-type}") String essKeyStoreType;

    @Value("${easup.ssl.tabel.trust-store}") String tabelTrustStorePath;
    @Value("${easup.ssl.tabel.trust-store-password}") String tabelTrustStorePass;
    @Value("${easup.ssl.tabel.trust-store-type}") String tabelTrustStoreType;
    @Value("${easup.ssl.tabel.key-store}") String tabelKeyStorePath;
    @Value("${easup.ssl.tabel.key-store-password}") String tabelKeyStorePass;
    @Value("${easup.ssl.tabel.key-store-type}") String tabelKeyStoreType;
    public SSLContext configureHttpClientSsl(String role) {

        try {
            final KeyStore trustStore;

            final KeyStore keyStore;

            final String keyStorePass;

            switch (role) {
                case RolesConstant.MSS_FULL:
                    trustStore = KeyStore.getInstance(mssFullTrustStoreType);
                    trustStore.load(new FileInputStream(ResourceUtils.getFile(mssFullTrustStorePath)), mssFullTrustStorePass.toCharArray());
                    keyStore = KeyStore.getInstance(mssFullKeyStoreType);
                    keyStore.load(new FileInputStream(ResourceUtils.getFile(mssFullKeyStorePath)), mssFullKeyStorePass.toCharArray());
                    keyStorePass = mssFullKeyStorePass;
                    break;
                case RolesConstant.MSS_LIMITED:
                    trustStore = KeyStore.getInstance(mssLimitedTrustStoreType);
                    trustStore.load(new FileInputStream(ResourceUtils.getFile(mssLimitedTrustStorePath)), mssLimitedTrustStorePass.toCharArray());
                    keyStore = KeyStore.getInstance(mssLimitedKeyStoreType);
                    keyStore.load(new FileInputStream(ResourceUtils.getFile(mssLimitedKeyStorePath)), mssLimitedKeyStorePass.toCharArray());
                    keyStorePass = mssLimitedKeyStorePass;
                    break;
                case RolesConstant.MSS_STANDARD:
                    trustStore = KeyStore.getInstance(mssStandardTrustStoreType);
                    trustStore.load(new FileInputStream(ResourceUtils.getFile(mssStandardTrustStorePath)), mssStandardTrustStorePass.toCharArray());
                    keyStore = KeyStore.getInstance(mssStandardKeyStoreType);
                    keyStore.load(new FileInputStream(ResourceUtils.getFile(mssStandardKeyStorePath)), mssStandardKeyStorePass.toCharArray());
                    keyStorePass = mssStandardKeyStorePass;
                    break;
                case RolesConstant.ESS:
                    trustStore = KeyStore.getInstance(essTrustStoreType);
                    trustStore.load(new FileInputStream(ResourceUtils.getFile(essTrustStorePath)), essTrustStorePass.toCharArray());
                    keyStore = KeyStore.getInstance(essKeyStoreType);
                    keyStore.load(new FileInputStream(ResourceUtils.getFile(essKeyStorePath)), essKeyStorePass.toCharArray());
                    keyStorePass = essKeyStorePass;
                    break;
                case RolesConstant.TABEL:
                    trustStore = KeyStore.getInstance(tabelTrustStoreType);
                    trustStore.load(new FileInputStream(ResourceUtils.getFile(tabelTrustStorePath)), tabelTrustStorePass.toCharArray());
                    keyStore = KeyStore.getInstance(tabelKeyStoreType);
                    keyStore.load(new FileInputStream(ResourceUtils.getFile(tabelKeyStorePath)), tabelKeyStorePass.toCharArray());
                    keyStorePass = tabelKeyStorePass;
                    break;
                default:
                    log.warn("При выборе сертификата не найдена указанная в запросе роль: [{}]",role);
                    throw new RuntimeException("Указанная роль не числится среди вариантов при выборе сертификата.");
            }

            return SSLContextBuilder.create()
                    .loadKeyMaterial(keyStore, keyStorePass.toCharArray())
                    .loadTrustMaterial(trustStore, TrustAllStrategy.INSTANCE)
                    .build();

        } catch (KeyStoreException|UnrecoverableKeyException|KeyManagementException exception) {
            throw new RuntimeException("Ошибка чтения кейстора/получения ключа", exception);
        } catch (CertificateException exception) {
            throw new RuntimeException("Ошибка чтения сертификата", exception);
        } catch (NoSuchAlgorithmException exception) {
            throw new RuntimeException("Ошибка работы алгоритма шифрования", exception);
        } catch (IOException exception) {
            throw new RuntimeException("Ошибка чтения файла трастстора/кейстора", exception);
        }
    }
}


package ru.ntdev.srhr.ms.easup.integration.filter;

import lombok.AllArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpRequest;
import org.springframework.http.client.ClientHttpRequestExecution;
import org.springframework.http.client.ClientHttpRequestInterceptor;
import org.springframework.http.client.ClientHttpResponse;
import org.springframework.stereotype.Component;
import ru.ntdev.srhr.ms.easup.integration.monitoring.EasupRequestDurationTimer;

import java.io.IOException;

@Component
@Slf4j
public class EasupClientSideMetricsInterceptor implements ClientHttpRequestInterceptor {
    @Autowired
    private EasupRequestDurationTimer timer;

    private static final String ERROR_CODE = "500";

    public ClientHttpResponse intercept(HttpRequest request, byte[] body, ClientHttpRequestExecution execution) throws IOException {
        log.debug("Сработал перехватчик для подсчёта метрики timer");

        long start = 0;
        long end;
        ClientHttpResponse response;
        String endpoint = formatRequestEndpoint(request);
        String method = request.getMethod().name();

        try {
            start = System.currentTimeMillis();
            response = execution.execute(request, body);
        } catch (Exception e) {
            end = System.currentTimeMillis();
            timer.setTimer(endpoint, method, ERROR_CODE);
            timer.record(end - start);
            throw e;
        }

        end = System.currentTimeMillis();
        String statusCode = response.getStatusCode().toString().substring(0, 3);

        timer.setTimer(endpoint, method, statusCode);
        timer.record(end - start);

        return response;
    }

    private String formatRequestEndpoint(HttpRequest request) {
        String endpoint = request.getURI().getPath();
        int endEndpointIndex = endpoint.indexOf('(');

        if (endEndpointIndex != -1) {
            endpoint = endpoint.substring(0, endEndpointIndex);
        }

        return endpoint;
    }

}


package ru.ntdev.srhr.ms.easup.integration.monitoring;

import io.micrometer.core.instrument.MeterRegistry;
import io.micrometer.core.instrument.Tags;
import io.micrometer.core.instrument.Timer;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpRequest;
import org.springframework.stereotype.Component;

import java.io.IOException;
import java.util.concurrent.TimeUnit;

@Component
@Slf4j
public class EasupRequestDurationTimer {
    @Autowired
    private MeterRegistry registry;

    private static final String TIMER_NAME = "http_client_requests_seconds_count";
    private static final String TIMER_LABEL_SYSTEM = "system";
    private static final String TIMER_LABEL_ENDPOINT = "endpoint";
    private static final String TIMER_LABEL_METHOD = "method";
    private static final String TIMER_LABEL_STATUS = "status";
    private static final String SYSTEM_NAME = "easup";

    private Timer timer;

    public void setTimer(String endpoint, String method, String responseCode) throws IOException {
        timer = Timer.builder(TIMER_NAME)
                .tags(createTags(
                        SYSTEM_NAME,
                        endpoint,
                        method,
                        responseCode))
                .register(registry);
    }

    public void record(long duration) {
        timer.record(duration, TimeUnit.MILLISECONDS);
    }

    private Tags createTags(String system, String endpoint, String method, String status) {
        return Tags.of(
                TIMER_LABEL_SYSTEM, system,
                TIMER_LABEL_ENDPOINT, endpoint,
                TIMER_LABEL_METHOD, method,
                TIMER_LABEL_STATUS, status
        );
    }

}
