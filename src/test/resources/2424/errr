@Override
public ClientHttpResponse intercept(
        HttpRequest request,
        byte[] body,
        ClientHttpRequestExecution execution
) throws IOException {

    String token;
    try {
        token = epaTokenProvider.getToken(role);
    } catch (HttpClientErrorException.Unauthorized |
             HttpClientErrorException.Forbidden e) {
        throw new EpaTokenException("Ошибка авторизации EPA для роли: " + role, e);
    }

    request.getHeaders().setBearerAuth(token);

    ClientHttpResponse response = execution.execute(request, body);

    if (response.getStatusCode().value() == 401) {
        response.close();

        log.info("Повторный запрос токена EPA для роли [{}]", role);

        try {
            token = epaTokenProvider.refreshToken(role);
        } catch (HttpClientErrorException.Unauthorized |
                 HttpClientErrorException.Forbidden e) {
            throw new EpaTokenException("Ошибка обновления токена EPA для роли: " + role, e);
        }

        request.getHeaders().setBearerAuth(token);
        response = execution.execute(request, body);
    }

    return response;
}



public class EpaTokenException extends RuntimeException {

    public EpaTokenException(String message, Throwable cause) {
        super(message, cause);
    }
}



@ExceptionHandler(EpaTokenException.class)
public ResponseEntity<Object> handleEpaTokenException(
        HttpServletRequest req,
        EpaTokenException e) {

    AuditContext ctx = AuditContext.from(req);

    log.error("Ошибка получения токена EPA", e);

    SrhrErrorDto dto = resolveError(
            "Не удалось получить токен EPA",
            "502",
            ctx.traceId()
    );

    sendUnexpectedErrorAuditEvent(ctx, dto.getError().getMessage());

    return new ResponseEntity<>(dto, HttpStatus.BAD_GATEWAY);
}
