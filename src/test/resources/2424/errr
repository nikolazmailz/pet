package ru.ntdev.srhr.common.web.systemparams;

import org.springframework.core.MethodParameter;
import org.springframework.web.bind.support.WebDataBinderFactory;
import org.springframework.web.context.request.NativeWebRequest;
import org.springframework.web.method.support.HandlerMethodArgumentResolver;
import org.springframework.web.method.support.ModelAndViewContainer;
import ru.ntdev.srhr.common.dto.SapSystemParamsDto;

public class SapSystemParamsResolver implements HandlerMethodArgumentResolver {

    @Override
    public boolean supportsParameter(MethodParameter parameter) {
        return parameter.hasParameterAnnotation(SapSystemParams.class)
                && SapSystemParamsDto.class.isAssignableFrom(parameter.getParameterType());
    }

    @Override
    public SapSystemParamsDto resolveArgument(MethodParameter parameter,
                                              ModelAndViewContainer mavContainer,
                                              NativeWebRequest webRequest,
                                              WebDataBinderFactory binderFactory) {
        SapSystemParamsDto systemParams = new SapSystemParamsDto();

        systemParams.setTabNumber(webRequest.getHeader("pernr"));
        systemParams.setSessionId(webRequest.getHeader("sessionId"));
        systemParams.setRole(webRequest.getHeader("role"));
        systemParams.setRolesHeader(webRequest.getHeader("Roles"));
        systemParams.setTraceId(webRequest.getHeader("logId"));
        systemParams.setRealm(webRequest.getHeader("realm"));

        return systemParams;
    }
}
