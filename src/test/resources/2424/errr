@Override
    public ClientHttpResponse intercept(
            HttpRequest request,
            byte[] body,
            ClientHttpRequestExecution execution
    ) throws IOException {


        String token = epaTokenProvider.getToken(role);
        request.getHeaders().setBearerAuth(token);

        ClientHttpResponse response = execution.execute(request, body);

        if (response.getStatusCode().value() == 401) {
            response.close();

            log.info("Повторный запрос токена EPA для роли [{}]", role);

            token = epaTokenProvider.refreshToken(role);
            request.getHeaders().setBearerAuth(token);

            response = execution.execute(request, body);
        }

        return response;
    }



package ru.ntdev.srhr.ms.master.data.integration.filter;

import jakarta.servlet.http.HttpServletRequest;
import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.List;
import java.util.Objects;
import java.util.stream.Collectors;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.apache.hc.client5.http.HttpResponseException;
import org.springframework.core.Ordered;
import org.springframework.core.annotation.Order;
import org.springframework.http.HttpStatus;
import org.springframework.http.HttpStatusCode;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;
import org.springframework.web.client.HttpClientErrorException;
import org.springframework.web.client.HttpServerErrorException;
import org.springframework.web.method.annotation.HandlerMethodValidationException;
import ru.ntdev.srhr.common.audit.senders.AuditSenderResolver;
import ru.ntdev.srhr.common.dto.api.error.ErrorResponse;
import ru.ntdev.srhr.common.dto.api.error.SrhrError;
import ru.ntdev.srhr.common.dto.api.error.SrhrErrorDetail;
import ru.ntdev.srhr.common.dto.api.error.SrhrErrorDto;
import ru.ntdev.srhr.common.dto.sap.SapErrorDetails;
import ru.ntdev.srhr.common.dto.sap.SapErrorResponse;
import ru.ntdev.srhr.common.util.LogUtil;
import ru.ntdev.srhr.ms.master.data.integration.controller.MigratedEndpoint;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.springframework.context.MessageSourceResolvable;
import ru.ntdev.srhr.ms.master.data.integration.exception.EasupNotFoundException;

@Slf4j
@RestControllerAdvice(annotations = MigratedEndpoint.class)
@Order(Ordered.HIGHEST_PRECEDENCE)
@RequiredArgsConstructor
public class IntegrationExceptionHandler {

    private static final String ATTR_REQUEST_TYPE = "requestType";
    private static final String ATTR_SESSION_ID = "sessionId";
    private static final String ATTR_PERNR = "pernr";
    private static final String ATTR_ADLOGIN = "adlogin";
    private static final String ATTR_TRACE_ID = "traceId";
    private static final String UNDEFINED = "undefined";

    private static final String CODE_INTERNAL = "500";
    private static final String CODE_NPE = "NPE";
    private static final int STATUS_NOT_EXTENDED = 510;

    private static final String SAP_ERROR_MARKER = "{\"error\"";
    private static final String SAP_MESSAGE_MARKER = "SAP";

    private final ObjectMapper objectMapper;
    private final AuditSenderResolver auditSenderResolver;

    @ExceptionHandler(Exception.class)
    public ResponseEntity<Object> defaultErrorHandler(HttpServletRequest req, Exception e) {
        AuditContext ctx = AuditContext.from(req);
        SrhrErrorDto dto = resolveError(e.getMessage(), CODE_INTERNAL, ctx.traceId());

        LogUtil.logSapErrorResponse(ctx.pernr(), ctx.sessionId(), e.getMessage(), ctx.traceId(), null);
        sendUnexpectedErrorAuditEvent(ctx, dto.getError().getMessage());
        return new ResponseEntity<>(dto, HttpStatus.INTERNAL_SERVER_ERROR);
    }

    @ExceptionHandler(NullPointerException.class)
    public ResponseEntity<Object> nullPointerExceptionHandler(HttpServletRequest req, NullPointerException e) {
        AuditContext ctx = AuditContext.from(req);
        SrhrErrorDto dto = new SrhrErrorDto()
                .setError(new SrhrError(ErrorResponse.EASUP_RETURNED_NULL, ctx.traceId(), List.of()));

        sendNotFoundAuditEvent(ctx, ErrorResponse.EASUP_RETURNED_NULL);
        return new ResponseEntity<>(dto, HttpStatus.NOT_FOUND);
    }

    @ExceptionHandler(HttpServerErrorException.class)
    public ResponseEntity<Object> httpServerErrorHandler(HttpServletRequest req, HttpServerErrorException e) {
        AuditContext ctx = AuditContext.from(req);
        int status = e.getStatusCode().value();
        SrhrErrorDto dto = resolveError(e.getMessage(), String.valueOf(status), ctx.traceId());

        LogUtil.logSapErrorResponse(ctx.pernr(), ctx.sessionId(), e.getMessage(), ctx.traceId(), status);
        if (status != STATUS_NOT_EXTENDED) {
            sendUnexpectedErrorAuditEvent(ctx, dto.getError().getMessage());
        }
        return new ResponseEntity<>(dto, e.getStatusCode());
    }

    @ExceptionHandler(HttpResponseException.class)
    public ResponseEntity<Object> httpResponseErrorHandler(HttpServletRequest req, HttpResponseException e) {
        return handleHttpStatus(req, e.getStatusCode(), String.valueOf(e.getStatusCode()), e.getMessage());
    }

    @ExceptionHandler(HttpClientErrorException.class)
    public ResponseEntity<Object> httpClientErrorHandler(HttpServletRequest req, HttpClientErrorException e) {
        return handleHttpStatus(req, e.getStatusCode().value(), e.getStatusCode().toString(), e.getMessage());
    }

    @ExceptionHandler(HandlerMethodValidationException.class)
    public ResponseEntity<Object> validationMethodErrorHandler(HandlerMethodValidationException e) {
        String errorText = e.getAllValidationResults().stream()
                .flatMap(result -> result.getResolvableErrors().stream())
                .map(MessageSourceResolvable::getDefaultMessage)
                .filter(Objects::nonNull)
                .collect(Collectors.joining(", "));
        SrhrError error = new SrhrError(errorText, String.valueOf(e.getStatusCode()), List.of());
        return new ResponseEntity<>(new SrhrErrorDto(error), HttpStatus.UNPROCESSABLE_ENTITY);
    }

    @ExceptionHandler({
            EasupNotFoundException.class
    })
    public ResponseEntity<SrhrErrorDto> handleNotFound(
            HttpServletRequest req,
            RuntimeException ex
    ) {
        log.warn(ex.getMessage());
        AuditContext ctx = AuditContext.from(req);

        SrhrErrorDto errorDto = new SrhrErrorDto();
        SrhrError error = new SrhrError(
                ex.getMessage(),
                ctx.traceId,
                new ArrayList<>());

        sendNotFoundAuditEvent(ctx, ex.getMessage());

        return new ResponseEntity<>(errorDto.setError(error), HttpStatus.NOT_FOUND);
    }


    private ResponseEntity<Object> handleHttpStatus(HttpServletRequest req, int status, String code, String message) {
        AuditContext ctx = AuditContext.from(req);
        SrhrErrorDto dto = resolveError(message, code, ctx.traceId());

        LogUtil.logSapErrorResponse(ctx.pernr(), ctx.sessionId(), message, ctx.traceId(), status);

        if (status == HttpStatus.UNAUTHORIZED.value() || status == HttpStatus.FORBIDDEN.value()) {
            sendForbiddenAuditEvent(ctx, dto.getError().getMessage());
        } else if (status == HttpStatus.NOT_FOUND.value()) {
            sendNotFoundAuditEvent(ctx, dto.getError().getMessage());
            dto = new SrhrErrorDto()
                    .setError(new SrhrError(ErrorResponse.EASUP_REQUEST_NOT_FOUND, ctx.traceId(), List.of()));
        } else {
            logFailure(ctx, dto.getError().getMessage());
        }

        return new ResponseEntity<>(dto, HttpStatusCode.valueOf(status));
    }

    private SrhrErrorDto resolveError(String message, String code, String traceId) {
        if (message != null && message.contains(SAP_MESSAGE_MARKER)) {
            return parseSapError(message);
        }
        SrhrError error = new SrhrError(message, traceId, List.of());
        return new SrhrErrorDto(error);
    }

    private SrhrErrorDto parseSapError(String message) {
        try {
            int start = message.indexOf(SAP_ERROR_MARKER);
            if (start == -1) {
                return new SrhrErrorDto();
            }
            String json = message.substring(start);
            SapErrorResponse sapError = objectMapper.readValue(json, SapErrorResponse.class);
            SrhrError error = new SrhrError();
            error.setMessage(sapError.getError().getMessage());
            error.setDetails(toSrhrErrorDetail(sapError.getError().getDetails()));
            return new SrhrErrorDto(error);
        } catch (Exception e) {
            log.warn("Не удалось разобрать ошибку SAP: {}", e.getMessage());
            return new SrhrErrorDto();
        }
    }

    private List<SrhrErrorDetail> toSrhrErrorDetail(List<SapErrorDetails> details) {
        if (details == null) return List.of();
        return details.stream()
                .map(detail -> new SrhrErrorDetail(detail.getCode(), detail.getMessage()))
                .toList();
    }

    private static void logFailure(AuditContext ctx, String errorText) {
        log.error("Неуспешное выполнение эндпоинта [{}] для юзера: [{}]. Ошибка: [{}]",
                ctx.requestType(), ctx.pernr(), errorText);
    }

    // Audit
    private record AuditContext(
            String requestType,
            String sessionId,
            String pernr,
            String adlogin,
            String traceId,
            LocalDateTime sessionCreatedAt
    ) {
        static AuditContext from(HttpServletRequest req) {
            Object requestType = req.getAttribute(ATTR_REQUEST_TYPE);
            Object sessionId = req.getAttribute(ATTR_SESSION_ID);
            Object pernr = req.getAttribute(ATTR_PERNR);
            Object adlogin = req.getAttribute(ATTR_ADLOGIN);
            Object traceId =req.getAttribute(ATTR_TRACE_ID);

            if (requestType == null || sessionId == null || pernr == null || adlogin == null || traceId == null) {
                log.warn(ErrorResponse.ERROR_NOT_ALL_REQUIRED_AUDIT_PARAMS_MESSAGE);
            }

            return new AuditContext(
                    orUndefined(requestType),
                    orUndefined(sessionId),
                    orUndefined(pernr),
                    orUndefined(adlogin),
                    orUndefined(traceId),
                    LocalDateTime.now()
            );
        }

        private static String orUndefined(Object value) {
            return value != null ? value.toString() : UNDEFINED;
        }

    }

    private void sendUnexpectedErrorAuditEvent(AuditContext ctx, String message) {
        try {
            log.error("Неуспешное выполнение запроса [{}}] для юзера: [{}]. Ошибка: [{}]",
                    ctx.requestType(), ctx.pernr(), message);
            auditSenderResolver.resolve(ctx.requestType)
                    .sendUnexpectedErrorEvent(ctx.sessionId(), ctx.sessionCreatedAt());
        } catch (Exception ex) {
            log.error("Ошибка отправки события в аудит UnexpectedErrorAuditEvent: [{}]", ex.getMessage());
        }
    }

    private void sendNotFoundAuditEvent(AuditContext ctx, String easupReturnedNull) {
        try {
            log.error("Неуспешное выполнение запроса [{}}] для юзера: [{}]. Ошибка: [{}]",
                    ctx.requestType(), ctx.pernr(), easupReturnedNull);
            auditSenderResolver.resolve(ctx.requestType)
                    .sendNotFoundEvent(ctx.sessionId(), ctx.sessionCreatedAt());
        } catch (Exception ex) {
            log.error("Ошибка отправки события в аудит NotFoundAuditEvent: [{}]", ex.getMessage());
        }
    }

    private void sendForbiddenAuditEvent(AuditContext ctx, String message) {
        try {
            log.error("Неуспешное выполнение запроса [{}}] для юзера: [{}]. Ошибка: [{}]",
                    ctx.requestType(), ctx.pernr(), message);
            auditSenderResolver.resolve(ctx.requestType)
                    .sendForbiddenEvent(ctx.sessionId(), ctx.sessionCreatedAt());
        } catch (Exception ex) {
            log.error("Ошибка отправки события в аудит NotFoundAuditEvent: [{}]", ex.getMessage());
        }
    }


}
