    @Component
    @RequiredArgsConstructor
    public class RequestEnvelopeDeserializer {

        private final ObjectMapper objectMapper;

        public <T> RequestEnvelope<T> deserialize(String json, Class<T> payloadType)
                throws JsonProcessingException {
            JavaType envelopeType = objectMapper.getTypeFactory()
                    .constructParametricType(RequestEnvelope.class, payloadType);
            return objectMapper.readValue(json, envelopeType);
        }
    }
