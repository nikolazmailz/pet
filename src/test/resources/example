import java.util.List;

@Data
@Schema(description = "Общий запрос", name = "RequisitionRequestDto", nullable = true)
public class RequisitionRequestDto extends SapRequestDto {
    
    @JsonProperty("@odata.context")
    private String ODataContext;
    
    @Schema(description = "OData тег", example = "W/\"11111111111111\"")
    @JsonProperty("@odata.metadataEtag")
    private String ODataTag;
    
    @Schema(description = "Код вкладки", minLength = 1, maxLength = 50, required = false, nullable = true)
    private String tab;
    
    @Schema(description = "'Табельный номер выбранного делегатора'", minLength = 0, maxLength = 8, required = false, nullable = true)
