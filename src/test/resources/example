    private List<InterviewerActionItem> interviewers;

    @Schema(description = "Идентификатор кандидата", maxLength = 20)
    private String candidateId;

    @Schema(description = "Идентификатор этапа", maxLength = 20, required = false, nullable = true)
    private String eventId;

    @Schema(description = "Код этапа", example = "overview", maxLength = 20, required = false, nullable = true)
