@Data
@AllArgsConstructor
@NoArgsConstructor
@Schema(description = "Запрос для получения кандидатов в ожидании")
public class PendingCandidatesRequest {

    @Schema(description = "Корневой объект параметров запроса", required = true, nullable = false)
    private Request request;

    @Data
    @AllArgsConstructor
    @NoArgsConstructor
    @Schema(description = "Детали запроса")
    public static class Request {
        @Schema(description = "Персональный номер (pernr)", required = true, nullable = false)
        private String pernr;
    }
}
