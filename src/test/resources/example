    @Schema(description = "Код статуса", example = "overview", maxLength = 20, required = false, nullable = true)
    private String statusCode;

    @Schema(description = "Текст комментария", example = "overview", maxLength = 255, required = false, nullable = true)
    private String comment;

    @Schema(description = "Строка поиска", example = "", maxLength = 255, required = false, nullable = true)
    private String searchString;

