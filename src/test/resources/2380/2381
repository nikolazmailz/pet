@Service
@RequiredArgsConstructor
@Slf4j
public class OrganizationStructureService {

    private static final String LINEAR_DEPENDENCY_TYPE = "L";
    private static final String REQUEST_TYPE = "org_structure_by_id";

    private final EasupService easupService;

    @Value("${sappo.org-structure-service-id}")
    private String serviceId;

    public OrgStructureDto getLinearOrgStructure(
            SapSystemParamsDto systemParamsDto,
            String tabNumber,
            Long date
    ) {
        systemParamsDto.setRequestType(REQUEST_TYPE);

        OrgStructureDto response = easupService.getOrgStructure(
                systemParamsDto,
                serviceId,
                tabNumber,
                date,
                LINEAR_DEPENDENCY_TYPE
        );

        if (response == null) {
            log.warn(
                    "Линейная оргструктура не найдена, tabNumber={}",
                    tabNumber
            );

            throw new ResponseStatusException(
                    HttpStatus.NOT_FOUND,
                    "Линейная оргструктура не найдена"
            );
        }

        log.info(
                "Успешное получение линейной оргструктуры, tabNumber={}",
                tabNumber
        );

        return response;
    }
}



@RestController
@RequiredArgsConstructor
@Validated
@Slf4j
public class OrganizationStructureController {

    private final OrganizationStructureService organizationStructureService;

    @Audit("SRHR_ORG_STRUCTURE_LINEAR_GET")
    @GetMapping(
            value = "/org-structures/linear",
            produces = MediaType.APPLICATION_JSON_VALUE
    )
    @Operation(
            summary = "Получение линейной оргструктуры подразделений",
            tags = "org-structure",
            security = @SecurityRequirement(name = "bearerAuth")
    )
    @ApiResponses({
            @ApiResponse(
                    responseCode = "200",
                    description = "Линейная оргструктура успешно получена",
                    content = @Content(
                            mediaType = "application/json",
                            schema = @Schema(
                                    implementation = OrganizationLinearDtoOut.class
                            )
                    )
            ),
            @ApiResponse(
                    responseCode = "400",
                    description = "Некорректные параметры запроса"
            ),
            @ApiResponse(
                    responseCode = "401",
                    description = "Unauthorized"
            ),
            @ApiResponse(
                    responseCode = "404",
                    description = "Линейная оргструктура не найдена"
            ),
            @ApiResponse(
                    responseCode = "500",
                    description = "Внутренняя ошибка сервиса"
            )
    })
    public ResponseEntity<OrgStructureDto> getLinearOrgStructure(
            @SapSystemParams SapSystemParamsDto systemParamsDto,

            @RequestParam
            @NotBlank
            @Pattern(regexp = "\\d+")
            String tabNumber,

            @RequestParam
            @NotNull
            @Positive
            Long dt
    ) {
        OrgStructureDto response =
                organizationStructureService.getLinearOrgStructure(
                        systemParamsDto,
                        tabNumber,
                        dt
                );

        return ResponseEntity.ok(response);
    }
}



public class OrganizationStructureNotFoundException
        extends RuntimeException {

    public OrganizationStructureNotFoundException(String tabNumber) {
        super("Линейная оргструктура не найдена для сотрудника: " + tabNumber);
    }
}



@Service
@RequiredArgsConstructor
@Slf4j
public class OrganizationStructureService {

    private static final String LINEAR_DEPENDENCY_TYPE = "L";
    private static final String REQUEST_TYPE = "org_structure_by_id";

    private final EasupService easupService;

    @Value("${sappo.org-structure-service-id}")
    private String serviceId;

    public OrgStructureDto getLinearOrgStructure(
            SapSystemParamsDto systemParamsDto,
            String tabNumber,
            Long date
    ) {
        systemParamsDto.setRequestType(REQUEST_TYPE);

        OrgStructureDto response = easupService.getOrgStructure(
                systemParamsDto,
                serviceId,
                tabNumber,
                date,
                LINEAR_DEPENDENCY_TYPE
        );

        if (response == null) {
            throw new OrganizationStructureNotFoundException(tabNumber);
        }

        return response;
    }
}



@RestControllerAdvice
@Slf4j
public class GlobalExceptionHandler {

    @ExceptionHandler(OrganizationStructureNotFoundException.class)
    public ResponseEntity<ServiceErrorDto> handleNotFound(
            OrganizationStructureNotFoundException ex
    ) {
        log.warn(ex.getMessage());

        ServiceErrorDto error = new ServiceErrorDto();
        error.setMessage(ex.getMessage());
        error.setCode("ORG_STRUCTURE_NOT_FOUND");

        return ResponseEntity
                .status(HttpStatus.NOT_FOUND)
                .body(error);
    }
}


    @ExceptionHandler({
            LinearOrgStructureNotFoundException.class,
            FunctionalOrgStructureNotFoundException.class
    })
    public ResponseEntity<ServiceErrorDto> handleNotFound(
            Exception ex
    ) {
        log.warn(ex.getMessage());

        ServiceErrorDto errorDto = new ServiceErrorDto();
        ServiceError error = new ServiceError(
                ex.getMessage(),
                String.valueOf(HttpStatus.NOT_FOUND.value()),
                HttpStatus.NOT_FOUND.getReasonPhrase(),
                new ArrayList<>());

        error.setMessage(ex.getMessage());
        error.setCode("ORG_STRUCTURE_NOT_FOUND");

        return ResponseEntity
                .status(HttpStatus.NOT_FOUND)
                .body(errorDto);
    }

