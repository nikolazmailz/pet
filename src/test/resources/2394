@Service
@RequiredArgsConstructor
public class EasupVacationService {

    private final EasupClient easupClient;

    @Value("${easup.url.csrf}") String csrfUrl;
    @Value("${easup.url.vacation}") String vacationUrl;

    public VacationResponse createVacation(SapSystemParamsDto params, VacationRequest body) {
        RestTemplate rt = easupClient.forRole(params.getRole());

        // 1. fetch CSRF — x-csrf-token: fetch, без кук
        RequestEntity<Void> csrfRequest = RequestEntity.get(csrfUrl)
                .headers(easupClient.requestHeaders(params))
                .build();
        ResponseEntity<Void> csrfResponse = rt.exchange(csrfRequest, Void.class);

        // 2. боевой запрос — токен и set-cookie берутся из ответа шага 1
        RequestEntity<VacationRequest> request = RequestEntity.post(vacationUrl)
                .headers(easupClient.requestHeaders(params, csrfResponse.getHeaders()))
                .body(body);
        return rt.exchange(request, VacationResponse.class).getBody();
    }
}




    private String chooseServiceIdBasedOnRealm (String realm) {
        switch (realm) {
            case RealmConstant.STAFF_REALM:
                return serviceIdHeaderStaffValue;
            case RealmConstant.STAFF_MOBILE_REALM:
                return serviceIdHeaderStaffMobileValue;
            default:
                return serviceIdHeaderStaffValue;
        }
    }
