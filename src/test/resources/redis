package ru.ntdev.srhr.common.redis;

import io.lettuce.core.RedisClient;
import io.lettuce.core.RedisURI;
import io.lettuce.core.api.sync.RedisCommands;
import lombok.extern.slf4j.Slf4j;
import org.springframework.boot.autoconfigure.data.redis.RedisProperties;
import ru.ntdev.srhr.common.util.StringUtil;

/**
 * Утилиты для Redis
 */
@Slf4j
public class RedisUtils {

    /**
     * Проверка наличия настроек Sentinel
     *
     * @param redisProperties Настройки Redis
     * @return true - ожидается подключение к Sentinel, иначе false
     */
    public static boolean isSentinel(RedisProperties redisProperties) {
        return redisProperties.getSentinel() != null
                && redisProperties.getSentinel().getMaster() != null
                && !redisProperties.getSentinel().getMaster().isEmpty();
    }

    /**
     * Формирование URI Redis по конфигурации
     *
     * @param redisProperties Настройки Redis
     * @return URI
     */
    public static RedisURI formRedisUri(RedisProperties redisProperties) {
        RedisURI.Builder uriBuilder;

        if (RedisUtils.isSentinel(redisProperties)) {
            uriBuilder = formRedisSentinelUriBuilder(redisProperties);
        } else {
            uriBuilder = formRedisUriBuilder(redisProperties);
        }

        return uriBuilder.build();
    }

    /**
     * Подготовка Builder для соединения с Redis
     *
     * @param redisProperties Настройки Redis
     * @return RedisURI.Builder
     */
    public static RedisURI.Builder formRedisUriBuilder(RedisProperties redisProperties) {
        return RedisURI.builder()
                .withTimeout(redisProperties.getTimeout())
                .withDatabase(redisProperties.getDatabase())
                .withHost(redisProperties.getHost())
                .withPort(redisProperties.getPort())
                ;
    }

    /**
     * Подготовка Builder для соединения с Redis Sentinel
     *
     * @param redisProperties Настройки Redis
     * @return RedisURI.Builder
     */
    public static RedisURI.Builder formRedisSentinelUriBuilder(RedisProperties redisProperties) {
        RedisURI.Builder uriBuilder = RedisURI.builder()
                .withTimeout(redisProperties.getTimeout())
                .withDatabase(redisProperties.getDatabase())
                .withSentinelMasterId(redisProperties.getSentinel().getMaster());
        fillRedisAuth(uriBuilder, redisProperties.getUsername(), redisProperties.getPassword().toCharArray());
        redisProperties.getSentinel().getNodes().forEach(node -> {
            if (StringUtil.isNullOrEmpty(node)) return;
            String[] nodeHostPort = node.split(":");
            if (nodeHostPort.length < 2) return;
            RedisURI.Builder sentinelUriBuilder = RedisURI.builder()
                    .withHost(nodeHostPort[0])
                    .withPort(Integer.parseInt(nodeHostPort[1]));
            fillRedisAuth(
                    sentinelUriBuilder,
                    redisProperties.getUsername(),
                    redisProperties.getSentinel().getPassword().toCharArray()
            );
            uriBuilder.withSentinel(sentinelUriBuilder.build());
        });
        return uriBuilder;
    }

    /**
     * Создание Redis клиента
     *
     * @param redisUri URI Redis
     * @return Redis клиент
     */
    public static RedisCommands<String, String> createRedisClientConnection(RedisURI redisUri) {
        RedisClient redisClient = RedisClient.create(redisUri);
        redisClient.addListener(new RedisConnectionStateListenerImpl());
        RedisCommands<String, String> redisCommands = redisClient.connect().sync();
        return redisCommands;
    }

    /**
     * @param redisProperties Настройки redis
     * @param database        База
     * @deprecated Перезаписываем значение базы в RedisProperties, т.к. в сервисах используется не стандартный путь
     */
    public static void resetDatabase(RedisProperties redisProperties, Integer database) {
        if (database == null || database < 0) return;
        redisProperties.setDatabase(database);
    }

    /**
     * Заполнение авторизации в Redis
     *
     * @param builder  Строитель uri
     * @param userName Имя пользователя
     * @param password Пароль
     */
    private static void fillRedisAuth(
            RedisURI.Builder builder,
            String userName,
            char[] password
    ) {
        if (StringUtil.isNullOrEmpty(userName)) {
            builder.withPassword(password);
        } else {
            builder.withAuthentication(userName, password);
        }
    }
}
