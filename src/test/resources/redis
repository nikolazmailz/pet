package ru.ntdev.srhr.common.redis;

import io.lettuce.core.RedisChannelHandler;
import io.lettuce.core.RedisConnectionStateListener;
import lombok.extern.slf4j.Slf4j;

import java.net.SocketAddress;

/**
 * Слушатель состояния Redis
 * <p>
 *  Для событий Отключения и Ошибок добавлено отключение RedisAdapter.isAvailable
 * </p>
 */
@Slf4j
public class RedisConnectionStateListenerImpl implements RedisConnectionStateListener {

    @Override
    public void onRedisDisconnected(RedisChannelHandler<?, ?> redisChannelHandler) {
        if (RedisAdapter.isAvailable) {
            RedisAdapter.isAvailable = false;
        }
        log.debug("Отключение от Redis.");
    }

    @Override
    public void onRedisExceptionCaught(RedisChannelHandler<?, ?> redisChannelHandler, Throwable throwable) {
        if (RedisAdapter.isAvailable) {
            RedisAdapter.isAvailable = false;
        }
        log.error("Ошибка выполнения операции в Redis: [{}].", throwable.getMessage());
    }

    @Override
    public void onRedisConnected(RedisChannelHandler<?, ?> connection, SocketAddress socketAddress) {
        if (!RedisAdapter.isAvailable) {
            log.debug(
                    "Соединение с Redis: isOpen: [{}], isClosed: [{}], Addr: [{}].",
                    connection.isOpen(),
                    connection.isClosed(),
                    socketAddress != null ? socketAddress.toString() : null
            );
        }
    }
}


