 <dependency>
            <groupId>org.wiremock.integrations</groupId>
            <artifactId>wiremock-spring-boot</artifactId>
            <version>3.4.0</version>
            <scope>test</scope>
        </dependency>

package ru.ntdev.srhr.common.integration;

import com.github.tomakehurst.wiremock.WireMockServer;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.http.HttpEntity;
import org.springframework.http.HttpMethod;
import org.springframework.http.ResponseEntity;
import org.springframework.web.client.RestTemplate;
import org.wiremock.spring.EnableWireMock;
import org.wiremock.spring.InjectWireMock;

import static com.github.tomakehurst.wiremock.client.WireMock.*;
import static org.assertj.core.api.Assertions.assertThat;

@SpringBootTest(classes = IntegrationRestTemplateAutoConfiguration.class)
@EnableWireMock
class IntegrationRestTemplateHttpIT {

    @InjectWireMock
    private WireMockServer wm;

    @Autowired
    private RestTemplate integrationRestTemplate;

    record PeriodDto(String period) {
    }

    private static SapSystemParamsDto sapParams() {
        SapSystemParamsDto p = new SapSystemParamsDto();
        p.setTabNumber("00012345");
        p.setSessionId("sess-abc");
        p.setRole("EMPLOYEE");
        p.setAdLogin("ivanov");
        p.setRolesHeader("ROLE_A,ROLE_B");
        p.setTraceId("trace-777");
        p.setRealm("srhr");
        return p;
    }

    @Test
    void sapHeadersAreSentAndBodyIsParsed() {
        wm.stubFor(get(urlEqualTo("/paystub/period"))
                .willReturn(aResponse()
                        .withStatus(200)
                        .withHeader("Content-Type", "application/json")
                        .withBody("{\"period\":\"2024-01\"}")));

        String uri = wm.baseUrl() + "/paystub/period";
        HttpEntity<Void> request = new HttpEntity<>(IntegrationHeaders.sap(sapParams()));

        ResponseEntity<PeriodDto> resp =
                integrationRestTemplate.exchange(uri, HttpMethod.GET, request, PeriodDto.class);

        assertThat(resp.getStatusCode().value()).isEqualTo(200);
        assertThat(resp.getBody()).isNotNull();
        assertThat(resp.getBody().period()).isEqualTo("2024-01");

        wm.verify(getRequestedFor(urlEqualTo("/paystub/period"))
                .withHeader("pernr", equalTo("00012345"))
                .withHeader("sessionId", equalTo("sess-abc"))
                .withHeader("role", equalTo("EMPLOYEE"))
                .withHeader("X-user-login", equalTo("ivanov"))
                .withHeader("Roles", equalTo("ROLE_A,ROLE_B"))
                .withHeader("logId", equalTo("trace-777"))
                .withHeader("realm", equalTo("srhr")));
    }

    @Test
    void minimalHeadersOmitSapOnlyHeaders() {
        wm.stubFor(get(urlEqualTo("/tsrm/data"))
                .willReturn(aResponse()
                        .withStatus(200)
                        .withHeader("Content-Type", "application/json")
                        .withBody("{\"period\":\"x\"}")));

        String uri = wm.baseUrl() + "/tsrm/data";
        HttpEntity<Void> request = new HttpEntity<>(
                IntegrationHeaders.minimal("00012345", "sess-abc", "trace-777"));

        integrationRestTemplate.exchange(uri, HttpMethod.GET, request, PeriodDto.class);

        wm.verify(getRequestedFor(urlEqualTo("/tsrm/data"))
                .withHeader("pernr", equalTo("00012345"))
                .withHeader("sessionId", equalTo("sess-abc"))
                .withHeader("logId", equalTo("trace-777"))
                .withHeader("role", absent())
                .withHeader("X-user-login", absent())
                .withHeader("Roles", absent())
                .withHeader("realm", absent()));
    }
}



package ru.ntdev.srhr.common.integration;

import com.fasterxml.jackson.databind.ObjectMapper;
import org.junit.jupiter.api.Test;
import org.springframework.boot.autoconfigure.AutoConfigurations;
import org.springframework.boot.test.context.runner.ApplicationContextRunner;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.http.converter.json.MappingJackson2HttpMessageConverter;
import org.springframework.web.client.RestTemplate;

import static org.assertj.core.api.Assertions.assertThat;

class IntegrationRestTemplateAutoConfigurationTest {

    private final ApplicationContextRunner runner = new ApplicationContextRunner()
            .withConfiguration(AutoConfigurations.of(IntegrationRestTemplateAutoConfiguration.class));

    @Test
    void createsIntegrationRestTemplateByDefault() {
        runner.run(ctx -> assertThat(ctx).hasBean("integrationRestTemplate"));
    }

    @Test
    void backsOffWhenUserDefinesOwnBean() {
        runner.withUserConfiguration(CustomTemplateConfig.class)
                .run(ctx -> assertThat(ctx.getBean("integrationRestTemplate"))
                        .isSameAs(CustomTemplateConfig.CUSTOM));
    }

    @Test
    void attachesCustomConverterWhenPresentInContext() {
        runner.withUserConfiguration(ConverterConfig.class)
                .run(ctx -> {
                    RestTemplate rt = ctx.getBean("integrationRestTemplate", RestTemplate.class);
                    assertThat(rt.getMessageConverters()).contains(ConverterConfig.CONVERTER);
                });
    }

    @Test
    void bindsPoolPropertiesFromConfig() {
        runner.withPropertyValues(
                "integration.http.max-conn-total=50",
                "integration.http.max-conn-per-route=10"
        ).run(ctx -> {
            IntegrationHttpProperties props = ctx.getBean(IntegrationHttpProperties.class);
            assertThat(props.getMaxConnTotal()).isEqualTo(50);
            assertThat(props.getMaxConnPerRoute()).isEqualTo(10);
        });
    }

    @Configuration
    static class CustomTemplateConfig {
        static final RestTemplate CUSTOM = new RestTemplate();
        @Bean
        RestTemplate integrationRestTemplate() {
            return CUSTOM;
        }
    }

    @Configuration
    static class ConverterConfig {
        static final MappingJackson2HttpMessageConverter CONVERTER =
                new MappingJackson2HttpMessageConverter(new ObjectMapper());
        @Bean
        MappingJackson2HttpMessageConverter customConverter() {
            return CONVERTER;
        }
    }
}