@SpringBootTest
@Testcontainers
@ActiveProfiles("test")
class PendingCandidatesUseCaseIT {

    @Container
    @ServiceConnection
    static PostgreSQLContainer<?> postgres = new PostgreSQLContainer<>("postgres:15");

    @Autowired PendingCandidatesUseCase useCase;
    @Autowired PendingCandidateEntityRepository repository;
    @Autowired JdbcTemplate jdbc;

    @MockBean BscsIntegrationService bscsIntegrationService;
    @MockBean MasterDataIntegrationService masterDataIntegrationService;

    private static final String PERNR = "1001";

    @BeforeEach
    void setUp() {
        jdbc.update("delete from pending_candidates_events");
        jdbc.update("delete from pending_candidates");
        // vacancy + requisitions + structure_unit для обогащения
        jdbc.update("""
            insert into vacancy (id, integration_id, requisition_guid)
            values (100, 1, 'req-guid-1')
            """);
        jdbc.update("""
            insert into requisitions (id, integration_id, guid, number, position_type,
                staff_position_id, staff_position_name, struct_unit_id, struct_unit_name)
            values (1, 1, 'req-guid-1', '12345', 'Новая', 'sp-1', 'Аналитик', 'su-1', 'Департамент технологий')
            """);
        jdbc.update("""
            insert into structure_unit (id, requisition_uuid, order_number, path_id, type_desc, path_name)
            values (1, 'req-guid-1', 1, 'p-1', 'Управление', 'Департамент технологий'),
                   (2, 'req-guid-1', 2, 'p-2', 'Отдел', 'Отдел разработки')
            """);
    }

    @AfterEach
    void tearDown() {
        jdbc.update("delete from structure_unit");
        jdbc.update("delete from requisitions");
        jdbc.update("delete from vacancy");
    }

    // --- фикстуры ---

    private void insertCandidate(int id, String fullName, int vacancyId, String... eventCodes) {
        jdbc.update("""
            insert into pending_candidates (id, vacancy_id, candidate_id, full_name, approver_pernr)
            values (?, ?, ?, ?, ?)
            """, id, vacancyId, "ext-" + id, fullName, PERNR);
        Instant base = Instant.parse("2026-01-01T00:00:00Z");
        for (int i = 0; i < eventCodes.length; i++) {
            jdbc.update("""
                insert into pending_candidates_events
                    (pending_candidate_id, event_code, status_date, days, expiration_zone)
                values (?, ?, ?, ?, 1)
                """, id, eventCodes[i], Timestamp.from(base.plus(i, ChronoUnit.DAYS)), i);
        }
    }

    private PendingCandidatesApiRequest request(int page, int size, String search, List<String> codes) {
        return new PendingCandidatesApiRequest(page, size,
                new PendingCandidatesApiRequest.Filter(search, codes));
    }
