@Service
public class StaffDetailHandler implements SalarychangeHandler {

    private final GetStaffDetailUseCase useCase;   // ← чистый use case

    @Override
    public SalarychangeType type() { return SalarychangeType.STAFF_DETAIL; }

    @Override
    public Result handle(SalarychangeRequest req) {
        // адаптация: транспорт → доменный запрос
        var query = new StaffDetailQuery(
            req.params().listId(),
            req.params().dependencyCode(),
            req.params().expand()
        );
        var result = useCase.execute(query);   // use case не видит SystemParams
        return toResult(result);               // домен → транспортный ответ
    }
}


