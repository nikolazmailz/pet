public record SalarychangeRequest(
    RequestEntity requestEntity,
    SystemParams systemParams,
    SalarychangeParams params   // listId, filter, expand, orderBy, paging, requestValues...
) {}


public interface SalarychangeHandler {
    String requestType();
    Result handle(SalarychangeRequest req);
}

@Service
public class SalarychangeDispatcher {
    private final Map<String, SalarychangeHandler> handlers;

    public SalarychangeDispatcher(List<SalarychangeHandler> beans) {
        this.handlers = beans.stream()
            .collect(toMap(SalarychangeHandler::requestType, identity()));
    }

    public Result dispatch(SalarychangeRequest req) {
        var h = handlers.get(req.systemParams().getRequestType());
        if (h == null) throw new UnknownRequestTypeException(req.systemParams().getRequestType());
        return h.handle(req);   // тут же закрывается ветка default → Introduce Special Case
    }
}


