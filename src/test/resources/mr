@Override
    public List<StructureUnitEntity> processStructureUnits(Requisition item, RequisitionEntity entity) {
        List<StructureUnitEntity> entities = new ArrayList<>();
        if (item.getStructUnitPath() != null) {
            try {
                int orderNumber = FIRST_STRUCT_UNIT_PATH_ORDER_NUMBER;
                for (RequisitionStructureUnitPathItem requisitionStructureUnitPathItem : item.getStructUnitPath()) {
                    StructureUnitEntity structureUnitEntity = entityService.prepareStructureUnit(requisitionStructureUnitPathItem, entity, new StructureUnitEntity(), orderNumber++);
                    if (structureUnitEntity != null) {
                        entities.add(structureUnitEntity);
                    }
                }
            } catch (Exception e) {
                log.error("Ошибка при попытке подготовки сущности [structure_unit] в базу: [{}]", e.getMessage());
            }
        }
        return  entities;
    }

    @Override
    public List<ApproverEntity> processApprovers(Requisition item, RequisitionEntity entity) {
        List<ApproverEntity> entities = new ArrayList<>();
        if (item.getApprovers() != null) {
            try {
                for (RequisitionApprovers requisitionApprovers : item.getApprovers()) {
                    ApproverEntity approverEntity = entityService.prepareApprover(new ApproverEntity(), requisitionApprovers.getPernr(), requisitionApprovers.getDelegatorPernr(), entity);
                    if (approverEntity != null) {
                        entities.add(approverEntity);
                    }
                }
            } catch (Exception e) {
                log.error("Ошибка при попытке подготовки сущности [approvers] в базу: [{}]", e.getMessage());
            }
        }
        return entities;
    }
