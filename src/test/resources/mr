    private List<StructUnitPath> fillStructUnitPathList(OrgUnitEntity orgUnitEntity, LocalDateTime currentDateTime, Map<String, OrgUnitEntity> parentOrgUnitsCache) {
        List<StructUnitPath> structUnitPathList = new ArrayList<>();
        Set<String> visitedOrgUnitIds = new HashSet<>();

        OrgUnitEntity currentOrgUnitEntity = orgUnitEntity;
        OrgUnitEntity parentOrgUnitEntity;
        String parentOrgUnitId = orgUnitEntity.getOrgUnitParentId();
        String parentOrgUnitIndependence;

        do {
            addElementToList(orgUnitEntity, structUnitPathList);
            visitedOrgUnitIds.add(orgUnitEntity.getOrgUnitParentId());
            if (visitedOrgUnitIds.contains(parentOrgUnitId) || parentOrgUnitId.equals(orgUnitEntity.getOrgUnitId())) {
                break;
            }
            addElementToList(currentOrgUnitEntity, structUnitPathList);
            visitedOrgUnitIds.add(currentOrgUnitEntity.getOrgUnitParentId());

            if (parentOrgUnitsCache.containsKey(parentOrgUnitId)) {
                parentOrgUnitEntity = parentOrgUnitsCache.get(parentOrgUnitId);
            } else {
                parentOrgUnitEntity = getParentOrgUnitEntity(parentOrgUnitId, currentDateTime);
                parentOrgUnitsCache.put(parentOrgUnitId, parentOrgUnitEntity);
            }

            parentOrgUnitIndependence = parentOrgUnitEntity.getOrgUnitIndependence();

            if ("0".equals(parentOrgUnitIndependence)) {
                orgUnitEntity = parentOrgUnitEntity;
                parentOrgUnitId = orgUnitEntity.getOrgUnitParentId();
                currentOrgUnitEntity = parentOrgUnitEntity;
                parentOrgUnitId = currentOrgUnitEntity.getOrgUnitParentId();
            }
        } while ((!"1".equals(parentOrgUnitIndependence)) || !visitedOrgUnitIds.contains(parentOrgUnitId));

        } while (!"1".equals(parentOrgUnitIndependence));

        return structUnitPathList;
    }
