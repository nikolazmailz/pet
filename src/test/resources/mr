 @Override
    public RequisitionEntity processRequisition(Requisition item, DataIntegrationEntity dataIntegrationEntity, RequisitionEntity entity, Map<String, String> easupToLkrStatusMapping, Map<String, String> restoredRequisitionsMap) {
        try {
            if (entity == null) {
                String computedStatus = easupToLkrStatusMapping.get(item.getStatus().getCode());
                entity = entityService.prepareRequisition(dataIntegrationEntity, item, new RequisitionEntity(), computedStatus);
            } else {
                if (entity.getIsDeleted()){
                    restoredRequisitionsMap.put(entity.getGuid(),entity.getNumber());
                }
                String computedStatus = entity.getComputedStatus();
                if (computedStatus == null || (!entity.getStatusCode().equals("0010") && !entity.getStatusCode().equals("0006") && !entity.getStatusCode().equals("0007"))) {
                    computedStatus = easupToLkrStatusMapping.get(item.getStatus().getCode());
                }
                entity = entityService.prepareRequisition(dataIntegrationEntity, item, entity, computedStatus);
            }
        } catch (Exception e) {
            log.error("Ошибка при попытке подготовки сущности [requisition] в базу: [{}]", e.getMessage());
        }
        return entity;
    }
