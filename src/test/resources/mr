@Query(value = """
        SELECT req.guid       AS guid,
               sm.lkr_name    AS lkrName,
               vac.vacancy_id AS vacancyId
        FROM srhr_requisition.vacancy vac
        JOIN srhr_requisition.requisitions req
            ON req.guid = vac.requisition_guid
        JOIN srhr_requisition.status_mapping sm
            ON sm.lkr_code = req.computed_status
        WHERE vac.requisition_guid IN :guids
          AND req.is_deleted = false
          AND sm.lkr_code IN ('NEW', 'IN_PROGRESS', 'ON_HOLD')
        """, nativeQuery = true)
List<VacancyRequisitionShortProjection> getShortVacancyInfo(List<String> guids);
