 public VacancyEntity processStatusVacancy(VacancyStatusListItem vacancyStatusListItem, DataIntegrationEntity dataIntegrationEntity, VacancyEntity vacancyEntity, Map<String,String> estaffToLkrStatusMapping){
        try {
            if (vacancyEntity !=null) {
                vacancyEntity = entityService.prepareVacancyStatus(dataIntegrationEntity, vacancyEntity, vacancyStatusListItem);
            } else {
                vacancyEntity = entityService.prepareVacancyStatus(dataIntegrationEntity, new VacancyEntity(), vacancyStatusListItem);
            }
            if (vacancyStatusListItem.getVacancyStatusName()!=null&&vacancyStatusListItem.getVacancyStatusCode()!=null) {
                try {
                    String computedStatus = estaffToLkrStatusMapping.get(vacancyStatusListItem.getVacancyStatusCode());
                    entityService.updateRequisitionComputedStatus(computedStatus, vacancyStatusListItem.getRequisitionGuid());
                } catch (Exception e) {
                    log.error("Ошибка при попытке обновления computed_status сущности [requisition] в базе: [{}]", e.getMessage());
                }
            }
        }
        catch (Exception e) {
            log.error("Ошибка при попытке подготовки сущности [vacancy] в базу: [{}]", e.getMessage());
        }
        return vacancyEntity;
    }
