public class IntegrationServiceImpl implements IntegrationService {

    private static final int FIRST_STRUCT_UNIT_PATH_ORDER_NUMBER = 1;
  /**
     * Заполнение дто-связки между guid заявки данных о родительских подразделениях структурного подразделения
     */
    @Override
    public List<RequisitionStructureUnitPath> fillRequisitionStructureUnitPath(List<String> guidList, StructUnit unit) {
        List<RequisitionStructureUnitPath> requisitionStructureUnitPathList = new ArrayList<>();
        RequisitionStructureUnitPath requisitionStructureUnitPath;
        List<StructUnitPath> structUnitPathList = unit.getStructUnitPathList();

        // Поскольку несем прямую ДТО osrf в БД нужно ее данные изменить
        for (StructUnitPath item : structUnitPathList) {
            prepareStructUnitPathItem(item);
        }

        for (String guid : guidList) {
            int orderNumber = FIRST_STRUCT_UNIT_PATH_ORDER_NUMBER;
            for (StructUnitPath path : structUnitPathList) {
                requisitionStructureUnitPath = new RequisitionStructureUnitPath();
                requisitionStructureUnitPath.setRequisitionGuid(guid);
                requisitionStructureUnitPath.setOrderNumber(orderNumber++);
                requisitionStructureUnitPath.setPathId(path.getId());
                requisitionStructureUnitPath.setTypeDesc(path.getTypeDesc());
                requisitionStructureUnitPath.setPathName(path.getName());
                requisitionStructureUnitPathList.add(requisitionStructureUnitPath);
            }
        }

        return requisitionStructureUnitPathList;
    }

}
