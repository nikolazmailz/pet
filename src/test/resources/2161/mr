create index idx_pending_candidates_search_text
    on srhr_requisition.pending_candidates
    using gin (search_text gin_trgm_ops);


- sql:
    splitStatements: false
    sql: |
      alter table srhr_requisition.pending_candidates
      add column search_text text
      generated always as (
          translate(
              lower(
                  coalesce(full_name, '') || ' ' ||
                  coalesce(requisition_number, '') || ' ' ||
                  coalesce(position_type, '') || ' ' ||
                  coalesce(staff_position_id, '') || ' ' ||
                  coalesce(staff_position_name, '') || ' ' ||
                  coalesce(struct_unit_id, '') || ' ' ||
                  coalesce(struct_unit_name, '')
              ),
              'ё',
              'е'
          )
      ) stored;


pc.search_text like
    '%' || translate(lower(trim(cast(:search as text))), 'ё', 'е') || '%'
