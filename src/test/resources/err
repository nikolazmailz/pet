public interface RequisitionHandler {
    String requestType();

    String handle(RequisitionContext req);
}
public enum RequisitionType {
    DICT("requisition_dict");

    private final String code;

    RequisitionType(String code) {
        this.code = code;
    }

    public String getCode() {
        return code;
    }
}

@Service
public class RequisitionDispatcher {
    private final Map<String, RequisitionHandler> handlers;

    public RequisitionDispatcher(List<RequisitionHandler> beans) {
        this.handlers = beans.stream()
                .collect(toMap(RequisitionHandler::requestType, identity()));
    }

    public String dispatch(RequisitionContext req) {
        var h = handlers.get(req.systemParams().getRequestType());
        if (h == null)
            throw new IllegalStateException("Unexpected requestType value: " + req.systemParams().getRequestType());
        return h.handle(req);
    }
}

public class RequisitionDictHandler implements RequisitionHandler {

    private final GetRequisitionDictUseCase useCase;   // use case или сервис бизнес-правил

    public RequisitionDictHandler(GetRequisitionDictUseCase useCase) {
        this.useCase = useCase;
    }

    @Override
    public String requestType() { return RequisitionType.DICT.getCode(); }

    @Override
    public String handle(RequisitionContext req) {
        return useCase.execute(req);
    }
}
