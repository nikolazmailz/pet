PendingCandidatesApiResponse response = (PendingCandidatesApiResponse) out.getDto();
    PendingCandidatesPage page = response.getData();

    assertThat(page.page()).isEqualTo(1);
    assertThat(page.pageSize()).isEqualTo(10);
    assertThat(page.count()).isEqualTo(2);

    assertThat(page.eventCode())
            .extracting(EventCodeView::codeValue)
            .containsExactlyInAnyOrder("HIRE", "INTERVIEW");

    assertThat(page.candidates())
            .extracting(PendingCandidateView::fullName)
            .containsExactlyInAnyOrder("John Doe", "Bob Johnson");

    PendingCandidateView john = page.candidates().stream()
            .filter(c -> c.fullName().equals("John Doe"))
            .findFirst().orElseThrow();

    assertThat(john.candidateId()).isEqualTo(1);
    assertThat(john.vacancyId()).isEqualTo("200");
    assertThat(john.events())
            .extracting(PendingCandidateEventView::code, PendingCandidateEventView::days, PendingCandidateEventView::expirationZone)
            .containsExactly(tuple("HIRE", 30, 1), tuple("INTERVIEW", 15, 1));

    RequisitionView req = john.requisition();
    assertThat(req.guid()).isEqualTo("guid-200");
    assertThat(req.number()).isEqualTo("REQ-001");
    assertThat(req.positionType()).isEqualTo("TYPE_A");
    assertThat(req.staffPosition().id()).isEqualTo("SP-001");
    assertThat(req.staffPosition().name()).isEqualTo("Manager");
    assertThat(req.structUnitId()).isEqualTo("SU-001");
    assertThat(req.structUnitName()).isEqualTo("HR");
    assertThat(req.structUnitPathList())
            .extracting(StructUnitPathView::id, StructUnitPathView::typeDesc, StructUnitPathView::name)
            .containsExactly(tuple("SU-001", "DEPARTMENT", "HR"));

    PendingCandidateView bob = page.candidates().stream()
            .filter(c -> c.fullName().equals("Bob Johnson"))
            .findFirst().orElseThrow();
    assertThat(bob.events())
            .extracting(PendingCandidateEventView::code)
            .containsExactly("HIRE");

    // replaceForApprover: в БД должны лежать все 3 кандидата, независимо от фильтра выдачи
    assertThat(pendingCandidateEntityRepository.count()).isEqualTo(3);

    assertThat(out.getCode()).isEqualTo("200");
