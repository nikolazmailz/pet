@Entity
@Table(name = "pending_candidates")
@Getter
@Setter
public class PendingCandidateEntity {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "id")
    private Integer id;

    @Column(name = "vacancy_id", nullable = false)
    private Integer vacancyId;

    @Column(name = "candidate_id", nullable = false, length = 32)
    private String candidateId;

    @Column(name = "full_name", nullable = false, length = 255)
    private String fullName;

    @Column(name = "approver_pernr", nullable = false, length = 16)
    private String approverPernr;

    @OneToMany(mappedBy = "pendingCandidate", cascade = CascadeType.ALL, orphanRemoval = true)
    private List<PendingCandidateEventEntity> events = new ArrayList<>();
}


@Entity
@Table(name = "pending_candidates_events")
@Getter
@Setter
public class PendingCandidateEventEntity {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "id")
    private Integer id;

    @ManyToOne(fetch = FetchType.LAZY)
    @JoinColumn(name = "pending_candidate_id", nullable = false)
    private PendingCandidateEntity pendingCandidate;

    @Column(name = "event_code", nullable = false, length = 64)
    private String eventCode;

    @Column(name = "status_date", nullable = false)
    private Instant statusDate;

    @Column(name = "days")
    private Integer days;

    @Column(name = "expiration_zone")
    private Integer expirationZone;
}

package ru.ntdev.srhr.common.contracts.easup.pendingcandidates;

import io.swagger.v3.oas.annotations.media.Schema;
import java.util.List;
import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;

@Data
@AllArgsConstructor
@NoArgsConstructor
@Schema(description = "Ответ с кандидатами в ожидании")
public class PendingCandidatesResponse {

    @Schema(description = "Данные кандидатов", required = true, nullable = false)
    private CandidateInfoData data;

    @Data
    @AllArgsConstructor
    @NoArgsConstructor
    @Schema(description = "Данные кандидатов")
    public static class CandidateInfoData {

        @Schema(description = "Список кандидатов", required = true, nullable = false)
        private List<Candidate> candidates;
    }

    @Data
    @AllArgsConstructor
    @NoArgsConstructor
    @Schema(description = "Кандидат")
    public static class Candidate {

        @Schema(description = "Идентификатор кандидата", required = true, nullable = false)
        private Long candidateId;

        @Schema(description = "Идентификатор вакансии", required = true, nullable = false)
        private Long vacancyId;

        @Schema(description = "ФИО кандидата", required = true, nullable = false)
        private String fullName;

        @Schema(description = "Список событий", required = true, nullable = false)
        private List<Event> events;

    }

    @Data
    @AllArgsConstructor
    @NoArgsConstructor
    @Schema(description = "Событие кандидата")
    public static class Event {

        @Schema(description = "Код события", required = true, nullable = false)
        private String eventCode;

        @Schema(description = "Дата события в формате Unix timestamp (мс)", required = true, nullable = false)
        private Long statusDate;

        @Schema(description = "Количество дней", required = true, nullable = false)
        private Integer days;

        @Schema(description = "Зона истечения срока", required = true, nullable = false)
        private Integer expirationZone;

    }
}

