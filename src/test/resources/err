databaseChangeLog:
  - changeSet:
      id: 2026-07-27-13-45-create-pending-candidates
      author: n-pushkaryov
      changes:
        - createTable:
            tableName: pending_candidates
            remarks: Кандидаты, ожидающие решения
            columns:
              - column:
                  name: id
                  type: integer
                  autoIncrement: true
                  constraints:
                    primaryKey: true
                    nullable: false
              - column:
                  name: vacancy_id
                  type: integer
                  constraints:
                    nullable: false
                    foreignKeyName: fk_pending_candidates_vacancy
                    references: vacancy(id)
                    onDelete: cascade
              - column:
                  name: candidate_id
                  type: varchar(32)
                  constraints:
                    nullable: false
              - column:
                  name: full_name
                  type: varchar(255)
                  constraints:
                    nullable: false
              - column:
                  name: approver_pernr
                  type: varchar(16)
                  constraints:
                    nullable: false
        - createIndex:
            tableName: pending_candidates
            indexName: idx_pending_candidates_approver_pernr
            columns:
              - column:
                  name: approver_pernr



databaseChangeLog:
  - changeSet:
      id: 2026-08-06-12-00-change-vacancy-id-to-string
      author: n-pushkaryov
      changes:
        - dropForeignKeyConstraint:
            baseTableName: pending_candidates
            constraintName: fk_pending_candidates_vacancy
        - modifyDataType:
            tableName: pending_candidates
            columnName: vacancy_id
            newDataType: VARCHAR(255)
        - addForeignKeyConstraint:
            baseTableName: pending_candidates
            baseColumnNames: vacancy_id
            constraintName: fk_pending_candidates_vacancy
            referencedTableName: vacancy
            referencedColumnNames: vacancy_id
            onDelete: CASCADE




