    public String processMessage(String messageIncoming) throws Exception {
        long start = System.currentTimeMillis();
        ObjectMapper mapper = new ObjectMapper();
        SapResponseDtoExtended dto = new SapResponseDtoExtended();

        RequisitionRequestDto requestValues = mapper.readValue(messageIncoming, RequisitionRequestDto.class);
        //Проверка не было ли входящее сообщение помещено в filestorage из-за размера
        if (requestValues.getFileUuid() != null && !requestValues.getFileUuid().isEmpty()) {
            String storedMessage = getOutStoredMessage(requestValues.getAdLogin(), requestValues.getSessionId(), requestValues.getTraceId(), requestValues.getFileUuid());
            requestValues = mapper.readValue(storedMessage, RequisitionRequestDto.class);
        }

        SapSystemParamsDto systemParams = setSystemParams(requestValues);


        LogUtil.logKafkaMessageGot(
                systemParams.getAdLogin(),
                systemParams.getSessionId(),
                systemParams.getRequestType(),
                kafkaTopicNameToEasup,
                systemParams.getTraceId());
        RequisitionRequestEntity requestEntity = saveAndGetEntity(
                systemParams.getUuid(), null,
                systemParams.getSessionId(), messageIncoming,
                null, RequestStatusConstant.SENT);

        String rolesJson = setRoles(systemParams, requestEntity, dto, start);
        SystemParamsRoleListDto systemRolesDto = mapper.readValue(rolesJson, SystemParamsRoleListDto.class);
        RoleListDto rolesDto = new RoleListDto();
        BeanUtils.copyProperties(systemRolesDto, rolesDto);
        if (systemRolesDto.getErrorMessage() != null || systemRolesDto.getRoles().isEmpty()) {
            return mapper.writeValueAsString(dto);
        }
        systemParams.setRolesHeader(mapper.writeValueAsString(rolesDto));
        systemParams.setRole(chooseHighestPriorityRole(rolesDto.getRoles()));

        requestEntity.setFunctionalRole(systemParams.getRole());
        entityService.updateRequestRole(systemParams.getUuid(), systemParams.getRole());

        String systemParamsWithTabnumberJson = setTabnumberToSystemParams(systemParams, requestEntity, dto, start);

        systemParams = mapper.readValue(systemParamsWithTabnumberJson, SapSystemParamsDto.class);
        if (systemParams.getErrorMessage() != null || systemParams.getTabNumber() == null) {
            return mapper.writeValueAsString(dto);
        }
        requestEntity.setTabNumber(systemParams.getTabNumber());
        entityService.updateRequestTabnum(systemParams.getUuid(), systemParams.getTabNumber());

        String requestType = systemParams.getRequestType();

//        requisitionDispatcher.dispatch(
//                new RequisitionContext(
//                        requestEntity,
//                        systemParams
//                )
//        );

        switch (requestType) {
            // todo requisition_dict
            case "requisition_dict":
                return getRequisitionDict(requestEntity, systemParams);
            // todo
            case "requisition_ui_state":
                return getRequisitionUiState(requestEntity, systemParams, requestValues.getDelegatorTn());
            // todo ?
            case "requisition_delegations":
                return getRequisitionDelegations(requestEntity, systemParams);
            // todo ?
            case "requisition_org_units_allowable":
                return getRequisitionOrgUnitsAllowable(requestEntity, systemParams, requestValues.getDelegatorTn());
            case "requisition_post_list":
                return getRequisitionPostList(requestEntity, systemParams, requestValues);
            case "requisition_user_info":
                return getRequisitionUserInfo(requestEntity, systemParams);
            case "requisition_staff_search":
                return getRequisitionStaffSearch(requestEntity, systemParams, requestValues.getSearchString());
            case "requisition_vacancy_details":
                return getRequisitionVacancyDetails(requestEntity, systemParams, requestValues.getDelegatorTn(), requestValues.getVacancyId());
            case "requisition_get_interviewers":
                return getInterviewers(requestEntity, systemParams, requestValues.getVacancyId());
            case "requisition_interviewers_action":
                return getInterviewersActionResponse(requestEntity, systemParams, requestValues.getVacancyId(), requestValues.getInterviewers());
            case "requisition_post_vacancy_candidates":
                return getRequisitionPostVacancyCandidates(requestEntity, systemParams, requestValues);
            case "requisition_candidate_info":
                return getCandidateInfo(requestEntity, systemParams, requestValues.getVacancyId(), requestValues.getCandidateId());
            case "requisition_post_candidate_action":
                return getRequisitionPostCandidateAction(requestEntity, systemParams, requestValues);
            case "requisition_vacancy_statistic":
                return getRequisitionVacancyStatistic(requestEntity, systemParams, requestValues.getVacancyId());
            case "requisition_post_add_comment":
                return getRequisitionPostAddComment(requestEntity, systemParams, requestValues);
            case "requisition_candidate_resume":
                return getCandidateResume(requestEntity, systemParams, requestValues.getVacancyId(), requestValues.getCandidateId());
            default:
                throw new IllegalStateException("Unexpected requestType value: " + systemParams.getRequestType());
        }
    }

