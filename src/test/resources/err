    private SapSystemParamsDto setSystemParams(RequisitionRequestDto requestValues) {
        SapSystemParamsDto systemParams = new SapSystemParamsDto();
        systemParams.setRequestType(requestValues.getRequestType());
        systemParams.setAdLogin(requestValues.getAdLogin());
        systemParams.setChannel(requestValues.getChannel());
        systemParams.setSessionId(requestValues.getSessionId());
