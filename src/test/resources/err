@SpringBootConfiguration
@EnableAutoConfiguration
@Import({JwtSecurityConfiguration.class, NonSecurityConfig.class})
public class JwtFilterTestApplication {

    static final List<String> ATTRS = List.of(
            "adLogin", "sessionId", "channel", "adLoginWithoutDomain", "realm", "traceId", "sessionCreatedAt");

    @RestController
    static class EchoController {

        @GetMapping("/echo")
        Map<String, Object> echo(HttpServletRequest request) {
            Map<String, Object> result = new HashMap<>();
            for (String attr : ATTRS) {
                result.put(attr, String.valueOf(request.getAttribute(attr)));
            }
            return result;
        }

        // отдельный эндпоинт под проверку shouldNotFilter
        @GetMapping("/v3/api-docs")
        Map<String, Object> apiDocs(HttpServletRequest request) {
            return Map.of("adLogin", String.valueOf(request.getAttribute("adLogin")));
        }
    }
}

@Configuration
public class NonSecurityConfig {

    @Bean
    SecurityFilterChain filterChain(HttpSecurity http) throws Exception {
        http.csrf(AbstractHttpConfigurer::disable)
                .authorizeHttpRequests(auth -> auth.anyRequest().permitAll());
        return http.build();
    }
}


@Configuration
@EnableConfigurationProperties(JwtFilterProperties.class)
public class JwtSecurityConfiguration {

    @Bean
    @ConditionalOnMissingBean
    public CustomAuditLibTracingServiceImpl customAuditLibTracingService() {
        return new CustomAuditLibTracingServiceImpl();
    }

    @Bean
    @ConditionalOnMissingBean
    public JwtTokenFilter jwtTokenFilter(JwtFilterProperties props,
                                         EpaSdkService epaSdkService,
                                         AuditEventSenderCustom auditEventSender,
                                         CustomAuditLibTracingServiceImpl auditLibTracingService,
                                         ObjectMapper objectMapper) {
        return new JwtTokenFilter(props, epaSdkService, auditEventSender, auditLibTracingService, objectMapper);
    }

    @Bean
    @ConditionalOnMissingBean(name = "jwtTokenFilterRegistration")
    public FilterRegistrationBean<JwtTokenFilter> jwtTokenFilterRegistration(JwtTokenFilter filter) {
        FilterRegistrationBean<JwtTokenFilter> registration = new FilterRegistrationBean<>(filter);
        registration.setOrder(Ordered.HIGHEST_PRECEDENCE + 10);
        return registration;
    }
}
