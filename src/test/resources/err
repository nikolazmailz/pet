package ru.ntdev.srhr.common.integration;

import org.apache.hc.client5.http.impl.classic.CloseableHttpClient;
import org.apache.hc.client5.http.impl.classic.HttpClients;
import org.apache.hc.client5.http.impl.io.PoolingHttpClientConnectionManager;
import org.apache.hc.client5.http.impl.io.PoolingHttpClientConnectionManagerBuilder;
import org.springframework.boot.autoconfigure.AutoConfiguration;
import org.springframework.boot.autoconfigure.condition.ConditionalOnClass;
import org.springframework.boot.autoconfigure.condition.ConditionalOnMissingBean;
import org.springframework.boot.autoconfigure.web.client.RestTemplateAutoConfiguration;
import org.springframework.boot.web.client.RestTemplateBuilder;
import org.springframework.context.annotation.Bean;
import org.springframework.http.client.HttpComponentsClientHttpRequestFactory;
import org.springframework.web.client.RestTemplate;

@AutoConfiguration(after = RestTemplateAutoConfiguration.class)
@ConditionalOnClass({RestTemplate.class, CloseableHttpClient.class})
public class IntegrationRestTemplateAutoConfiguration {

    private static final int MAX_CONN_TOTAL = 100;
    private static final int MAX_CONN_PER_ROUTE = 20;

    @Bean(destroyMethod = "close")
    @ConditionalOnMissingBean(name = "integrationHttpClient")
    public CloseableHttpClient integrationHttpClient() {
        PoolingHttpClientConnectionManager cm = PoolingHttpClientConnectionManagerBuilder.create()
                .setMaxConnTotal(MAX_CONN_TOTAL)
                .setMaxConnPerRoute(MAX_CONN_PER_ROUTE)
                .build();

        return HttpClients.custom()
                .setConnectionManager(cm)
                .build();
    }

    /** Без логирования. */
    @Bean
    @ConditionalOnMissingBean(name = "integrationRestTemplate")
    public RestTemplate integrationRestTemplate(
            RestTemplateBuilder builder,
            CloseableHttpClient integrationHttpClient) {

        return builder
                .requestFactory(() -> new HttpComponentsClientHttpRequestFactory(integrationHttpClient))
                .build();
    }

    /** С логированием запросов/ответов. */
    @Bean
    @ConditionalOnMissingBean(name = "loggingIntegrationRestTemplate")
    public RestTemplate loggingIntegrationRestTemplate(
            RestTemplateBuilder builder,
            CloseableHttpClient integrationHttpClient) {

        return builder
                .requestFactory(() -> new HttpComponentsClientHttpRequestFactory(integrationHttpClient))
                .additionalInterceptors(new IntegrationRequestInterceptor())
                .build();
    }
}


@Configuration
public class JacksonConfig {

    @Bean
    public ObjectMapper objectMapper() {
        ObjectMapper mapper = new ObjectMapper();
        mapper.disable(SerializationFeature.WRITE_DATES_AS_TIMESTAMPS);
        return mapper;
    }
    
    //todo или если нужен JavaTimeModule()

    @Bean
    public ObjectMapper objectMapper() {
        ObjectMapper mapper = new ObjectMapper();
        mapper.registerModule(new JavaTimeModule());
        mapper.disable(SerializationFeature.WRITE_DATES_AS_TIMESTAMPS);
        return mapper;
    }
}

Кастомный Jackson-конвертер
если в сервисе локально есть @Bean MappingJackson2HttpMessageConverter
(через JacksonConfig с maxStringLength), autoconfig его подхватит через
ObjectProvider и добавит в шаблон;
если такого бина нет — шаблон работает на дефолтном Jackson.

@Configuration
public class JacksonConfig {

    @Bean
    Jackson2ObjectMapperBuilderCustomizer streamReadConstraintsCustomizer(
            @Value("${jackson.max-string-value}") int maxStringLength) {
        return builder -> builder.factory(
                JsonFactory.builder()
                        .streamReadConstraints(StreamReadConstraints.builder()
                                .maxStringLength(maxStringLength)
                                .build())
                        .build());
    }
}

@Bean
Jackson2ObjectMapperBuilderCustomizer jacksonCustomizer() {
    return builder -> builder
        .featuresToDisable(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES)
        .serializationInclusion(JsonInclude.Include.NON_NULL)
        .modulesToInstall(new JavaTimeModule())
        .mixIn(SomeThirdPartyDto.class, SomeMixin.class);
}


