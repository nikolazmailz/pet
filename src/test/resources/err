            Integer vacancyId,
            String guid,
            String number,
            String positionType,
            String staffPositionId,
            String staffPositionName,
            String structUnitId,
            String structUnitName,
            List<StructUnitPathNode> path
    ) {

    }

    public record StructUnitPathNode(String id, String typeDesc, String name) {
    }
