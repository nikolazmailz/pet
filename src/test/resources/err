    private void validateVacancy(RequisitionRequestEntity requestEntity, SapSystemParamsDto systemParams, String vacancyId) throws Exception {
        String requisitionGuid = entityService.findRequisitionGuidByVacancyId(vacancyId);
        if (requisitionGuid != null) {
            RequisitionEntity requisitionEntity = entityService.findRequisitionEntityByGuid(requisitionGuid);
            if (requisitionEntity != null) {
                String authorPernr = requisitionEntity.getAuthorPernr();
                String delegatorPernr = requisitionEntity.getDelegatorPernr();
                String pernr = systemParams.getTabNumber();

                validateUserStaffPosition(systemParams, requisitionEntity);

                Boolean pernrCheck = false;
                Boolean orgUnitCheck = false;
                if (pernr.equals(authorPernr) || pernr.equals(delegatorPernr)) {
                    pernrCheck = true;
                }

                RequisitionOrgUnitsAllowableDto cachedDto = getRequisitionOrgUnitsAllowableCachedDto(requestEntity, systemParams);

                orgUnitCheck = validateVacancyOrgunits(cachedDto, requisitionEntity.getStructUnitId());

                if (!pernrCheck && !orgUnitCheck) {
                    throw new HttpClientErrorException(HttpStatus.FORBIDDEN, "VACANCY_VALIDATION_FAILED");
                }
            }
        }
    }

