import ru.ntdev.srhr.ms.requisition.entity.RequisitionRequestEntity;
import ru.ntdev.srhr.ms.requisition.entity.projection.PendingCandidateEventRow;
import ru.ntdev.srhr.ms.requisition.entity.projection.PendingCandidateRow;
import ru.ntdev.srhr.ms.requisition.entity.projection.RequisitionEnrichmentRow;
import ru.ntdev.srhr.ms.requisition.entity.projection.StructUnitPathRow;
import ru.ntdev.srhr.ms.requisition.repository.PendingCandidateEntityRepository;
import ru.ntdev.srhr.ms.requisition.repository.VacancyRepository;
