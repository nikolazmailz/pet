    public String chooseHighestPriorityRole(List<ActorRoleDto> rolesList) {
        Map<Integer, String> rolePriority = new HashMap<>();
        for (ActorRoleDto role : rolesList) {
            String roleName = role.getRoleId();
            switch (roleName) {
                case RolesConstant.MSS_FULL:
                    rolePriority.put(400, roleName);
                    break;
                case RolesConstant.MSS_STANDARD:
                    rolePriority.put(300, roleName);
                    break;
                case RolesConstant.MSS_LIMITED:
                    rolePriority.put(200, roleName);
                    break;
                case RolesConstant.ESS:
                    rolePriority.put(100, roleName);
                    break;
            }
        }
        Optional<Map.Entry<Integer, String>> maxEntry = rolePriority.entrySet()
                .stream()
                .max(Map.Entry.comparingByKey());
        return maxEntry.get().getValue();
    }

