import java.util.stream.Collectors;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;
import ru.ntdev.srhr.common.contracts.easup.pendingcandidates.PendingCandidatesRequest;
import ru.ntdev.srhr.common.contracts.easup.pendingcandidates.PendingCandidatesResponse;
