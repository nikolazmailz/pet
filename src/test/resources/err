    @Test
    void execute_shouldReturnCorrectResponse_whenMultipleCandidatesAndEvents() throws Exception {
        RequisitionRequestEntity requestEntity = mock(RequisitionRequestEntity.class);
        RequisitionRequestDto requestValues = new RequisitionRequestDto();
        requestValues.setAdLogin(adLogin);
        requestValues.setSessionId(sessionId);
        requestValues.setTraceId(traceId);
        ObjectMapper objectMapper = new ObjectMapper();
        JsonNode jsonNode = objectMapper.readTree("""
                    {
                      "page": 1,
                      "size": 10,
                      "filter": {
                        "search": "Иванов",
                        "eventCodeList": ["HIRE", "INTERVIEW"]
                      }
                    }
                """);
        requestValues.setPayload(jsonNode);

        SapSystemParamsDto systemParams = mock(SapSystemParamsDto.class);

        BscsEmployeeDto bscsEmployeeDto = mock(BscsEmployeeDto.class);
        when(bscsEmployeeDto.getId()).thenReturn(pernr);
        when(bscsIntegrationService.getStaffByLogin(any(), any(), any()))
                .thenReturn(bscsEmployeeDto);

        when(masterDataIntegrationService.getPendingCandidates(any(), any()))
                .thenReturn(ResponseEntity.ok(definePendingCandidatesResponse()));


        FinishProcessingMessageDto out = pendingCandidatesUseCase.execute(requestEntity, systemParams, requestValues);

        System.out.println(out);
    }

