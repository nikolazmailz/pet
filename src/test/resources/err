   private ObjectMapper mapper;

    @Value("${spring.kafka.topic.name.to-easup}")
    String kafkaTopicNameToEasup;

    @PostConstruct
    public void initializeMapper() {
        mapper = jacksonConfig.objectMapper();
    }


@Configuration
public class JacksonConfig {

    @Value("${jackson.max-string-value}")
    Integer jacksonMaxStringValue;

    @Bean
    @Primary
    public ObjectMapper objectMapper() {
        return new ObjectMapper(
                new JsonFactoryBuilder()
                        .streamReadConstraints(
                                StreamReadConstraints.builder()
                                        .maxStringLength(jacksonMaxStringValue)
                                        .build()
                        ).build()
        );
    }

    public MappingJackson2HttpMessageConverter createCustomConverter(ObjectMapper objectMapper) {
        MappingJackson2HttpMessageConverter converter = new MappingJackson2HttpMessageConverter();
        converter.setObjectMapper(objectMapper);
        return converter;
    }
}
