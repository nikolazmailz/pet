@Entity
@Getter
@Setter
@ToString
@RequiredArgsConstructor
@Table(name = "vacancy")
public class VacancyEntity implements Serializable {

    @Id
    @SequenceGenerator(name="vacancy_id_seq",sequenceName="vacancy_id_seq",allocationSize=1)
    @GeneratedValue(strategy= GenerationType.SEQUENCE, generator="vacancy_id_seq")
    @Column(nullable = false, updatable = false)
    private Integer id;

    @OneToOne(targetEntity = DataIntegrationEntity.class,
            fetch = FetchType.LAZY)
    @JoinColumn(name = "integration_id")
    private DataIntegrationEntity integrationId;

    @Column(name = "requisition_guid", unique = true, nullable = false)
    private String guid;

    @Column(name = "vacancy_id")
    private String vacancyId;

@Query(value = """
            select v.vacancy_id   as "vacancyId",
                   r.guid          as "guid",
                   r.number        as "number",
                   r.position_type as "positionType",
                   r.staff_position_id   as "staffPositionId",
                   r.staff_position_name as "staffPositionName",
                   r.struct_unit_id      as "structUnitId",
                   r.struct_unit_name    as "structUnitName"
            from srhr_requisition.vacancy v
            join srhr_requisition.requisitions r on r.guid = v.requisition_guid
            where v.vacancy_id = any(:vacancyIds)
            """, nativeQuery = true)
    List<RequisitionEnrichmentRow> findEnrichmentByVacancyIds(String[] vacancyIds);
