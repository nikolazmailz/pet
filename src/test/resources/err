@Override
@Transactional
public void replaceForApprover(
        String approverPernr,
        PendingCandidatesResponse response
) {
    pendingCandidateEntityRepository.deleteAllByApproverPernr(approverPernr);
    pendingCandidateEntityRepository.flush();

    if (response == null
            || response.getData() == null
            || response.getData().getCandidates() == null) {
        return;
    }

    Set<Long> vacancyIds = response.getData().getCandidates().stream()
            .map(PendingCandidatesResponse.Candidate::getVacancyId)
            .collect(Collectors.toSet());

    Map<Long, Integer> internalVacancyIds = vacancyRepository
            .findAllByVacancyIdIn(vacancyIds)
            .stream()
            .collect(Collectors.toMap(
                    VacancyEntity::getVacancyId,
                    VacancyEntity::getId
            ));

    List<PendingCandidateEntity> entities =
            PendingCandidateEntity.toEntities(
                    approverPernr,
                    response,
                    internalVacancyIds
            );

    pendingCandidateEntityRepository.saveAll(entities);
}
