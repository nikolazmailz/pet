 @Test
    void shouldReturnOriginalMessageWhenSizeBelowLimit() throws Exception {
        var response = new RequisitionResponseEntity();
        response.setId(1);
        when(entityService.saveAndReturnResponse(any(), any(), any(), anyLong(), any()))
                .thenReturn(response);

        String result = processor.finishProcessingMessage(
                System.currentTimeMillis(), systemParams, dto, requestEntity, "201");

        // при размере ниже лимита filestorage не дёргается, возвращается сериализованный dto
        assertEquals(objectMapper.writeValueAsString(dto), result);
        verify(filestorageService, never()).putMessageToDb(any(), any(), any(), any(), any(), any());
    }

    @Test
    void shouldDeleteEntitiesWhenCodeIs200() throws Exception {
        var response = new RequisitionResponseEntity();
        response.setId(1);
        when(entityService.saveAndReturnResponse(any(), any(), any(), anyLong(), any()))
                .thenReturn(response);

        processor.finishProcessingMessage(
                System.currentTimeMillis(), systemParams, dto, requestEntity, "200");

        verify(entityService).deleteResponseByUidAndId("test-uuid", "1");
        verify(entityService).deleteRequestByUidAndId("test-uuid", "1");
    }
