package ru.ntdev.srhr.ms.requisition.application;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.ArgumentCaptor;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.http.HttpStatus;
import org.springframework.web.client.HttpClientErrorException;
import org.springframework.web.client.HttpServerErrorException;
import ru.ntdev.srhr.common.constant.RequestStatusConstant;
import ru.ntdev.srhr.common.dto.api.SapSystemParamsDto;
import ru.ntdev.srhr.common.dto.api.response.SapResponseDtoExtended;
import ru.ntdev.srhr.common.dto.api.response.requisition.RequisitionDictDto;
import ru.ntdev.srhr.ms.requisition.application.common.RequisitionResponseProcessor;
import ru.ntdev.srhr.ms.requisition.entity.RequisitionRequestEntity;
import ru.ntdev.srhr.ms.requisition.service.DatabaseService;
import ru.ntdev.srhr.ms.requisition.service.impl.EntityServiceImpl;
import ru.ntdev.srhr.ms.requisition.service.kafka.RequisitionContext;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertSame;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.anyLong;
import static org.mockito.ArgumentMatchers.anyString;
import static org.mockito.ArgumentMatchers.eq;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.never;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;

@ExtendWith(MockitoExtension.class)
class GetRequisitionDictUseCaseTest {

    @Mock
    private DatabaseService databaseService;

    @Mock
    private EntityServiceImpl entityService;

    @Mock
    private RequisitionResponseProcessor requisitionResponseProcessor;

    @InjectMocks
    private GetRequisitionDictUseCase useCase;

    private SapSystemParamsDto systemParams;
    private RequisitionRequestEntity requestEntity;
    private RequisitionContext context;

    @BeforeEach
    void setUp() {
        systemParams = new SapSystemParamsDto();
        systemParams.setUuid("test-uuid");
        systemParams.setAdLogin("adlogin");
        systemParams.setSessionId("session-id");
        systemParams.setChannel("channel");

        requestEntity = new RequisitionRequestEntity();
        requestEntity.setId(1);

        context = mock(RequisitionContext.class);
        when(context.requestEntity()).thenReturn(requestEntity);
        when(context.systemParams()).thenReturn(systemParams);
    }

    @Test
    void execute_returnsProcessedMessage_whenDbSucceeds() throws Exception {
        RequisitionDictDto dbDto = new RequisitionDictDto();
        when(databaseService.getRequisitionDict()).thenReturn(dbDto);
        when(requisitionResponseProcessor.finishProcessingMessage(anyLong(), any(), any(), any(), anyString()))
                .thenReturn("processed");

        String result = useCase.execute(context);

        assertEquals("processed", result);

        ArgumentCaptor<SapResponseDtoExtended> dtoCaptor = ArgumentCaptor.forClass(SapResponseDtoExtended.class);
        ArgumentCaptor<String> codeCaptor = ArgumentCaptor.forClass(String.class);
        verify(requisitionResponseProcessor).finishProcessingMessage(
                anyLong(), eq(systemParams), dtoCaptor.capture(), eq(requestEntity), codeCaptor.capture());

        assertEquals("200", codeCaptor.getValue());
        assertSame(dbDto, dtoCaptor.getValue());          // в happy path идёт dto из БД, а не преднастроенный
        assertEquals("200", dbDto.getResponseCode());
        verify(entityService, never()).updateRequestStatus(any(), any());
    }

    @Test
    void execute_handlesHttpClientError() throws Exception {
        HttpClientErrorException ex = new HttpClientErrorException(HttpStatus.NOT_FOUND);
        when(databaseService.getRequisitionDict()).thenThrow(ex);
        when(requisitionResponseProcessor.finishProcessingMessage(anyLong(), any(), any(), any(), anyString()))
                .thenReturn("error-processed");

        String result = useCase.execute(context);

        assertEquals("error-processed", result);

        ArgumentCaptor<SapResponseDtoExtended> dtoCaptor = ArgumentCaptor.forClass(SapResponseDtoExtended.class);
        ArgumentCaptor<String> codeCaptor = ArgumentCaptor.forClass(String.class);
        verify(requisitionResponseProcessor).finishProcessingMessage(
                anyLong(), eq(systemParams), dtoCaptor.capture(), eq(requestEntity), codeCaptor.capture());

        assertEquals(HttpStatus.NOT_FOUND.toString(), codeCaptor.getValue());
        SapResponseDtoExtended dto = dtoCaptor.getValue();
        assertEquals(HttpStatus.NOT_FOUND.toString(), dto.getResponseCode());
        assertEquals(ex.getMessage(), dto.getErrorMessage());
        verify(entityService).updateRequestStatus("test-uuid", RequestStatusConstant.ERROR_REPLY);
    }

    @Test
    void execute_handlesHttpServerError() throws Exception {
        HttpServerErrorException ex = new HttpServerErrorException(HttpStatus.INTERNAL_SERVER_ERROR);
        when(databaseService.getRequisitionDict()).thenThrow(ex);
        when(requisitionResponseProcessor.finishProcessingMessage(anyLong(), any(), any(), any(), anyString()))
                .thenReturn("error-processed");

        useCase.execute(context);

        ArgumentCaptor<String> codeCaptor = ArgumentCaptor.forClass(String.class);
        verify(requisitionResponseProcessor).finishProcessingMessage(
                anyLong(), eq(systemParams), any(), eq(requestEntity), codeCaptor.capture());

        assertEquals(HttpStatus.INTERNAL_SERVER_ERROR.toString(), codeCaptor.getValue());
        verify(entityService).updateRequestStatus("test-uuid", RequestStatusConstant.ERROR_REPLY);
    }

    @Test
    void execute_handlesGenericException() throws Exception {
        when(databaseService.getRequisitionDict()).thenThrow(new IllegalStateException("boom"));
        when(requisitionResponseProcessor.finishProcessingMessage(anyLong(), any(), any(), any(), anyString()))
                .thenReturn("error-processed");

        useCase.execute(context);

        ArgumentCaptor<SapResponseDtoExtended> dtoCaptor = ArgumentCaptor.forClass(SapResponseDtoExtended.class);
        ArgumentCaptor<String> codeCaptor = ArgumentCaptor.forClass(String.class);
        verify(requisitionResponseProcessor).finishProcessingMessage(
                anyLong(), eq(systemParams), dtoCaptor.capture(), eq(requestEntity), codeCaptor.capture());

        // code = "500" (хардкод), а responseCode внутри dto = "500 INTERNAL_SERVER_ERROR" — рассинхрон, см. ниже
        assertEquals("500", codeCaptor.getValue());
        assertEquals(HttpStatus.INTERNAL_SERVER_ERROR.toString(), dtoCaptor.getValue().getResponseCode());
        assertEquals("boom", dtoCaptor.getValue().getErrorMessage());
        verify(entityService).updateRequestStatus("test-uuid", RequestStatusConstant.ERROR_REPLY);
    }

    @Test
    void execute_wrapsCheckedExceptionInRuntimeException_whenProcessorThrows() throws Exception {
        when(databaseService.getRequisitionDict()).thenReturn(new RequisitionDictDto());
        Exception checked = new Exception("processing failed");
        when(requisitionResponseProcessor.finishProcessingMessage(anyLong(), any(), any(), any(), anyString()))
                .thenThrow(checked);

        RuntimeException ex = assertThrows(RuntimeException.class, () -> useCase.execute(context));

        assertSame(checked, ex.getCause());
    }
}
