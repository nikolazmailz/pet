    private boolean validateDelegations(RequisitionRequestEntity requestEntity, SapSystemParamsDto systemParams, String delegatorTn) throws Exception {
        String key = "delegations:" + systemParams.getChannel() + ":" + systemParams.getAdLogin();

        RequisitionDelegationsCachedDto cachedDto = redisAdapter
                .getObjectFromDb(key, RequisitionDelegationsCachedDto.class);

        if (cachedDto == null) {
            log.info("Кэш по делегатам для логина [{}] пуст, делается запрос в еасуп", systemParams.getAdLogin());
            RequisitionRequestEntity newRequestEntity = saveAndGetEntity(requestEntity.getUid(), requestEntity.getFunctionalRole(), requestEntity.getUid(),
                    requestEntity.getRequestBody(), requestEntity.getTabNumber(), requestEntity.getStatus());
            getRequisitionDelegations(newRequestEntity, systemParams);
            cachedDto = redisAdapter.getObjectFromDb(key, RequisitionDelegationsCachedDto.class);
            if (cachedDto == null) {
                throw new HttpClientErrorException(HttpStatus.FORBIDDEN, "DELEGATION_VALIDATION_FAILED_NOT_FOUND_DELEGATIONS_IN_CACHE");
            }
        }
        // Проверка на наличие делегирования в целом
        if (cachedDto.getDelegations().isEmpty()) {
            throw new HttpClientErrorException(HttpStatus.FORBIDDEN, "DELEGATION_VALIDATION_FAILED_NOT_FOUND_DELEGATIONS_BY_ADLOGIN");
        }
        List<RequisitionDelegationsItem> cachedDelegations = cachedDto.getDelegations();

        // Проверка что есть совпадающий таб.номер делегата с таб.номером в кэше делегирования и его срок не истек
        for (RequisitionDelegationsItem delegationsItem : cachedDelegations) {
            if (delegationsItem.getEmployee() != null && delegationsItem.getEmployee().getId().equals(delegatorTn)) {
                return validateDelegationDate(delegationsItem);
            }
        }
        // Кидаем ошибку, что не найден совпадающий делегат
        throw new HttpClientErrorException(HttpStatus.FORBIDDEN, "DELEGATION_VALIDATION_FAILED_NOT_FOUND_MATCHING_DELEGATOR_TN");
    }

    // todo
    private boolean validateDelegationDate(RequisitionDelegationsItem delegationsItem) {
        if (delegationsItem.getEndDate() != null && delegationsItem.getStartDate() != null) {
            // 0 - означает бессрочное делегирование, в таком случае дату не проверяем
            if (delegationsItem.getEndDate() == 0) {
                return true;
            }
            // совпадение startDate и endDate - это однодневное делегирование (если создали сегодня то в 00:00 оно станет невалидным)
            if (delegationsItem.getEndDate().equals(delegationsItem.getStartDate())) {
                long oneDayDelegationExpireDate = LocalDate.now().plusDays(1)
                        .atStartOfDay(ZoneOffset.UTC)
                        .toInstant()
                        .toEpochMilli();

                if (delegationsItem.getEndDate() < oneDayDelegationExpireDate) {
                    return true;
                } else {
                    throw new HttpClientErrorException(HttpStatus.FORBIDDEN, "DELEGATION_VALIDATION_FAILED_END_DATE_EXPIRED");
                }
            } else {
                LocalDate endDate = Instant.ofEpochMilli(delegationsItem.getEndDate())
                        .atZone(ZoneOffset.UTC)
                        .toLocalDate();
                LocalDate currentDate = LocalDate.now();
                if (currentDate.isBefore(endDate) || currentDate.equals(endDate)) {
                    return true;
                } else {
                    throw new HttpClientErrorException(HttpStatus.FORBIDDEN, "DELEGATION_VALIDATION_FAILED_END_DATE_EXPIRED");
                }
            }
        } else {
            throw new HttpClientErrorException(HttpStatus.FORBIDDEN, "DELEGATION_VALIDATION_FAILED_END_OR_START_DATE_NULL");
        }
    }

