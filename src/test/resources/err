        assertThat(page.count()).isEqualTo(4); // Все кандидаты, включая дубль

        assertThat(page.candidates())
                .extracting(PendingCandidateView::fullName)
                .containsExactlyInAnyOrder("John Doe", "Jane Smith", "Bob Johnson");

        // Проверяем, что Bob Johnson присутствует дважды с разными vacancy_id
        List<PendingCandidateView> bobCandidates = page.candidates().stream()
                .filter(c -> c.fullName().equals("Bob Johnson"))
                .toList();

        assertThat(bobCandidates).hasSize(2);
        assertThat(bobCandidates.get(0).vacancyId()).isEqualTo("7643745243748976137");
        assertThat(bobCandidates.get(1).vacancyId()).isEqualTo("7643745243748976138");

        // Убеждаемся, что в БД сохранены все 3 кандидата
        assertThat(pendingCandidateEntityRepository.count()).isEqualTo(3);

        assertThat(out.getCode()).isEqualTo("200");
    }

