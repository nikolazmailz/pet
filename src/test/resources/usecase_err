import static org.assertj.core.api.Assertions.assertThat;
import static org.mockito.Mockito.*;

public class CpiUserinfoUseCaseIT extends BaseIntegrationTest {

    @Autowired
    private CpiUserinfoUseCase cpiUserinfoUseCase;
    @Autowired
    private EntityService entityService;

    private PreparedRequest<CPIRequestDto, ConsentPersonInfoRequestEntity> preparedRequest;
    private SapSystemParamsDto systemParams;
    private CPIRequestDto cpiRequestDto;
    private ConsentPersonInfoRequestEntity requestEntity;

    @BeforeEach
    void setUp() {
        WireMock.resetAllRequests();

        systemParams = new SapSystemParamsDto();
        systemParams.setAdLogin("testLogin");
        systemParams.setSessionId("testSession");
        systemParams.setChannel("testChannel");
        systemParams.setTabNumber("vtb0010101");
        systemParams.setUuid(UUID.randomUUID().toString());

        cpiRequestDto = new CPIRequestDto();
        cpiRequestDto.setEmployeeId("12345");
        cpiRequestDto.setExpand("expand");

        requestEntity = new ConsentPersonInfoRequestEntity();
        requestEntity.setUid(UUID.randomUUID().toString());
        requestEntity.setCreatedAt(LocalDateTime.now());

        preparedRequest = new PreparedRequest<>(cpiRequestDto, systemParams, requestEntity);
    }

    @Test
    void execute_SuccessfulResponse_ReturnsPreparedResponseWithDtoAndStatusUpdated() {
        // when
        var result = cpiUserinfoUseCase.execute(preparedRequest);

        // then
        assertThat(result).isNotNull();
        assertThat(result.code()).isEqualTo("200");

        assertThat(((CPIUserinfoDto) result.payload()).getId()).isEqualTo("152285");

        verify(entityService).updateRequestStatus(any(), any());
    }
}



