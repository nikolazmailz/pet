import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.EqualsAndHashCode;
import lombok.NoArgsConstructor;
import lombok.experimental.SuperBuilder;
import ru.ntdev.srhr.common.dto.api.request.SapRequestDto;

@Data
@NoArgsConstructor
@SuperBuilder
@EqualsAndHashCode(callSuper = true)
@AllArgsConstructor
public class ResponseEnvelope<T> extends SapRequestDto {
    private T payload;

    public static <T> ResponseEnvelope<T> success(
            T payload
    ) {
        return new ResponseEnvelope<>(
                payload
        );
    }

    public static <T> ResponseEnvelope<T> error(
            String correlationId,
            String requestType,
            String responseCode,
            String errorMessage
    ) {
        return ResponseEnvelope.<T>builder()
                .uuid()
                .build();
        
    }
}

@Data
@AllArgsConstructor
@NoArgsConstructor
@SuperBuilder
public class SapRequestDto {
    private String uuid;
    private String responseCode;
    private String errorMessage;
    private String requestType;
    private String adLogin;
    private String sessionId;
    private String channel;
    private String traceId;
    private String realm;
    private String fileUuid;
}
