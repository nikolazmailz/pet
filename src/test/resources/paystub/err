
public class ActorStageInMemoryStorage {
    private static final Logger log = LoggerFactory.getLogger(ActorStageInMemoryStorage.class);
    private final Map<AclibActorKey, AclibActorStageDto> storage = new ConcurrentHashMap();
    private final Map<String, Set<AclibActorKey>> subjectStorage = new ConcurrentHashMap();

    public ActorStageInMemoryStorage() {
    }

    public Map<AclibActorKey, AclibActorStageDto> getStorage() {
        return Collections.unmodifiableMap(this.storage);
    }

    void init(ActorStageInMemoryStorage newStorage) {
        log.debug("[IM] [Init] Storage before init: size = {}", this.storage.size());
        this.storage.clear();
        this.storage.putAll(newStorage.storage);
        this.subjectStorage.clear();
        this.subjectStorage.putAll(newStorage.subjectStorage);
        log.debug("[IM] [Init] Storage after init: size = {}", this.storage.size());
    }

    void syncUserStage(String instanceCode, String subjectCode, AclibUserStageDto userStageDto, String tag) {
        if (subjectCode != null && userStageDto != null) {
            String upperSubjectCode = subjectCode.toUpperCase();
            this.subjectStorage.putIfAbsent(upperSubjectCode, new HashSet());
            Set<AclibActorKey> actorKeysInStorage = (Set)this.subjectStorage.get(upperSubjectCode);
            if (actorKeysInStorage == null) {
                log.debug("[IM] [{}] Add new ActorKey Set with key: subjectCode = {}", tag, subjectCode);
            } else {
                if (userStageDto.getActorStages() != null) {
                    userStageDto.getActorStages().forEach((p) -> {
                        this.upsert(p, actorKeysInStorage, tag);
                    });
                    log.debug("[IM] [{}] Upsert actor stage into in-memory storage: {}", tag, userStageDto);
                }

                this.revokeAssignments(instanceCode, userStageDto, actorKeysInStorage, tag);
            }
        } else {
            log.warn("[IM] [{}] Subject or stage is null subjectCode = {}, userStageDto = {}", new Object[]{tag, subjectCode, userStageDto});
        }
    }

    private void upsert(AclibActorStageDto aclibActorStageDto, Set<AclibActorKey> actorKeysInStorage, String tag) {
        if (aclibActorStageDto != null) {
            AclibActorKey aclibActorKeyDto = new AclibActorKey(aclibActorStageDto.getActor().getInstanceCode(), aclibActorStageDto.getActor().getUid(), aclibActorStageDto.getActor().getChannel());
            this.innerUpsert(aclibActorKeyDto, aclibActorStageDto, tag);
            actorKeysInStorage.add(aclibActorKeyDto);
            log.debug("[IM] [{}] Upsert storage with key = {}, new size = {}", new Object[]{tag, aclibActorKeyDto, this.storage.size()});
        }

    }

    private void innerUpsert(AclibActorKey aclibActorKeyDto, AclibActorStageDto aclibActorStageDto, String tag) {
        if (this.storage.containsKey(aclibActorKeyDto)) {
            log.info("[IM] [{}] Actor re-wrote to the storage, key: {}", tag, aclibActorKeyDto);
        } else {
            log.info("[IM] [{}] Actor put to the storage, key: {}", tag, aclibActorKeyDto);
        }

        this.storage.put(aclibActorKeyDto, aclibActorStageDto);
    }

    private void revokeAssignments(String instanceCode, AclibUserStageDto userStageDto, Set<AclibActorKey> actorKeysInStorage, String tag) {
        Set<AclibActorKey> newActorKeys = this.getUserStageKeys(userStageDto);
        actorKeysInStorage.forEach((aclibActorKey) -> {
            if (instanceCode.equalsIgnoreCase(aclibActorKey.getInstanceCode()) && !newActorKeys.contains(aclibActorKey)) {
                log.debug("[IM] [{}] Actor with key: {} removed from storage", aclibActorKey, tag);
                this.putUnassignmentActor(aclibActorKey);
            }

        });
    }

    private Set<AclibActorKey> getUserStageKeys(AclibUserStageDto userStageDto) {
        return (Set)(userStageDto.getActorStages() == null ? new HashSet() : (Set)userStageDto.getActorStages().stream().map((aclibActorStageDto) -> {
            return new AclibActorKey(aclibActorStageDto.getActor().getInstanceCode(), aclibActorStageDto.getActor().getUid(), aclibActorStageDto.getActor().getChannel());
        }).collect(Collectors.toSet()));
    }

    private void putUnassignmentActor(AclibActorKey aclibActorKey) {
        AclibActorStageDto aclibActorStageDto = (AclibActorStageDto)this.storage.get(aclibActorKey);
        if (aclibActorStageDto != null) {
            this.storage.put(aclibActorKey, new AclibActorStageDto(new AclibActorDto(aclibActorStageDto.getActor().getInstanceCode(), aclibActorStageDto.getActor().getUid(), aclibActorStageDto.getActor().getChannel(), aclibActorStageDto.getActor().getInfoSystemCode(), aclibActorStageDto.getActor().getInfoSystemId(), aclibActorStageDto.getActor().getSubjectCode(), aclibActorStageDto.getActor().getRequestId(), aclibActorStageDto.getActor().getRequestAt(), aclibActorStageDto.getActor().getTrId(), new HashMap()), new ArrayList()));
        } else {
            log.warn("Actor with key: {} not found in storage", aclibActorKey);
        }

    }

    public static boolean isSkipAssignmentsSyncRegistry(String instanceCode, AclibAssignmentsSyncRegistryDto assignmentsDto) {
        return assignmentsDto == null || assignmentsDto.getSubjectCode() == null || assignmentsDto.getSubjectCode().isEmpty() || assignmentsDto.getInstanceCode() == null || assignmentsDto.getInstanceCode().isEmpty() || !assignmentsDto.getInstanceCode().equalsIgnoreCase(instanceCode);
    }
}
