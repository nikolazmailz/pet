package ru.ntdev.srhr.ms.paystub.service.impl;

import com.fasterxml.jackson.databind.JsonNode;
import lombok.AllArgsConstructor;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;
import ru.ntdev.srhr.common.context.RequestContext;
import ru.ntdev.srhr.common.context.RequestContextHolder;
import ru.ntdev.srhr.common.dto.SapSystemParamsDto;
import ru.ntdev.srhr.common.dto.api.response.filestorage.MessageGetByIdDto;
import ru.ntdev.srhr.common.filestorage.FileStorage;
import ru.ntdev.srhr.common.reqreply.dto.RequestEnvelope;
import ru.ntdev.srhr.common.reqreply.exception.ProcessingException;
import ru.ntdev.srhr.common.reqreply.reply.PreparedRequest;
import ru.ntdev.srhr.common.reqreply.reply.RequestEnvelopeDeserializer;
import ru.ntdev.srhr.common.util.LogUtil;
import ru.ntdev.srhr.ms.paystub.entity.PaystubRequestEntity;
import ru.ntdev.srhr.ms.paystub.application.exception.PreparationException;
import ru.ntdev.srhr.ms.paystub.service.EntityService;

@Service
@Slf4j
@RequiredArgsConstructor
public class PreparedRequestService {

    public static final String STATUS_SENT = "SENT";
    private final FileStorage fileStorage;
    private final EnrichEntityService enrichEntityService;
    private final RequestEnvelopeDeserializer requestEnvelopeDeserializer;
    private final EntityService entityService;

    @Value("${spring.kafka.topic.name.to-easup}")
    String kafkaTopicNameToEasup;

    public PreparedRequest<JsonNode, ?> prepare(String originalMessage) throws Exception {
        long startedAt = System.currentTimeMillis();
        RequestEnvelope<JsonNode> requestEnvelope = requestEnvelopeDeserializer.deserialize(originalMessage, JsonNode.class);
        SapSystemParamsDto systemParamsDto = null;
        PaystubRequestEntity paystubRequestEntity = null;
        try {
            RequestEnvelope<JsonNode> restored = restoreFromFileStorageIfNeeded(requestEnvelope);
            systemParamsDto = createSystemParams(restored);

            RequestContextHolder.set(
                    new RequestContext(
                            systemParamsDto.getAdLogin(),
                            systemParamsDto.getSessionId(),
                            systemParamsDto.getChannel()
                    )
            );

            logIncomingMessage(systemParamsDto);
            paystubRequestEntity = entityService.saveAndReturnRequest(systemParamsDto.getUuid(), null, systemParamsDto.getSessionId(), originalMessage, null, STATUS_SENT);
            enrichEntityService.enrichRoles(systemParamsDto, paystubRequestEntity);
            enrichEntityService.enrichTabNumber(systemParamsDto, paystubRequestEntity);
            return new PreparedRequest<>(restored, systemParamsDto, paystubRequestEntity, startedAt);
        } catch (Exception e) {
            String code = e instanceof ProcessingException pe ? pe.getCode() : "500";
            throw new PreparationException(code, e.getMessage(), e, paystubRequestEntity, systemParamsDto, startedAt);
        }
    }

    private RequestEnvelope<JsonNode> restoreFromFileStorageIfNeeded(
            RequestEnvelope<JsonNode> envelope
    ) throws Exception {

        if (envelope.getFileUuid() == null || envelope.getFileUuid().isBlank()) {
            return envelope;
        }

        String storedMessage = getOutStoredMessage(
                envelope.getAdLogin(),
                envelope.getSessionId(),
                envelope.getTraceId(),
                envelope.getFileUuid()
        );

        return requestEnvelopeDeserializer.deserialize(storedMessage, JsonNode.class);
    }

    private SapSystemParamsDto createSystemParams(RequestEnvelope<?> r) {
        SapSystemParamsDto systemParams = new SapSystemParamsDto();
        systemParams.setRequestType(r.getRequestType());
        systemParams.setAdLogin(r.getAdLogin());
        systemParams.setChannel(r.getChannel());
        systemParams.setSessionId(r.getSessionId());
        systemParams.setTraceId(r.getTraceId());
        systemParams.setUuid(r.getUuid());
        systemParams.setRealm(r.getRealm());
        return systemParams;
    }

    private void logIncomingMessage(
            SapSystemParamsDto systemParams
    ) {
        LogUtil.logKafkaMessageGot(
                systemParams.getAdLogin(),
                systemParams.getSessionId(),
                systemParams.getRequestType(),
                kafkaTopicNameToEasup,
                systemParams.getTraceId()
        );
    }

    private String getOutStoredMessage(String adlogin, String sessionId, String traceId, String id) {
        MessageGetByIdDto messageGetByIdDto = fileStorage.getMessageById(adlogin, sessionId, traceId, id);
        return messageGetByIdDto.getMessageContent();
    }
}


package ru.ntdev.srhr.ms.paystub;

import jakarta.persistence.EntityManager;
import java.util.Map;
import org.apache.kafka.clients.consumer.Consumer;
import org.apache.kafka.clients.consumer.ConsumerConfig;
import org.apache.kafka.common.serialization.StringDeserializer;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.boot.testcontainers.service.connection.ServiceConnection;
import org.springframework.kafka.core.DefaultKafkaConsumerFactory;
import org.springframework.kafka.core.KafkaTemplate;
import org.springframework.kafka.test.utils.KafkaTestUtils;
import org.springframework.test.context.ActiveProfiles;
import org.springframework.test.context.DynamicPropertyRegistry;
import org.springframework.test.context.DynamicPropertySource;
import org.springframework.transaction.support.TransactionTemplate;
import org.testcontainers.containers.KafkaContainer;
import org.testcontainers.containers.PostgreSQLContainer;
import org.testcontainers.junit.jupiter.Container;
import org.testcontainers.junit.jupiter.Testcontainers;
import org.testcontainers.utility.DockerImageName;
import ru.ntdev.srhr.ms.paystub.kafka.task.ConsumerAssignmentTask;
import ru.ntdev.srhr.ms.paystub.kafka.task.ConsumerCreatorTask;

@ActiveProfiles("test")
@SpringBootTest(properties = {
        "app.request-reply.enabled=true",
        "spring.kafka.ssl.enabled=false",
        "spring.kafka.topic.name.to-easup=srhr.paystub.to.easup",
})
@Testcontainers
public abstract class BaseIntegrationTest {

    protected static final String TO_EASUP = "srhr.paystub.to.easup";
    protected static final String FROM_EASUP = "srhr.paystub.from.easup";

    @ServiceConnection
    static PostgreSQLContainer<?> postgres =
            new PostgreSQLContainer<>("postgres:16-alpine")
                    .withInitScript("db/init-schema.sql");

    static {
        postgres.start();
    }

    @Container
    protected static final KafkaContainer KAFKA =
            new KafkaContainer(
                    DockerImageName.parse("confluentinc/cp-kafka:7.5.0")
            );

    @DynamicPropertySource
    static void kafkaProperties(DynamicPropertyRegistry registry) {
        registry.add("spring.kafka.bootstrap-servers", KAFKA::getBootstrapServers);
        registry.add("spring.kafka.topic.name.to-easup", () -> TO_EASUP);
        registry.add("spring.kafka.topic.name.from-easup", () -> FROM_EASUP);
        registry.add("spring.kafka.task.partition.number", () -> 1);
    }

    @Autowired
    protected KafkaTemplate<Long, String> kafkaTemplate;

    @Autowired
    protected ConsumerCreatorTask consumerCreatorTask;

    @Autowired
    protected ConsumerAssignmentTask consumerAssignmentTask;

    @Autowired
    protected EntityManager em;

    @Autowired
    protected TransactionTemplate transactionTemplate;

    protected Consumer<String, String> createResponseConsumer() {
        Map<String, Object> props =
                KafkaTestUtils.consumerProps(
                        KAFKA.getBootstrapServers(),
                        "paystub-consumer",
                        "true"
                );
        props.put(ConsumerConfig.AUTO_OFFSET_RESET_CONFIG, "earliest");

        return new DefaultKafkaConsumerFactory<>(
                props,
                new StringDeserializer(),
                new StringDeserializer()
        ).createConsumer();
    }
}
