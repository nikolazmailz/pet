import org.springframework.stereotype.Component;
import ru.ntdev.srhr.common.context.RequestContextHolder;
import ru.ntdev.srhr.common.dto.api.response.SapResponseDto;
import ru.ntdev.srhr.common.util.LogUtil;
import ru.ntdev.srhr.common.util.StringUtil;
import ru.ntdev.srhr.ms.paystub.kafka.service.consumer.KafkaConsumerServiceImpl;
import ru.ntdev.srhr.ms.paystub.kafka.service.producer.KafkaProducerServiceImpl;
import ru.ntdev.srhr.ms.paystub.service.KafkaTaskService;

import java.util.List;
import java.util.Map;

@Component
@RequiredArgsConstructor
@Slf4j
public class ConsumerAssignmentTask {
    private final KafkaConsumerServiceImpl kafkaConsumerService;
    private final KafkaProducerServiceImpl kafkaProducerService;
    private final KafkaTaskService kafkaPaystubTaskService;
    @Value("${spring.kafka.task.partition.number}")
    Integer kafkaConsumerNumber;
    @Value("${spring.kafka.topic.name.from-easup}")
    String kafkaTopicNameFromEasup;
    @Scheduled(fixedDelay = 100, initialDelay = 10000)
    @Async(value = "ProducerExecutor")
    public void assignKafkaMessages() {
        Consumer<String,String> consumer = kafkaConsumerService.getFreeConsumer();
        if (consumer != null) {
            String consumerId = consumer.groupMetadata().groupInstanceId().get();
            try {
                List<String> records =
                        kafkaConsumerService.pollObjects(consumerId);
                if (!records.isEmpty()) {
                    kafkaConsumerService.commit(consumerId);
                    kafkaConsumerService.returnFreeConsumer(consumer);
                    for (String request : records )
                        try {
                            String message = kafkaPaystubTaskService.processMessage(request);
                            Map<String, String> requestValues = StringUtil.convertStringToMap(request);
                            if (message != null) {
                                kafkaProducerService.produce(kafkaTopicNameFromEasup, message);
                                LogUtil.logKafkaMessageSent(requestValues.get("adLogin"), requestValues.get("sessionId"), requestValues.get("requestType"), kafkaTopicNameFromEasup, requestValues.get("traceId"));
                            } else {
                                message = "Было возвращено пустое сообщение.";
                                kafkaProducerService.produce(kafkaTopicNameFromEasup, message);
                                LogUtil.logKafkaMessageSent(requestValues.get("adLogin"), requestValues.get("sessionId"), requestValues.get("requestType"), kafkaTopicNameFromEasup, requestValues.get("traceId"));
                            }
                        } catch (Exception e) {
                            log.warn("Произошла ошибка в работе таски [assignKafkaMessages] сервиса [paystub]: {} "+e.getMessage());
                            ObjectMapper mapper = new ObjectMapper();
                            Map<String, String> requestValues = StringUtil.convertStringToMap(request);
                            String uuid = requestValues.get("uuid");
                            String requestType = requestValues.get("requestType");
                            String sessionId = requestValues.get("sessionId");
                            String adLogin = requestValues.get("adLogin");
                            String traceId = requestValues.get("traceId");
                            SapResponseDto errorResponse = new SapResponseDto();
                            errorResponse.setUuid(uuid);
                            errorResponse.setRequestType(requestType);
                            errorResponse.setAdLogin(adLogin);
                            errorResponse.setSessionId(sessionId);
                            errorResponse.setTraceId(traceId);
                            errorResponse.setResponseCode("500");
                            errorResponse.setErrorMessage("Произошла ошибка в работе таски assignKafkaMessages сервиса paystub: "+e.getMessage());
                            String errorMessage = mapper.writeValueAsString(errorResponse);
                            kafkaProducerService.produce(kafkaTopicNameFromEasup, errorMessage);
                            LogUtil.logKafkaMessageSent(requestValues.get("adlogin"), requestValues.get("sessionId"), requestValues.get("requestType"), kafkaTopicNameFromEasup, requestValues.get("traceId"));
                        } finally {
                            RequestContextHolder.clear();
                        }
                } else {
                    kafkaConsumerService.returnFreeConsumer(consumer);
                }
            } catch (Exception e) {
                log.error(e.getMessage());
                kafkaConsumerService.rollback(consumerId);
                kafkaConsumerService.returnFreeConsumer(consumer);
            }
        }
    }
}



