package ru.ntdev.srhr.ms.paystub.kafka.service.consumer;

import lombok.extern.slf4j.Slf4j;
import org.apache.kafka.clients.consumer.Consumer;
import org.apache.kafka.clients.consumer.ConsumerConfig;
import org.apache.kafka.clients.consumer.ConsumerRecord;
import org.apache.kafka.clients.consumer.ConsumerRecords;
import org.apache.kafka.common.serialization.StringDeserializer;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.kafka.core.ConsumerFactory;
import org.springframework.kafka.core.DefaultKafkaConsumerFactory;
import org.springframework.stereotype.Service;
import org.springframework.util.DigestUtils;

import java.time.Duration;
import java.util.*;
import java.util.regex.Pattern;

@Service
@Slf4j
public class KafkaConsumerServiceImpl implements KafkaConsumerService {

    private Map<String , Consumer<String, String>> consumerMap;
    private List<Consumer<String, String>> consumerAccessList;
    private Map<String , ConsumerFactory<String, String>> consumerFactoryMap;

    public KafkaConsumerServiceImpl()
    {
        this.consumerMap = new HashMap<>();
        this.consumerAccessList = new ArrayList<>();
        this.consumerFactoryMap = new HashMap<>();
        this.kafkaConsumerGroupId = kafkaConsumerGroupId;
        this.bootstrapServers = bootstrapServers;
    }

    @Value("${spring.kafka.consumer.group-id}")
    private String kafkaConsumerGroupId;
    @Value("${spring.kafka.bootstrap-servers}")
    private String bootstrapServers;
    @Value("${spring.kafka.ssl.key-store-location}")
    private String sslKeystoreLocation;
    @Value("${spring.kafka.ssl.key-store-password}")
    private String sslKeystorePassword;
    @Value("${spring.kafka.ssl.trust-store-location}")
    private String sslTruststoreLocation;
    @Value("${spring.kafka.ssl.trust-store-password}")
    private String sslTruststorePassword;
    @Value("${spring.kafka.ssl.key-password}")
    private String sslKeyPassword;
    @Value("${spring.kafka.ssl.trust-store-type}")
    private String sslTruststoreType;
    @Value("${spring.kafka.ssl.key-store-type}")
    private String sslKeystoreType;
    @Value("${spring.kafka.ssl.enabled}")
    boolean sslEnabled;

    private ConsumerFactory<String, String> getConsumerFactory(String clientId, String instanceId, Integer pollLimit) {

        String _paramsStr = clientId.concat(instanceId).concat(pollLimit.toString());
        String _hashKey = DigestUtils.md5DigestAsHex(_paramsStr.getBytes()).toUpperCase();

        if(consumerFactoryMap.containsKey(_hashKey)){
            return consumerFactoryMap.get(_hashKey);
        }else{
            Map<String, Object> props = new HashMap<>();
            props.put(ConsumerConfig.BOOTSTRAP_SERVERS_CONFIG,bootstrapServers);
            props.put(ConsumerConfig.GROUP_ID_CONFIG,kafkaConsumerGroupId);
            props.put(ConsumerConfig.KEY_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class);
            props.put(ConsumerConfig.VALUE_DESERIALIZER_CLASS_CONFIG,StringDeserializer.class);
            props.put(ConsumerConfig.AUTO_OFFSET_RESET_CONFIG,"earliest");
            props.put(ConsumerConfig.MAX_POLL_RECORDS_CONFIG,pollLimit);
            props.put(ConsumerConfig.ENABLE_AUTO_COMMIT_CONFIG, false);
            props.put(ConsumerConfig.CLIENT_ID_CONFIG,clientId);
            props.put(ConsumerConfig.GROUP_INSTANCE_ID_CONFIG,instanceId);
            if(sslEnabled) {
                props.put("security.protocol", "SSL");
                props.put("ssl.keystore.location", sslKeystoreLocation);
                props.put("ssl.keystore.password", sslKeystorePassword);
                props.put("ssl.truststore.location", sslTruststoreLocation);
                props.put("ssl.truststore.password", sslTruststorePassword);
                props.put("ssl.key.password", sslKeyPassword);
                props.put("ssl.keystore.type", sslKeystoreType);
                props.put("ssl.truststore.type", sslTruststoreType);
            }
            ConsumerFactory<String, String> _factory = new DefaultKafkaConsumerFactory<>(props);
            consumerFactoryMap.put(_hashKey,_factory);
            return  _factory;
        }
    }

    @Override
    public void createConsumer(String consumerId, String topic, Integer pollLimit) throws Exception {
            Consumer<String, String> _consumer = null;
            String newConsumerId = consumerId+"_"+ UUID.randomUUID();
            if (consumerId.contains("pt")) {
                _consumer = getConsumerFactory(newConsumerId, newConsumerId, pollLimit).createConsumer();
            }
            if(_consumer != null) {
                consumerMap.put(newConsumerId, _consumer);
                consumerMap.get(newConsumerId).subscribe(Pattern.compile(topic));
                consumerAccessList.add(_consumer);
            }
    }

    @Override
    public boolean isConsumerExists(String consumerId) {
        if(consumerMap.containsKey(consumerId) && consumerMap.get(consumerId) != null) {
            return true;
        }
        return false;
    }

    public Integer isEnoughConsumers(Integer partitionCount) {
        return partitionCount - consumerMap.size();
    }

    public synchronized Consumer<String, String> getFreeConsumer(){
        if(!consumerAccessList.isEmpty()) {
            Consumer<String, String> _consumer = consumerAccessList.get(0);
            consumerAccessList.remove(_consumer);
            return _consumer;
        }
        return null;
    }

    public synchronized void returnFreeConsumer(Consumer<String, String> _consumer) {
        consumerAccessList.add(_consumer);
    }

    @Override
    public List<String> pollObjects(String consumerId) {

        List<String> _resultList = new ArrayList<>();

        if(consumerMap.containsKey(consumerId) && consumerMap.get(consumerId) != null) {
            ConsumerRecords<String, String> _records = consumerMap.get(consumerId).poll(Duration.ofSeconds(1));
            for (ConsumerRecord<String, String> record : _records) {
                _resultList.add(record.value());
            }
        }
        return _resultList;
    }

    @Override
    public void commit(String consumerId) {
        if(consumerMap.containsKey(consumerId) && consumerMap.get(consumerId) != null){
            consumerMap.get(consumerId).commitAsync();
        }
    }

    @Override
    public void rollback(String consumerId) {
        if(consumerMap.containsKey(consumerId) && consumerMap.get(consumerId) != null){
            close(consumerId);
        }
    }

    @Override
    public void close(String consumerId){
        if(consumerMap.containsKey(consumerId) && consumerMap.get(consumerId) != null) {
            consumerMap.get(consumerId).close(Duration.ofSeconds(1));
            var consumer = consumerMap.get(consumerId);
            consumer = null;
            consumerMap.remove(consumerId);
        }
    };
}



