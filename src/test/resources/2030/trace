@Configuration(proxyBeanMethods = false)
public class RequestContextConfiguration {

    @Bean
    public FilterRegistrationBean<RequestContextFilter> requestContextFilter(
            OpenTelemetryTraceContextProvider traceProvider) {
        FilterRegistrationBean<RequestContextFilter> registration =
                new FilterRegistrationBean<>(new RequestContextFilter(traceProvider));
        registration.setOrder(Ordered.HIGHEST_PRECEDENCE + 11);
        return registration;
    }
}


public final class RequestContextHolder {

    private static final ThreadLocal<RequestContext> CONTEXT = new ThreadLocal<>();

    // ... get(), getOrNull() как были

    public static ContextScope open(RequestContext ctx) {
        RequestContext previous = CONTEXT.get();
        CONTEXT.set(ctx);
        putMdc(ctx);
        return () -> {
            if (previous != null) {
                CONTEXT.set(previous);
            } else {
                CONTEXT.remove();
            }
            clearMdc();
        };
    }

    public interface ContextScope extends AutoCloseable {
        @Override
        void close(); // без checked-исключения
    }
}

@KafkaListener(topics = "${topics.requisition-from-easup}")
public void onMessage(CandidateStatusEvent event) {
    try (var ignored = RequestContextHolder.open(toContext(event))) {
        handler.process(event);
    }
}

private RequestContext toContext(CandidateStatusEvent event) {
    return new RequestContext(
            event.getInitiatorLogin(), null,
            event.getSessionId(), event.getChannel(),
            null, traceProvider.getActiveSpanTraceId(), null);
}


public class ContextAwareAuditFieldsResolver implements AuditListFieldsResolver {

    @Override
    public List<AuditField> resolve(/* сигнатура вашей версии либы */) {
        List<AuditField> fields = new ArrayList<>();

        // прикладные поля из аргументов метода — как в вашем RequestParamsAuditResolver

        RequestContext ctx = RequestContextHolder.getOrNull();
        if (ctx != null) {
            addIfPresent(fields, "adLogin", ctx.adLogin());
            addIfPresent(fields, "sessionId", ctx.sessionId());
            addIfPresent(fields, "channel", ctx.channel());
            addIfPresent(fields, "traceId", ctx.traceId());
        }
        return fields;
    }

    private static void addIfPresent(List<AuditField> fields, String name, String value) {
        if (value != null) {
            fields.add(new AuditField(name, value));
        }
    }
}
