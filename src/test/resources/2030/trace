@Service
@Primary
@Slf4j
public class CustomAuditLibTracingServiceImpl implements AuditLibTracingService {

  private static final OneAgentSDK sdk = createInstance();

  @Override
  public String getActiveSpanTraceId() {
    return sdk.getTraceContextInfo().getTraceId();
  }

  @Override
  public String getActiveSpanId() {
    return sdk.getTraceContextInfo().getSpanId();
  }


}
