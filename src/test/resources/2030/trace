package ru.ntdev.srhr.ms.requisition.rest.controller;


import com.fasterxml.jackson.databind.ObjectMapper;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.mock.mockito.MockBean;
import org.springframework.http.MediaType;
import org.springframework.test.web.servlet.MockMvc;
import ru.ntdev.srhr.common.dto.SapSystemParamsDto;
import ru.ntdev.srhr.common.dto.api.response.requisition.RequisitionDictDto;
import ru.ntdev.srhr.ms.requisition.rest.BaseIntegrationTest;
import ru.ntdev.srhr.ms.requisition.rest.dto.RequisitionDictDtoOut;
import ru.ntdev.srhr.ms.requisition.rest.mapper.RequisitionDtoMapper;
import ru.ntdev.srhr.ms.requisition.rest.service.RequisitionService;

import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

public class RequisitionControllerIntegrationTest extends BaseIntegrationTest {

    @MockBean
    private RequisitionService requisitionService;

    @MockBean
    private RequisitionDtoMapper requisitionDtoMapper;

    @Autowired
    private ObjectMapper objectMapper;

    @Test
    public void shouldReturn200AndDictWhenServiceReturnsValidResponse() throws Exception {
        // Given
        RequisitionDictDto mockResponse = new RequisitionDictDto();
        mockResponse.setResponseCode("200");
        mockResponse.setErrorMessage(null);
        mockResponse.setTraceId("trace-123");

        when(requisitionService.getRequisitionDict(any(SapSystemParamsDto.class))).thenReturn(mockResponse);
        when(requisitionDtoMapper.cleanNulls(any(RequisitionDictDtoOut.class))).thenAnswer(invocation -> invocation.getArgument(0));

        // When & Then
        mockMvc.perform(get("/dict")
                        .contentType(MediaType.APPLICATION_JSON)
                        .requestAttr("channel", "WEB")
                        .requestAttr("adLogin", "testuser")
                        .requestAttr("sessionId", "session123")
                        .requestAttr("realm", "REALM"))
                .andExpect(status().isOk())
                .andExpect(content().contentType(MediaType.APPLICATION_JSON));
    }
}



@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
@ActiveProfiles("test")
@AutoConfigureMockMvc(addFilters = false)
public abstract class BaseIntegrationTest {

    @Autowired
    protected MockMvc mockMvc;

    /**
     * Отключаем реальный JWT-фильтр, чтобы он не тянул EPA/AAL.
     */
    @MockBean
    protected JwtTokenFilter jwtTokenFilter;

    /**
     * Отключаем EPA SDK, чтобы не создавался aal/JWKS provider.
     */
    @MockBean
    protected EpaSdkServiceImpl epaSdkService;

    @MockBean
    protected EpaSdkTechServiceImpl epaSdkTechService;

    @MockBean
    protected AuthenticationAuthorizationLibrary authenticationAuthorizationLibrary;
}




