audit-group-resolver:
  srhr: SrhrAuditResolver


group-resolvers: general, web, srhr



@Service
@Order(50)
public class SrhrAuditResolver implements AuditFieldResolver {

    @Override
    public Object get(
            String eventCode,
            AudLibEventClass eventClass,
            AuditMethodParams params,
            Map<String, Object> currentFields,
            Map<String, Object> contextOperation
    ) {
        return params.getParams().get("candidateId");
    }

    @Override
    public String getFieldName() {
        return "object_id";
    }
}


@Component
public class AuditParamsResolver implements AuditListFieldsResolver {

    @Override
    public Map<String, Object> getFields(
            String eventCode,
            AudLibEventClass eventClass,
            AuditMethodParams methodParams,
            Map<String, Object> currentFields,
            Map<String, Object> contextOperation
    ) {
        Map<String, Object> params = methodParams.getParams();

        if (params == null || params.isEmpty()) {
            return Map.of();
        }

        String description = params.entrySet().stream()
                .filter(entry -> entry.getValue() != null)
                .map(entry -> entry.getKey() + "=" + entry.getValue())
                .collect(Collectors.joining(", "));

        return Map.of("oper_description", description);
    }
}


