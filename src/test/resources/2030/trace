audit:
  kafka:
    bootstrap-servers: ${AUDIT_KAFKA_BOOTSTRAP_SERVERS}
    topic: ${AUDIT_KAFKA_TOPIC:audit-v2}

    security:
      protocol: ${AUDIT_SECURITY_PROTOCOL:SSL}

    ssl:
      key-store-location: ${AUDIT_KEY_STORE}
      key-store-type: ${AUDIT_KEY_STORE_TYPE:JKS}
      key-store-password: ${AUDIT_KEY_STORE_PASSWORD}
      key-password: ${AUDIT_KEY_PASSWORD}

      trust-store-location: ${AUDIT_TRUST_STORE}
      trust-store-type: ${AUDIT_TRUST_STORE_TYPE:JKS}
      trust-store-password: ${AUDIT_TRUST_STORE_PASSWORD}


audit:
  standin-kafka:
    enabled: ${AUDIT_STANDIN_KAFKA_ENABLED:false}
    bootstrap-servers: ${AUDIT_STANDIN_KAFKA_BOOTSTRAP_SERVERS}

    security:
      protocol: ${AUDIT_STANDIN_SECURITY_PROTOCOL:SSL}

    ssl:
      key-store-location: ${AUDIT_STANDIN_KEY_STORE}
      key-store-type: ${AUDIT_STANDIN_KEY_STORE_TYPE:JKS}
      key-store-password: ${AUDIT_STANDIN_KEY_STORE_PASSWORD}
      key-password: ${AUDIT_STANDIN_KEY_PASSWORD}

      trust-store-location: ${AUDIT_STANDIN_TRUST_STORE}
      trust-store-type: ${AUDIT_STANDIN_TRUST_STORE_TYPE:JKS}
      trust-store-password: ${AUDIT_STANDIN_TRUST_STORE_PASSWORD}
