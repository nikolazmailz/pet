databaseChangeLog:
  - changeSet:
      id: 2026-07-27-13-45-create-pending-candidates-events
      author: n-pushkaryov
      changes:
        - createTable:
            tableName: pending_candidates_events
            remarks: События по кандидатам в ожидании
            columns:
              - column:
                  name: id
                  type: integer
                  autoIncrement: true
                  constraints:
                    primaryKey: true
                    nullable: false
              - column:
                  name: pending_candidate_id
                  type: bigint
                  constraints:
                    nullable: false
                    foreignKeyName: fk_pending_candidates_events_candidate
                    references: pending_candidates(id)
                    onDelete: cascade
              - column:
                  name: event_code
                  type: varchar(64)
                  constraints:
                    nullable: false
              - column:
                  name: status_date
                  type: timestamptz
                  constraints:
                    nullable: false
              - column:
                  name: days
                  type: integer
                  constraints:
                    nullable: true
              - column:
                  name: expiration_zone
                  type: integer
                  constraints:
                    nullable: true
        - createIndex:
            tableName: pending_candidates_events
            indexName: idx_pending_candidates_events_candidate_id
            columns:
              - column:
                  name: pending_candidate_id
        - createIndex:
            tableName: pending_candidates_events
            indexName: idx_pending_candidates_events_event_code
            columns:
              - column:
                  name: event_code
