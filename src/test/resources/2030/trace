server:
  port : 8104
app:
  name: '@project.name@'
  version: '@project.version@'
  code: ${SRHR_SERVICE_CODE:059}
  scheduler:
    enabled: true
    core-pool-size: ${TASK_SCHEDULER_CORE_POOL_SIZE:5}
    max-pool-size: ${TASK_SCHEDULER_MAX_POOL_SIZE:10}
    queue-capacity: ${TASK_SCHEDULER_QUEUE_CAPACITY:500}
jackson:
  max-string-value: ${JACKSON_MAX_STRING_VALUE_LIMIT:999999999}
springdoc:
  swagger-ui:
    enabled: true
    path: /swagger
  writer-with-default-pretty-printer : true
management:
  metrics:
    distribution:
      percentiles-histogram:
        all: true
  endpoints:
    enabled-by-default: false
    web:
      exposure:
        include: prometheus, health
  endpoint:
    health.enabled: true
    prometheus.enabled: true
jwt:
  default:
    sub: ${SRHR_JWT_DEFAULT_SUB:DEFAULT}
  disable: ${SRHR_JWT_DISABLE:true}
  antireplay:
    enable: ${SRHR_ANTIREPLAY_ENABLE:true}
    url: ${SRHR_JWT_ANTIREPLAY_URL:https://certauth.cryptomix.com/json/}
  certificate:
    path: ${SRHR_JWT_CERTIFICATE_PATH:}
    password: ${SRHR_JWT_CERTIFICATE_PASSWORD:}
  keys:
    url: ${SRHR_JWT_KEYS_URL:https://localhost/passport/oauth2/jwks}
  local:
    sub: ${SRHR_JWT_LOCAL_SUB:VTBXXXX1}
    sessionId: ${SRHR_JWT_LOCAL_SESSION_ID:test}
    channel: ${SRHR_LOCAL_CHANNEL:public}
    sub-with-domain: ${SRHR_JWT_LOCAL_SUB:VTBXXXX1@test.vtb.ru}
    client-ip: ${SRHR_JWT_LOCAL_CLIENT_IP:192.168.1.1}
    realm: ${SRHR_JWT_LOCAL_REALM:/staff}
feign:
  circuitbreaker:
    enabled: true
spring:
  profiles:
    active: local
  application:
    name: ${app.name}
  main:
    allow-bean-definition-overriding: false
  mvc:
    pathmatch:
      matching-strategy: ANT_PATH_MATCHER
  output:
    ansi:
      enabled: ALWAYS
  kafka:
    consumer:
      group-id: ${KAFKA_CONSUMER_GROUP_ID:requisition_rest_consumer}
      auto-offset-reset: ${KAFKA_CONSUMER_AUTO_OFFSET_RESET:earliest}
      partition-assignment: ${KAFKA_CONSUMER_PARTITION_ASSIGNMENT:org.apache.kafka.clients.consumer.RoundRobinAssignor}
      fetch-max-bytes: ${KAFKA_CONSUMER_FETCH_MAX_BYTES:10048576}
    bootstrap-servers: ${KAFKA_BOOTSTRAP_SERVERS:localhost:9092}
    producer:
      client-id: ${KAFKA_PRODUCER_CLIENT_ID:requisition_rest_client}
      enable-idempotence: ${KAFKA_PRODUCER_ENABLE_IDEMPOTENCE:true}
      max-in-flight-requests: ${KAFKA_PRODUCER_MAX_IN_FLIGHT_REQUESTS:5}
      acks: ${KAFKA_PRODUCER_ACKS:all}
      max-request-size: ${KAFKA_PRODUCER_MAX_REQUEST_SIZE:10048576}
      max-inner-message-size-kb: ${KAFKA_PRODUCER_MAX_INNER_MESSAGE_SIZE_KB:1000}
    timeout-limit: ${KAFKA_TIMEOUT_LIMIT:300}
    ssl:
      enabled: ${KAFKA_SSL_ENABLED:false}
      key-store-location: ${KAFKA_KEY_STORE:/path/to/store}
      key-store-password: ${KAFKA_KEY_STORE_PASSWORD:password}
      trust-store-location: ${KAFKA_TRUST_STORE:/path/to/store}
      trust-store-password: ${KAFKA_TRUST_STORE_PASSWORD:password}
      key-password: ${KAFKA_KEY_PASSWORD:password}
      trust-store-type: ${KAFKA_TRUST_STORE_TYPE:password}
      key-store-type: ${KAFKA_KEY_STORE_TYPE:password}
    listener:
      partition:
        number: ${KAFKA_LISTENER_PARTITION_NUMBER:4}
      id: ${KAFKA_LISTENER_ID:requisition_rest_listener}
      group-id: ${KAFKA_LISTENER_GROUP_ID:requisition_rest_listener}
    topic:
      name:
        to-easup: ${KAFKA_TOPIC_NAME_TO_EASUP:srhr.requisition.to.easup}
        from-easup: ${KAFKA_TOPIC_NAME_FROM_EASUP:srhr.requisition.from.easup}
  data:
    redis:
      database: ${REDIS_DATABASE:0}
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:12000}
      enabled: ${REDIS_ENABLED:true}
      username: ${REDIS_USERNAME:}
      password: ${REDIS_PASSWORD:}
      timeout: ${REDIS_TIMEOUT:60s}
      sentinel:
        master: ${REDIS_SENTINEL_MASTER:}
        nodes: ${REDIS_SENTINEL_NODES:}
        password: ${REDIS_SENTINEL_PASSWORD:}
      queue:
        name: ${REDIS_QUEUE_NAME:RequisitionRequestQueue}
  udp-sender:
    host: ${OPENTRACING_UDP_SENDER_HOST:localhost}

  config:
    import:
      - classpath:application-audit-2-events.yml

ru:
  vtb:
    tstr:
      kafka:
        ssl:
          keyPassword: ${JAEGER_KAFKA_KEYSTORE_PASSWORD:}
          keystorePassword: ${JAEGER_KAFKA_KEYSTORE_PASSWORD:}
          truststoreLocation: file:/${JAEGER_KAFKA_TRUSTSTORE_LOCATION:truststore.jks}
          keystoreLocation: file:/${JAEGER_KAFKA_KEYSTORE_LOCATION:keystore.jks}
          truststorePassword: ${JAEGER_KAFKA_TRUSTSTORE_PASSWORD:}
        bootstrap-servers: ${JAEGER_KAFKA_BOOTSTRAP_SERVERS:localhost}
# необходимо указать код системы (не подсистемы!), значения по-умолчанию нет
ms.properties.infoSystemCode: srhr
# необходимо указать id системы, значения по-умолчанию нет
ms.properties.infoSystemId: "2020"

ms:
  properties:
    info-system-code: srhr
    info-system-id: "2020"
    app-name: ${spring.application.name}

audit-group-resolver:
  srhr-resolver: SrhrAuditResolver

audit:
  enabled: ${AUDIT_ENABLE:true}

  # Добавлять сообщение исключения в oper_description
  fill-error: ${AUDIT_FILL_ERROR:true}

  # Системный инициатор для scheduler/Kafka/batch
  default-resolver:
    sub: ${AUDIT_DEFAULT_SUB:${spring.application.name}}
    channel: ${AUDIT_DEFAULT_CHANNEL:SYSTEM}

  deployment-context:
    pod-name-environment: AUDITOMNI_POD_NAME
    pod-namespace-environment: AUDITOMNI_POD_NAMESPACE

  kafka:
    bootstrap-servers: ${AUDIT_KAFKA_BOOTSTRAP_SERVERS:localhost:39091}
    topic: ${AUDIT_KAFKA_TOPIC:audit-v2}

    security:
      protocol: ${AUDIT_SECURITY_PROTOCOL:PLAINTEXT}

  standin-period-min: ${AUDIT_STANDIN_PERIOD_MIN:5}
  standin-try-count-to-switch: ${AUDIT_STANDIN_TRY_COUNT_TO_SWITCH:2}

  standin-kafka:
    enabled: ${AUDIT_STANDIN_KAFKA_ENABLED:false}
    bootstrap-servers: ${AUDIT_STANDIN_KAFKA_BOOTSTRAP_SERVERS:localhost:49091}

    security:
      protocol: ${AUDIT_STANDIN_SECURITY_PROTOCOL:PLAINTEXT}

