package ru.ntdev.srhr.common.context;

import java.time.LocalDateTime;

public record RequestContext(
        String adLogin,
        String adLoginWithoutDomain,
        String sessionId,
        String channel,
        String realm,
        String traceId,
        LocalDateTime sessionCreatedAt
) {
}


package ru.ntdev.srhr.common.context;

public final class RequestContextHolder {

    private static final ThreadLocal<RequestContext> CONTEXT = new ThreadLocal<>();

    private RequestContextHolder() {
    }

    public static RequestContext get() {
        RequestContext ctx = CONTEXT.get();
        if (ctx == null) {
            throw new IllegalStateException(
                    "RequestContext не инициализирован: запрос не прошёл через RequestContextFilter");
        }
        return ctx;
    }

    public static RequestContext getOrNull() {
        return CONTEXT.get();
    }

    static void set(RequestContext ctx) {
        CONTEXT.set(ctx);
    }

    static void clear() {
        CONTEXT.remove();
    }
}


package ru.ntdev.srhr.common.context;

import jakarta.servlet.FilterChain;
import jakarta.servlet.ServletException;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import org.slf4j.MDC;
import org.springframework.web.filter.OncePerRequestFilter;

import java.io.IOException;
import java.time.LocalDateTime;

public class RequestContextFilter extends OncePerRequestFilter {

    @Override
    protected void doFilterInternal(HttpServletRequest request,
                                    HttpServletResponse response,
                                    FilterChain chain) throws ServletException, IOException {
        RequestContext ctx = new RequestContext(
                attr(request, "adLogin"),
                attr(request, "adLoginWithoutDomain"),
                attr(request, "sessionId"),
                attr(request, "channel"),
                attr(request, "realm"),
                attr(request, "traceId"),
                (LocalDateTime) request.getAttribute("sessionCreatedAt")
        );
        RequestContextHolder.set(ctx);
        putMdc(ctx);
        try {
            chain.doFilter(request, response);
        } finally {
            RequestContextHolder.clear();
            MDC.remove("traceId");
            MDC.remove("sessionId");
            MDC.remove("adLogin");
        }
    }

    private static String attr(HttpServletRequest request, String name) {
        return (String) request.getAttribute(name);
    }

    private static void putMdc(RequestContext ctx) {
        if (ctx.traceId() != null) MDC.put("traceId", ctx.traceId());
        if (ctx.sessionId() != null) MDC.put("sessionId", ctx.sessionId());
        if (ctx.adLogin() != null) MDC.put("adLogin", ctx.adLogin());
    }
}


package ru.ntdev.srhr.common.context;

import org.springframework.boot.web.servlet.FilterRegistrationBean;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.core.Ordered;

@Configuration(proxyBeanMethods = false)
public class RequestContextConfiguration {

    @Bean
    public FilterRegistrationBean<RequestContextFilter> requestContextFilter() {
        FilterRegistrationBean<RequestContextFilter> registration =
                new FilterRegistrationBean<>(new RequestContextFilter());
        registration.setOrder(Ordered.HIGHEST_PRECEDENCE + 11);
        return registration;
    }
}


