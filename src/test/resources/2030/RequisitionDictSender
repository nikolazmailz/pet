
@Slf4j
@Service
public class RequisitionDictSender implements AuditSender {

    private static final String REQUEST_TYPE = "requisition_delegations";
    private static final String SRHR_REQUISITION_NOT_FOUND_GET_DICT = "SRHR_REQUISITION_NOT_FOUND_GET_DICT";
    private static final String SRHR_REQUISITION_FORBIDDEN_GET_DICT = "SRHR_REQUISITION_FORBIDDEN_GET_DICT";
    private static final String SRHR_REQUISITION_UNEXPECTED_ERROR_GET_DICT = "SRHR_REQUISITION_UNEXPECTED_ERROR_GET_DICT";

    @Audit(SRHR_REQUISITION_NOT_FOUND_GET_DICT)
    @Override
    public void sendNotFoundEvent(
            @AuditParam(value = SESSION_ID) String sessionId,
            @AuditParam(value = SESSION_CREATED_AT) LocalDateTime sessionCreatedAt
    ) {
        log.debug("Отправка события: " + SRHR_REQUISITION_NOT_FOUND_GET_DICT);
    }

    @Audit(SRHR_REQUISITION_FORBIDDEN_GET_DICT)
    @Override
    public void sendForbiddenEvent(
            @AuditParam(value = SESSION_ID) String sessionId,
            @AuditParam(value = SESSION_CREATED_AT) LocalDateTime sessionCreatedAt
    ) {
        log.debug("Отправка события: " + SRHR_REQUISITION_FORBIDDEN_GET_DICT);
    }

    @Audit(SRHR_REQUISITION_UNEXPECTED_ERROR_GET_DICT)
    @Override
    public void sendUnexpectedErrorEvent(
            @AuditParam(value = SESSION_ID) String sessionId,
            @AuditParam(value = SESSION_CREATED_AT) LocalDateTime sessionCreatedAt
    ) {
        log.debug("Отправка события: " + SRHR_REQUISITION_UNEXPECTED_ERROR_GET_DICT);
    }

    @Override
    public boolean supports(String requestType) {
        return REQUEST_TYPE.equals(requestType);
    }

    @Override
    public String eventNotFoundCode() {
        return SRHR_REQUISITION_NOT_FOUND_GET_DICT;
    }

    @Override
    public String eventForbiddenCode() {
        return SRHR_REQUISITION_FORBIDDEN_GET_DICT;
    }

    @Override
    public String eventErrorCode() {
        return SRHR_REQUISITION_UNEXPECTED_ERROR_GET_DICT;
    }
}
