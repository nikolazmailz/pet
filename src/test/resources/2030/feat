public interface AuditSender {

    String SESSION_ID = "sessionId";
    String SESSION_CREATED_AT = "sessionCreatedAt";

    void sendNotFoundEvent(
            String sessionId,
            LocalDateTime createdAt
    );

    void sendForbiddenEvent(
            String sessionId,
            LocalDateTime createdAt
    );

    void sendUnexpectedErrorEvent(
            String sessionId,
            LocalDateTime createdAt
    );

    boolean supports(String requestType);

    String eventNotFoundCode();

    String eventForbiddenCode();

    String eventErrorCode();
}


@Configuration
@ComponentScan(basePackageClasses = AuditSenderResolver.class)
public class AuditSenderConfig {
}


public class AuditSenderResolver {

    private final List<AuditSender> senders;

    public AuditSenderResolver(List<AuditSender> senders) {
        this.senders = senders;
    }

    public AuditSender resolve(String requestType) {
        return senders.stream()
                .filter(sender -> sender.supports(requestType))
                .findFirst()
                .orElseThrow(() -> new IllegalArgumentException(
                        "Не найден AuditSender для requestType: " + requestType));
    }
}


@Target(ElementType.TYPE)
@Retention(RetentionPolicy.RUNTIME)
@Documented
@Import(AuditSenderConfig.class)
public @interface EnabledAuditSenders {
}



@SuppressWarnings({"ALL", "MultipleTopLevelClassesInFile"})
@Slf4j
@Service
public class RequisitionPendingCandidatesSender implements AuditSender {

    private static final String REQUEST_TYPE = RequisitionRequestType.PENDING_CANDIDATES.getValue();
    private static final String NOT_FOUND_CODE = "SRHR_REQUISITION_PENDING_CANDIDATES_NOT_FOUND";
    private static final String FORBIDDEN_CODE = "SRHR_REQUISITION_PENDING_CANDIDATES_FORBIDDEN";
    private static final String UNEXPECTED_ERROR_CODE = "SRHR_REQUISITION_PENDING_CANDIDATES_UNEXPECTED_ERROR";

    @Audit(NOT_FOUND_CODE)
    @Override
    public void sendNotFoundEvent(
            @AuditParam(value = SESSION_ID) String sessionId,
            @AuditParam(value = SESSION_CREATED_AT) LocalDateTime sessionCreatedAt
    ) {
        log.debug("Отправка события: {}", NOT_FOUND_CODE);
    }

    @Audit(FORBIDDEN_CODE)
    @Override
    public void sendForbiddenEvent(
            @AuditParam(value = SESSION_ID) String sessionId,
            @AuditParam(value = SESSION_CREATED_AT) LocalDateTime sessionCreatedAt
    ) {
        log.debug("Отправка события: {}", FORBIDDEN_CODE);
    }

    @Audit(UNEXPECTED_ERROR_CODE)
    @Override
    public void sendUnexpectedErrorEvent(
            @AuditParam(value = SESSION_ID) String sessionId,
            @AuditParam(value = SESSION_CREATED_AT) LocalDateTime sessionCreatedAt
    ) {
        log.debug("Отправка события: {}", UNEXPECTED_ERROR_CODE);
    }

    @Override
    public boolean supports(String requestType) {
        return REQUEST_TYPE.equals(requestType);
    }

    @Override
    public String eventNotFoundCode() {
        return NOT_FOUND_CODE;
    }

    @Override
    public String eventForbiddenCode() {
        return FORBIDDEN_CODE;
    }

    @Override
    public String eventErrorCode() {
        return UNEXPECTED_ERROR_CODE;
    }
}
