package ru.ntdev.srhr.common.jwt.config;

import com.fasterxml.jackson.databind.ObjectMapper;
import org.springframework.boot.autoconfigure.condition.ConditionalOnMissingBean;
import org.springframework.boot.context.properties.EnableConfigurationProperties;
import org.springframework.boot.web.servlet.FilterRegistrationBean;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.core.Ordered;
import ru.ntdev.srhr.common.audit.service.AuditEventSenderCustom;
import ru.ntdev.srhr.common.epa.EpaSdkService;
import ru.ntdev.srhr.common.jwt.OpenTelemetryTraceContextProvider;
import ru.ntdev.srhr.common.jwt.filter.JwtTokenFilter;

@Configuration
@EnableConfigurationProperties(JwtFilterProperties.class)
public class JwtSecurityConfiguration {

//    @Bean
//    @ConditionalOnMissingBean
//    public CustomAuditLibTracingServiceImpl customAuditLibTracingService() {
//        return new CustomAuditLibTracingServiceImpl();
//    }

    @Bean
    @ConditionalOnMissingBean
    public JwtTokenFilter jwtTokenFilter(JwtFilterProperties props,
                                         EpaSdkService epaSdkService,
                                         AuditEventSenderCustom auditEventSender,
                                         OpenTelemetryTraceContextProvider openTelemetryTraceContextProvider,
                                         ObjectMapper objectMapper) {
        return new JwtTokenFilter(props, epaSdkService, auditEventSender, openTelemetryTraceContextProvider, objectMapper);
    }

    @Bean
    @ConditionalOnMissingBean(name = "jwtTokenFilterRegistration")
    public FilterRegistrationBean<JwtTokenFilter> jwtTokenFilterRegistration(JwtTokenFilter filter) {
        FilterRegistrationBean<JwtTokenFilter> registration = new FilterRegistrationBean<>(filter);
        registration.setOrder(Ordered.HIGHEST_PRECEDENCE + 10);
        return registration;
    }

    @Bean
    @ConditionalOnMissingBean
    public OpenTelemetryTraceContextProvider openTelemetryTraceContextProvider() {
        return new OpenTelemetryTraceContextProvider();
    }
}

package ru.ntdev.srhr.common.jwt.filter;

import com.fasterxml.jackson.databind.ObjectMapper;
import jakarta.servlet.FilterChain;
import jakarta.servlet.ServletException;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.slf4j.MDC;
import org.springframework.web.filter.OncePerRequestFilter;
import ru.ntdev.srhr.common.audit.RequestContext;
import ru.ntdev.srhr.common.audit.service.AuditEventSenderCustom;
import ru.ntdev.srhr.common.dto.api.error.ErrorResponse;
import ru.ntdev.srhr.common.dto.api.error.ServiceError;
import ru.ntdev.srhr.common.dto.api.error.ServiceErrorDto;
import ru.ntdev.srhr.common.jwt.OpenTelemetryTraceContextProvider;
import ru.ntdev.srhr.common.jwt.dto.AllowedChannels;
import ru.ntdev.srhr.common.epa.EpaSdkService;
import ru.ntdev.srhr.common.jwt.JWTUtil;
import ru.ntdev.srhr.common.jwt.config.JwtFilterProperties;
import ru.vtb.epa.service.EpaValidationResult;
import ru.vtb.epa.sso.aal.validation.jwt.ValidationResult;
import ru.ntdev.srhr.common.audit.RequestContextHolder;

import java.io.IOException;
import java.time.LocalDateTime;
import java.util.ArrayList;

@Slf4j
@RequiredArgsConstructor
public class JwtTokenFilter extends OncePerRequestFilter {

    private static final String AUTH_TOKEN_HEADER_NAME = "Authorization";
    private static final String BEARER = "Bearer";

    private static final String ATTR_SESSION_CREATED_AT = "sessionCreatedAt";
    private static final String ATTR_AD_LOGIN = "adLogin";
    private static final String ATTR_SESSION_ID = "sessionId";
    private static final String ATTR_CHANNEL = "channel";
    private static final String ATTR_AD_LOGIN_WITHOUT_DOMAIN = "adLoginWithoutDomain";
    private static final String ATTR_REALM = "realm";
    private static final String ATTR_TRACE_ID = "traceId";
    private static final String MDC_TRACE_ID = "traceId";
    private static final String MDC_USER_ID = "userId";
    private static final String MDC_SESSION_ID = "sessionId";

    private final JwtFilterProperties props;
    private final EpaSdkService epaSdkService;
    private final AuditEventSenderCustom auditEventSender;
    private final OpenTelemetryTraceContextProvider openTelemetryTraceContextProvider;
    private final ObjectMapper objectMapper;

    /**
     * Исключаем uri swagger
     *
     * @param request current HTTP request
     * @return true - не должен примениться фильтр, false - применить фильтр
     */
    @Override
    protected boolean shouldNotFilter(HttpServletRequest request) {
        return request.getRequestURI() != null && request.getRequestURI().startsWith("/v3/api-docs");
    }

    @Override
    protected void doFilterInternal(HttpServletRequest request, HttpServletResponse response, FilterChain chain)
            throws ServletException, IOException {

        final String authorizationHeader = request.getHeader(AUTH_TOKEN_HEADER_NAME);
        String jwt = null;

        request.setAttribute(ATTR_SESSION_CREATED_AT, LocalDateTime.now());

        if (props.isDisable()) {
            applyLocalPrincipal(request);

            RequestContext ctx = new RequestContext(
                    attr(request, "adLogin"),
                    attr(request, "sessionId"),
                    attr(request, "channel"),
                    attr(request, "traceId"),
                    (LocalDateTime) request.getAttribute("sessionCreatedAt")
            );
            RequestContextHolder.set(ctx);

            chain.doFilter(request, response);
            return;
        }

        if (authorizationHeader == null || !authorizationHeader.startsWith(BEARER)) {
            request.setAttribute(ATTR_AD_LOGIN, props.getDefaultSub());
            chain.doFilter(request, response);
            return;
        }

        jwt = authorizationHeader.substring(7).trim(); // "Bearer ".length()
        try {
            String adLoginWithDomain = JWTUtil.getSubWithDomain(jwt);
            String adLogin = JWTUtil.getSub(jwt);
            String sessionId = JWTUtil.getSessionId(jwt);
            String channel = JWTUtil.getChannel(jwt);
            String realm = JWTUtil.getRealm(jwt);

            initiateTracingContext(adLogin, sessionId);

            EpaValidationResult validate = epaSdkService.checkJWT(jwt);
            ValidationResult validationResult = validate.getValidationResult();

            if (!validationResult.isSuccess()) {
                sendJwtValidateEvent(sessionId, false, validationResult.toString());
                response.setStatus(HttpServletResponse.SC_UNAUTHORIZED);
                return;
            }

            log.info("JWT Subject [{}]", JWTUtil.getFullSub(jwt));

            if (!isAllowedChannel(channel)) {
                log.error("В JWT прибыл некорректный тип канала");
                handleError(response, ErrorResponse.ERROR_UNAUTHORIZED_CHANNEL_MESSAGE);
                sendJwtForbiddenEvent(sessionId);
                return;
            }

            if (adLogin != null && sessionId != null && channel != null
                    && adLoginWithDomain != null && realm != null) {
                applyPrincipal(request, adLoginWithDomain, sessionId, channel, adLogin, realm);

                RequestContext ctx = new RequestContext(
                        adLogin,
                        sessionId,
                        channel,
                        MDC.get(MDC_TRACE_ID),
                        (LocalDateTime) request.getAttribute("sessionCreatedAt")
                );
                RequestContextHolder.set(ctx);
            } else {
                log.error("В JWT отсутствует один из необходимых параметров: sub, ctxi, channel or realm.");
                handleError(response, ErrorResponse.ERROR_NOT_ALL_REQUIRED_JWT_PARAMS_MESSAGE);
                sendJwtForbiddenEvent(sessionId);
                return;
            }

        } catch (Exception e) {
            log.error("Произошла ошибка при аутентификации: [{}]", e.getMessage());
            String sessionId = JWTUtil.getSessionId(jwt);
            sendJwtUnexpectedErrorEvent(sessionId);
        }

        chain.doFilter(request, response);
    }

    private void applyPrincipal(HttpServletRequest request,
                                String adLoginWithDomain,
                                String sessionId,
                                String channel,
                                String adLoginWithoutDomain,
                                String realm) {
        request.setAttribute(ATTR_AD_LOGIN, adLoginWithDomain);
        request.setAttribute(ATTR_SESSION_ID, sessionId);
        request.setAttribute(ATTR_CHANNEL, channel);
        request.setAttribute(ATTR_AD_LOGIN_WITHOUT_DOMAIN, adLoginWithoutDomain);
        request.setAttribute(ATTR_REALM, realm);
        request.setAttribute(ATTR_TRACE_ID, MDC.get(MDC_TRACE_ID));
    }

    private void applyLocalPrincipal(HttpServletRequest request) {
        JwtFilterProperties.Local local = props.getLocal();
        applyPrincipal(request,
                local.getSubWithDomain(),
                local.getSessionId(),
                local.getChannel(),
                local.getSub(),
                local.getRealm());
    }

    private static String attr(HttpServletRequest request, String name) {
        return (String) request.getAttribute(name);
    }

    private void initiateTracingContext(String adLogin, String sessionId) {
        MDC.put(MDC_USER_ID, adLogin);
        MDC.put(MDC_SESSION_ID, sessionId);
        MDC.put(MDC_TRACE_ID, openTelemetryTraceContextProvider.getActiveSpanTraceId());
    }

    private boolean isAllowedChannel(String channel) {
        return AllowedChannels.channelNames().contains(channel);
    }

    private void handleError(HttpServletResponse response, String errorText) throws IOException {
        ServiceError error = new ServiceError(errorText, "401_JWT_AUTH_ERROR", MDC.get(MDC_TRACE_ID), new ArrayList<>());
        ServiceErrorDto errorDto = new ServiceErrorDto(error);
        response.setContentType("application/json");
        response.setStatus(HttpServletResponse.SC_UNAUTHORIZED);
        response.setCharacterEncoding("UTF-8");
        response.getWriter().write(objectMapper.writeValueAsString(errorDto));
    }

    private void sendJwtValidateEvent(String sessionId, Boolean isValid, String errorMessage) {
        try {
            auditEventSender.sendJwtValidateEvent(sessionId, isValid, errorMessage);
        } catch (Exception e) {
            log.debug("Отправка события неуспешной валидации токена завершена");
        }
    }

    private void sendJwtForbiddenEvent(String sessionId) {
        try {
            auditEventSender.sendJwtForbiddenEvent(sessionId);
        } catch (Exception e) {
            log.debug("Отправка события в отказе авторизации");
        }
    }

    private void sendJwtUnexpectedErrorEvent(String sessionId) {
        try {
            auditEventSender.sendJwtUnexpectedErrorEvent(sessionId);
        } catch (Exception e) {
            log.debug("Отправка события непредвиденной ошибки при авторизации");
        }
    }
}



