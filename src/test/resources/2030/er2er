app:
  scheduler:
    enabled: false

spring:
  main:
    allow-bean-definition-overriding: true

  datasource:
    url: jdbc:postgresql://localhost:5432/srhr_reference
    username: ${DB_USERNAME:postgres}
    password: ${DB_PASSWORD:postgres}
    driver-class-name: org.postgresql.Driver
    hikari:
      schema: srhr_reference

  liquibase:
    enabled: true
    default-schema: srhr_reference
    liquibase-schema: srhr_reference

  jpa:
    hibernate:
      ddl-auto: none
    database-platform: org.hibernate.dialect.H2Dialect
    properties:
      hibernate:
        default_schema: srhr_reference

