databaseChangeLog:
  - changeSet:
      id: truncate-staff-card-cache
      author: nikolai
      changes:
        - sql:
            sql: TRUNCATE TABLE {h-schema}staff_card RESTART IDENTITY
      rollback:
        - empty

  - changeSet:
      id: add-unique-constraint-staff-card-tab-number
      author: nikolai
      changes:
        - addUniqueConstraint:
            tableName: staff_card
            columnNames: tab_number
            constraintName: uq_staff_card_tab_number
      rollback:
        - dropUniqueConstraint:
            tableName: staff_card
            constraintName: uq_staff_card_tab_number
