private void sortCandidateEvents(List<CandidateEventEntity> candidateEventsLatest,
                                     String sortAttr,
                                     String sortDirection) {

        List<CandidateStageEntity> candidateStageSorting = candidateStageRepository.findAll();
        Map<String, Integer> sortingMap = candidateStageSorting.stream()
                .collect(Collectors.toMap(CandidateStageEntity::getCode, CandidateStageEntity::getSorting));

        Map<String, String> statusNameSortingMap = candidateStageStatusRepository.findStatusNameMapping().stream()
                .collect(Collectors.toMap(
                        p -> statusKey(p.getEventCode(), p.getStatusCode()),
                        CandidateStatusNameProjection::getName,
                        (a, b) -> a));


        if (candidateEventsLatest == null || candidateEventsLatest.isEmpty()
                || sortAttr == null || sortAttr.isEmpty()
                || sortDirection == null || sortDirection.isEmpty()) {
            return;
        }

        Comparator<CandidateEventEntity> comparator;
        switch (sortAttr) {
            case "event" -> comparator = Comparator.comparingInt(
                    e -> sortingMap.getOrDefault(e.getEventCode(), Integer.MAX_VALUE));
            case "eventstatus" -> comparator = Comparator.comparing(
                    e -> statusNameSortingMap.get(statusKey(e.getEventCode(), e.getStatusCode())),
                    Comparator.nullsLast(Comparator.naturalOrder()));
            case "fio" -> comparator = Comparator.comparing(
                    e -> e.getCandidateId() == null ? null : e.getCandidateId().getFullName(),
                    Comparator.nullsLast(Comparator.naturalOrder()));
            default -> {
                return;
            }
        }

        if (sortDirection.equals("desc")) {
            comparator = comparator.reversed();
        }
        candidateEventsLatest.sort(comparator);
    }





package ru.ntdev.srhr.ms.requisition.service;

import java.lang.reflect.Method;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import org.junit.jupiter.api.Test;
import ru.ntdev.srhr.ms.requisition.entity.CandidateEntity;
import ru.ntdev.srhr.ms.requisition.entity.CandidateEventEntity;
import ru.ntdev.srhr.ms.requisition.service.impl.DatabaseServiceImpl;

import static org.assertj.core.api.Assertions.assertThat;
import static org.mockito.Mockito.mock;

public class DatabaseServiceSortCandidateEventsTest {

    private static final Method SORT;
    static {
        try {
            SORT = DatabaseServiceImpl.class.getDeclaredMethod(
                    "sortCandidateEvents",
                    List.class, String.class, String.class, Map.class);
            SORT.setAccessible(true);
        } catch (NoSuchMethodException e) {
            throw new ExceptionInInitializerError(e);
        }
    }

    private final DatabaseServiceImpl service = mock(DatabaseServiceImpl.class);

    private void invokeSort(List<CandidateEventEntity> events,
                                   String attr, String dir,
                                   Map<String, Integer> map) throws Exception {
        SORT.invoke(service, events, attr, dir, map);
    }

    private static CandidateEventEntity event(String code, String status, String fio) {
        CandidateEntity c = new CandidateEntity();
        c.setFullName(fio);
        CandidateEventEntity e = new CandidateEventEntity();
        e.setEventCode(code);
        e.setStatusCode(status);
        e.setCandidateId(c);
        return e;
    }

    private final Map<String, Integer> sortingMap = Map.of(
            "Ожидает", 1, "Запланированно", 2, "Одобрено", 3);

    @Test
    void event_asc_sort() throws Exception {
        var list = new ArrayList<>(List.of(
                event("Ожидает", "Status", "Клиент1"),
                event("Запланированно", "Status", "Клиент2"),
                event("Одобрено", "Status", "Клиент3")));

        invokeSort(list, "event", "asc", sortingMap);

        assertThat(list).extracting(CandidateEventEntity::getEventCode)
                .containsExactly("Ожидает", "Запланированно", "Одобрено");
    }

    @Test
    void event_desc_sort() throws Exception {
        var list = new ArrayList<>(List.of(
                event("Запланированно", "Status", "Клиент2"),
                event("Ожидает", "Status", "Клиент1"),
                event("Одобрено", "Status", "Клиент3")));

        invokeSort(list, "event", "desc", sortingMap);

        assertThat(list).extracting(CandidateEventEntity::getEventCode)
                .containsExactly("Одобрено", "Запланированно", "Ожидает");
    }

    @Test
    void eventStatus_asc_sorts() throws Exception {
        var list = new ArrayList<>(List.of(
                event("Ожидает", "Status1", "Клиент1"),
                event("Запланированно", "Status2", "Клиент1"),
                event("Одобрено", "Status3", "Клиент1")));

        invokeSort(list, "eventstatus", "asc", sortingMap);

        assertThat(list).extracting(CandidateEventEntity::getStatusCode)
                .containsExactly("Status1", "Status2", "Status3");
    }

    @Test
    void eventStatus_desc_sorts() throws Exception {
        var list = new ArrayList<>(List.of(
                event("Ожидает", "Status1", "Клиент1"),
                event("Запланированно", "Status2", "Клиент1"),
                event("Одобрено", "Status3", "Клиент1")));

        invokeSort(list, "eventstatus", "desc", sortingMap);

        assertThat(list).extracting(CandidateEventEntity::getStatusCode)
                .containsExactly("Status3", "Status2", "Status1");
    }

    @Test
    void fio_asc_sorts() throws Exception {
        var list = new ArrayList<>(List.of(
                event("Ожидает", "Status1", "Иванов"),
                event("Запланированно", "Status1", "Петров"),
                event("Одобрено", "Status1", "Сидоров")));

        invokeSort(list, "fio", "asc", sortingMap);

        assertThat(list).extracting(e -> e.getCandidateId().getFullName())
                .containsExactly("Иванов", "Петров", "Сидоров");
    }

    @Test
    void fio_desc_sorts() throws Exception {
        var list = new ArrayList<>(List.of(
                event("Ожидает", "Status1", "Иванов"),
                event("Запланированно", "Status1", "Петров"),
                event("Одобрено", "Status1", "Сидоров")));

        invokeSort(list, "fio", "desc", sortingMap);

        assertThat(list).extracting(e -> e.getCandidateId().getFullName())
                .containsExactly("Сидоров", "Петров", "Иванов");
    }
}




