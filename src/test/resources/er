 private void sortCandidateEvents(List<CandidateEventEntity> candidateEventsLatest,
                                     String sortAttr,
                                     String sortDirection) {

        List<CandidateStageEntity> candidateStageSorting = candidateStageRepository.findAll();
        Map<String, Integer> candidateStageSortingMap = candidateStageSorting.stream()
                .collect(Collectors.toMap(CandidateStageEntity::getCode, CandidateStageEntity::getSorting));


        Map<String, String> sortingMap = new HashMap<>();
        candidateEventsLatest.forEach(e -> {

            Integer eventCodeId = candidateStageRepository.findByCode(e.getEventCode()).getId();

            Integer statusId = candidateStageStatusRepository.findAll().stream().filter(it -> it.getStageId().equals(eventCodeId)).findFirst().get().getStatusId();

            CandidateStatusEntity candidateStatus = candidateStatusRepository.findById(statusId).get();

            sortingMap.put(e.getEventCode(), candidateStatus.getName());
        });
        

        if (candidateEventsLatest == null || candidateEventsLatest.isEmpty()
                || sortAttr == null || sortAttr.isEmpty()
                || sortDirection == null || sortDirection.isEmpty()) {
            return;
        }

        Comparator<CandidateEventEntity> comparator;
        switch (sortAttr) {
            case "event" -> comparator = Comparator.comparingInt(
                    e -> candidateStageSortingMap.getOrDefault(e.getEventCode(), Integer.MAX_VALUE));
            case "eventstatus" -> comparator = Comparator.comparing(
                    CandidateEventEntity::getStatusCode,
                    Comparator.nullsLast(Comparator.naturalOrder()));
            case "fio" -> comparator = Comparator.comparing(
                    e -> e.getCandidateId() == null ? null : e.getCandidateId().getFullName(),
                    Comparator.nullsLast(Comparator.naturalOrder()));
            default -> {
                return;
            }
        }

        if (sortDirection.equals("desc")) {
            comparator = comparator.reversed();
        }
        candidateEventsLatest.sort(comparator);
    }



