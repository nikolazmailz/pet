public RequisitionPostVacancyCandidatesDto getRequisitionPostVacancyCandidates(RequisitionPostVacancyCandidatesRequest requestValues, SapSystemParamsDto systemParams) throws Exception {
        Boolean skipCache = requestValues.isSkipCache();
        String vacancyId = requestValues.getVacancyId();
        RequisitionPostVacancyCandidatesDto dto;
        ResponseEntity<SpoVacancyCandidatesDto> response;
        SpoVacancyCandidatesDto spoDto = null;
        VacancyEntity vacancyEntity = vacancyRepository.findVacancyStatusEntityByVacancyId(vacancyId);
        LocalDateTime currentTime = LocalDateTime.now();
        Integer offset = calculateOffset(requestValues.getPage(), requestValues.getPageSize());
        Integer limit = requestValues.getPageSize();
        String tabsCode = requestValues.getCandidateTabsCode();
        Integer activeTabCount = 0;
        Integer inactiveTabCount = 0;
        String sortAttr = requestValues.getSortAttribute().toLowerCase();
        String sortDirection = requestValues.getSortDirection().toLowerCase();
        boolean filtersPresent = false;
        if (requestValues.getFilter() != null) {
            if (requestValues.getFilter().getEventCodeList() != null || requestValues.getFilter().getEventStatusCodeList() != null || requestValues.getFilter().getSearch() != null ||
                    !requestValues.getFilter().getEventCodeList().isEmpty() || !requestValues.getFilter().getEventStatusCodeList().isEmpty() || !requestValues.getFilter().getSearch().isEmpty()) {
                filtersPresent = true;
            }
        }
        String searchString = null;
        if (requestValues.getFilter() != null && requestValues.getFilter().getSearch() != null && !requestValues.getFilter().getSearch().isEmpty()) {
            searchString = prepareSearchString(requestValues.getFilter().getSearch());
        }
        if (vacancyEntity.getCandidatesLastUpdate() == null || skipCache) {
            response = masterDataIntegrationService.getPostVacancyCandidates(systemParams, systemParams.getTabNumber(), requestValues.getVacancyId());
            if (response != null) {
                spoDto = response.getBody();
                log.debug("Получаемый ответ по кандидатам и их этапам : [{}]", objectMapper.writeValueAsString(spoDto));
            }
        } else {
            if (vacancyEntity.getCandidatesLastUpdate().plusHours(ttlVacancyCandidates).isBefore(currentTime)) {
                response = masterDataIntegrationService.getPostVacancyCandidates(systemParams, systemParams.getTabNumber(), requestValues.getVacancyId());
                if (response != null) {
                    spoDto = response.getBody();
                    log.debug("Получаемый ответ по кандидатам и их этапам : [{}]", objectMapper.writeValueAsString(spoDto));
                }
            }
        }
        if (spoDto != null) {
            SpoVacancyCandidatesMappedDto mappedDto = mapperService.mapSpoCandidatesToCandidateEntities(spoDto.getData().getCandidates(), vacancyEntity);
            List<CandidateEntity> candidateEntities = mappedDto.getCandidateEntityList();
            List<CandidateEventEntity> candidateEventEntities = mappedDto.getCandidateEventEntities();
            try {
                candidateEventRepository.deleteCandidateEventEntitiesByVacancyId(vacancyEntity.getId());
                candidateRepository.deleteCandidateEntitiesByVacancyId(vacancyEntity.getId());
                candidateRepository.saveAll(candidateEntities);
                candidateEventRepository.saveAll(candidateEventEntities);
                vacancyRepository.updateCandidateUpdateDate(vacancyId, LocalDateTime.now());
            } catch (Exception e) {
                log.error("Произошла ошибка при попытке удаления и обновления в бд сущностей [candidates] и [candidates_events], текст ошибки: [{}]", e.getMessage());
                log.debug("Произошла ошибка при попытке удаления и обновления в бд сущностей [candidates] и [candidates_events], стектрейс ошибки: [{}]", ExceptionUtils.getStackTrace(e));
            }
        }
        List<CandidateEventEntity> candidateEventsLatest;
        List<CandidateStageEntity> candidateStageSorting = candidateStageRepository.findAll();
        Map<String,Integer> sortingMap = candidateStageSorting.stream()
                .collect(Collectors.toMap(CandidateStageEntity::getCode, CandidateStageEntity::getSorting));
        if (filtersPresent) {
            // Несмотря на то, что вторая вкладка называется inactive, согласно бизнесу на ней просто показываются все кандидаты
            if (tabsCode.equals("active")) {
                activeTabCount = candidateEventRepository.countActiveCandidatesAndCandidatesEventsByVacancyIdWithFilters(vacancyEntity.getId(), searchString, requestValues.getFilter().getEventCodeList(), requestValues.getFilter().getEventStatusCodeList());
                inactiveTabCount = candidateEventRepository.countInactiveCandidatesAndCandidatesEventsByVacancyIdWithFilters(vacancyEntity.getId(), searchString, requestValues.getFilter().getEventCodeList(), requestValues.getFilter().getEventStatusCodeList());
                candidateEventsLatest = candidateEventRepository.findActiveCandidatesAndCandidatesEventsByVacancyIdWithFilters(vacancyEntity.getId(), searchString, requestValues.getFilter().getEventCodeList(), requestValues.getFilter().getEventStatusCodeList(), limit, offset);
            } else {
                activeTabCount = candidateEventRepository.countActiveCandidatesAndCandidatesEventsByVacancyIdWithFilters(vacancyEntity.getId(), searchString, requestValues.getFilter().getEventCodeList(), requestValues.getFilter().getEventStatusCodeList());
                inactiveTabCount = candidateEventRepository.countInactiveCandidatesAndCandidatesEventsByVacancyIdWithFilters(vacancyEntity.getId(), searchString, requestValues.getFilter().getEventCodeList(), requestValues.getFilter().getEventStatusCodeList());
                candidateEventsLatest = candidateEventRepository.findInactiveCandidatesAndCandidatesEventsByVacancyIdWithFilters(vacancyEntity.getId(), searchString, requestValues.getFilter().getEventCodeList(), requestValues.getFilter().getEventStatusCodeList(), limit, offset);
            }
        } else {
            if (tabsCode.equals("active")) {
                activeTabCount = candidateEventRepository.countActiveCandidatesAndCandidatesEventsByVacancyId(vacancyEntity.getId());
                inactiveTabCount = candidateEventRepository.countInactiveCandidatesAndCandidatesEventsByVacancyId(vacancyEntity.getId());
                candidateEventsLatest = candidateEventRepository.findActiveCandidatesAndCandidatesEventsByVacancyId(vacancyEntity.getId(), limit, offset);
            } else {
                activeTabCount = candidateEventRepository.countActiveCandidatesAndCandidatesEventsByVacancyId(vacancyEntity.getId());
                inactiveTabCount = candidateEventRepository.countInactiveCandidatesAndCandidatesEventsByVacancyId(vacancyEntity.getId());
                candidateEventsLatest = candidateEventRepository.findInactiveCandidatesAndCandidatesEventsByVacancyId(vacancyEntity.getId(), limit, offset);

            }
        }
        if (sortDirection != null && !sortDirection.isEmpty() && sortAttr != null && !sortAttr.isEmpty() && candidateEventsLatest != null && !candidateEventsLatest.isEmpty() ) {
            //TODO Перебиваю айди, чтобы отсортировать сущности, подумать, как лучше реализовать
            if (sortAttr.equals("event") && sortDirection.equals("asc")) {
                for (CandidateEventEntity entity : candidateEventsLatest ){
                    entity.setId(sortingMap.get(entity.getEventCode()));
                }
                candidateEventsLatest.sort(Comparator.comparing(CandidateEventEntity::getId));
            }
            if (sortAttr.equals("event") && sortDirection.equals("desc")) {
                for (CandidateEventEntity entity : candidateEventsLatest ){
                    entity.setId(sortingMap.get(entity.getEventCode()));
                }
                candidateEventsLatest.sort(Comparator.comparing(CandidateEventEntity::getId).reversed());
            }
            if (sortAttr.equals("eventstatus") && sortDirection.equals("asc")) {
                candidateEventsLatest.sort(Comparator.comparing(CandidateEventEntity::getStatusCode));
            }
            if (sortAttr.equals("eventstatus") && sortDirection.equals("desc")) {
                candidateEventsLatest.sort(Comparator.comparing(CandidateEventEntity::getStatusCode).reversed());
            }
            if (sortAttr.equals("fio") && sortDirection.equals("asc")) {
                candidateEventsLatest.sort(Comparator.comparing(obj -> obj.getCandidateId().getFullName()));
            }
            if (sortAttr.equals("fio") && sortDirection.equals("desc")) {
                candidateEventsLatest.sort(Comparator.comparing(obj -> obj.getCandidateId().getFullName()));
                Collections.reverse(candidateEventsLatest);
            }
        }
        dto = mapperService.mapCandidatesAndEventsToVacancyCandidatesDto(candidateEventsLatest, requestValues, activeTabCount, inactiveTabCount);
        return dto;
    }
