                                '2024-06-01 10:00:00', 'Иванов', 'Иван', 'Иванович',
                                'Петров', 'Петр', 'Петрович',
                                'PUB-999', true, false, '2024-06-01 10:00:00', '2024-06-01 10:00:00'
