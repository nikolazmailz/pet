package ru.ntdev.srhr.ms.requisition.service;

import java.lang.reflect.Method;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.Mock;
import org.springframework.test.util.ReflectionTestUtils;
import ru.ntdev.srhr.ms.requisition.entity.CandidateEntity;
import ru.ntdev.srhr.ms.requisition.entity.CandidateEventEntity;
import ru.ntdev.srhr.ms.requisition.entity.CandidateStageEntity;
import ru.ntdev.srhr.ms.requisition.entity.projection.CandidateStatusNameProjection;
import ru.ntdev.srhr.ms.requisition.repository.CandidateStageRepository;
import ru.ntdev.srhr.ms.requisition.repository.CandidateStageStatusRepository;
import ru.ntdev.srhr.ms.requisition.service.impl.DatabaseServiceImpl;

import static org.assertj.core.api.Assertions.assertThat;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

public class DatabaseServiceSortCandidateEventsTest {

    private static final Method SORT;

    static {
        try {
            SORT = DatabaseServiceImpl.class.getDeclaredMethod(
                    "sortCandidateEvents",
                    List.class, String.class, String.class);
            SORT.setAccessible(true);
        } catch (NoSuchMethodException e) {
            throw new ExceptionInInitializerError(e);
        }
    }

    @Mock
    private CandidateStageRepository candidateStageRepository;
    @Mock
    private CandidateStageStatusRepository candidateStageStatusRepository;

    private final DatabaseServiceImpl service = mock(DatabaseServiceImpl.class);

    @BeforeEach
    void setup() {
        ReflectionTestUtils.setField(service, "candidateStageRepository", candidateStageRepository);
        ReflectionTestUtils.setField(service, "candidateStageStatusRepository", candidateStageStatusRepository);
    }

    private void invokeSort(List<CandidateEventEntity> events,
                            String attr, String dir) throws Exception {
        SORT.invoke(service, events, attr, dir);
    }

    private static CandidateEventEntity event(String code, String status, String fio) {
        CandidateEntity c = new CandidateEntity();
        c.setFullName(fio);
        CandidateEventEntity e = new CandidateEventEntity();
        e.setEventCode(code);
        e.setStatusCode(status);
        e.setCandidateId(c);
        return e;
    }

    private static CandidateStageEntity stage(String code, Integer sorting) {
        CandidateStageEntity s = new CandidateStageEntity();
        s.setCode(code);
        s.setSorting(sorting);
        return s;
    }

    private static CandidateStatusNameProjection projection(String eventCode,
                                                            String statusCode,
                                                            String name) {
        return new CandidateStatusNameProjection() {
            @Override public String getEventCode() { return eventCode; }
            @Override public String getStatusCode() { return statusCode; }
            @Override public String getName() { return name; }
        };
    }


    private final Map<String, Integer> sortingMap = Map.of(
            "Ожидает", 1, "Запланированно", 2, "Одобрено", 3);

    @Test
    void event_asc_sort() throws Exception {
        when(candidateStageRepository.findAll()).thenReturn(List.of(
                stage("Ожидает", 1),
                stage("Запланированно", 2),
                stage("Одобрено", 3)));

        var list = new ArrayList<>(List.of(
                event("Ожидает", "Status", "Клиент1"),
                event("Запланированно", "Status", "Клиент2"),
                event("Одобрено", "Status", "Клиент3")));

        invokeSort(list, "event", "asc");

        assertThat(list).extracting(CandidateEventEntity::getEventCode)
                .containsExactly("Ожидает", "Запланированно", "Одобрено");
    }

    @Test
    void event_desc_sort() throws Exception {
        when(candidateStageRepository.findAll()).thenReturn(List.of(
                stage("Ожидает", 1),
                stage("Запланированно", 2),
                stage("Одобрено", 3)));

        var list = new ArrayList<>(List.of(
                event("Запланированно", "Status", "Клиент2"),
                event("Ожидает", "Status", "Клиент1"),
                event("Одобрено", "Status", "Клиент3")));

        invokeSort(list, "event", "desc");

        assertThat(list).extracting(CandidateEventEntity::getEventCode)
                .containsExactly("Одобрено", "Запланированно", "Ожидает");
    }

    @Test
    void eventStatus_asc_sorts() throws Exception {
        when(candidateStageStatusRepository.findStatusNameMapping()).thenReturn(List.of(
                projection("rr_resume_review", "pending", "Ожидает решения"),
                projection("rr_interview", "succeeded", "Одобрено"),
                projection("rr_interview_2", "reserve", "В резерве")));

        var list = new ArrayList<>(List.of(
                event("rr_resume_review", "pending", "Клиент1"),
                event("rr_interview", "succeeded", "Клиент2"),
                event("rr_interview_2", "reserve", "Клиент3")));

        invokeSort(list, "eventstatus", "asc");

        assertThat(list).extracting(CandidateEventEntity::getStatusCode)
                .containsExactly("Status1", "Status2", "Status3");
    }

    @Test
    void eventStatus_desc_sorts() throws Exception {
        when(candidateStageStatusRepository.findStatusNameMapping()).thenReturn(List.of(
                projection("rr_resume_review", "pending", "Ожидает решения"),
                projection("rr_interview", "succeeded", "Одобрено"),
                projection("rr_interview_2", "reserve", "В резерве")));

        var list = new ArrayList<>(List.of(
                event("rr_resume_review", "pending", "Клиент1"),
                event("rr_interview", "succeeded", "Клиент2"),
                event("rr_interview_2", "reserve", "Клиент3")));

        invokeSort(list, "eventstatus", "desc");

        assertThat(list).extracting(CandidateEventEntity::getStatusCode)
                .containsExactly("Status3", "Status2", "Status1");
    }

    @Test
    void fio_asc_sorts() throws Exception {
        var list = new ArrayList<>(List.of(
                event("Ожидает", "Status1", "Иванов"),
                event("Запланированно", "Status1", "Петров"),
                event("Одобрено", "Status1", "Сидоров")));

        invokeSort(list, "fio", "asc");

        assertThat(list).extracting(e -> e.getCandidateId().getFullName())
                .containsExactly("Иванов", "Петров", "Сидоров");
    }

    @Test
    void fio_desc_sorts() throws Exception {
        var list = new ArrayList<>(List.of(
                event("Ожидает", "Status1", "Иванов"),
                event("Запланированно", "Status1", "Петров"),
                event("Одобрено", "Status1", "Сидоров")));

        invokeSort(list, "fio", "desc");

        assertThat(list).extracting(e -> e.getCandidateId().getFullName())
                .containsExactly("Сидоров", "Петров", "Иванов");
    }
}






