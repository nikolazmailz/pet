package ru.ntdev.srhr.ms.taskblocker.concurrent;

import java.time.Duration;
import java.util.concurrent.CountDownLatch;
import java.util.concurrent.Executors;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicInteger;
import lombok.extern.slf4j.Slf4j;
import org.junit.jupiter.api.Test;
import ru.ntdev.srhr.ms.taskblocker.BaseIntegrationTest;
import ru.ntdev.srhr.ms.taskblocker.controller.dto.SystemBlockRequest;

import static org.assertj.core.api.AssertionsForClassTypes.assertThat;

@Slf4j
public class ConcurrentAcquireIT extends BaseIntegrationTest {

    @Test
    void onlyOneOfManyConcurrentAcquiresSucceeds() throws InterruptedException {
        int threads = 20;
        var req = new SystemBlockRequest("srhr-housekeep cleanerTask", Duration.ofHours(1));

        var pool = Executors.newFixedThreadPool(threads);
        var startGate = new CountDownLatch(1);
        var doneGate = new CountDownLatch(threads);
        var successes = new AtomicInteger();

        for (int i = 0; i < threads; i++) {
            pool.submit(() -> {
                try {
                    startGate.await();
                    if (taskBlockerService.acquire(req.operationCode(), req.blockTTL()) != null) {
                        log.info("Thread name: #{}", Thread.currentThread().getName());
                        successes.incrementAndGet();
                    }
                } catch (InterruptedException ignored) {
                    Thread.currentThread().interrupt();
                } finally {
                    doneGate.countDown();
                }
            });
        }

        startGate.countDown();
        boolean finished = doneGate.await(30, TimeUnit.SECONDS);
        pool.shutdownNow();

        assertThat(finished).isTrue();
        assertThat(successes.get()).isEqualTo(1);
        assertThat(taskBlockerRepository.count()).isEqualTo(1);
    }
}
