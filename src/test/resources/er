@Component
@Slf4j
@RequiredArgsConstructor
public class CleanerTask {

    private final CleanerTaskService cleanerTaskService;

    @Scheduled(cron = "${app.scheduler.db.cron.cleaner}")
    @Async(value = "ProducerExecutor")
    public void produce() throws JsonProcessingException {
        cleanerTaskService.processBatch();
    }
}

@Service
@Slf4j
@RequiredArgsConstructor
public class CleanerTaskService {

    private final RedisAdapter redisAdapter;
    private final CleanerTaskExecutor taskExecutor;

    @Value("${spring.data.redis.queue.name.housekeep}")
    private String housekeepRequestQueue;

    @Value("${app.cleaner.batch-size:100}")
    private int batchSize;

    @SystemBlock(ttlHours = "${srhr.task-blocker.cleaner.ttl}")
    public void processBatch() {
        log.debug("Cleaner: starting batch, max size = {}", batchSize);
        int processed = 0, failed = 0;
        for (int i = 0; i < batchSize; i++) {
            String request = redisAdapter.getFromQueue(housekeepRequestQueue);
            if (request == null) break;
            try {
                taskExecutor.processOne(request);
                processed++;
            } catch (Exception e) {
                failed++;
            }
        }
        log.info("Cleaner: batch finished, processed={}, failed={}", processed, failed);
    }
}


@Service
@Slf4j
@RequiredArgsConstructor
public class CleanerTaskExecutor {

    private final TaskCleanerRepositoryImpl taskCleanerRepository;
    private final TaskScheduleRepository taskScheduleRepository;
    private final ObjectMapper objectMapper;

    @Transactional(propagation = Propagation.REQUIRES_NEW)
    public void processOne(String rawRequest) {
        try {
            ScheduledTaskDto dto = objectMapper.readValue(rawRequest, ScheduledTaskDto.class);
            taskCleanerRepository.deleteData(
                    dto.getSchemaName(),
                    dto.getTableName(),
                    dto.getConditionColumn(),
                    dto.getDataExpirationInHours()
            );
            taskScheduleRepository.updatelastSuccessfulCleanDateById(
                    dto.getTaskId(),
                    LocalDateTime.now()
            );
            log.debug("CleanerTaskExecutor: processed task {}", dto.getTaskId());
        } catch (JsonProcessingException e) {
            log.error("CleanerTaskExecutor: failed to parse request [{}]: {}", rawRequest, e.getMessage());
            throw new IllegalStateException("Invalid task payload", e);
        } catch (Exception e) {
            log.error("CleanerTaskExecutor: failed to process request [{}]: {}", rawRequest, e.getMessage(), e);
            throw e;
        }
    }
}
