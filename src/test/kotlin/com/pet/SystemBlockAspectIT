package ru.ntdev.srhr.mod.commons.taskblocker.application.aspect;

import com.github.tomakehurst.wiremock.WireMockServer;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Import;
import org.wiremock.spring.EnableWireMock;
import org.wiremock.spring.InjectWireMock;

import ru.ntdev.srhr.mod.commons.taskblocker.annotation.SystemBlock;
import ru.ntdev.srhr.mod.commons.taskblocker.infra.config.TaskBlockerClientConfig;

import static com.github.tomakehurst.wiremock.client.WireMock.*;
import static org.assertj.core.api.Assertions.assertThat;

@SpringBootTest(
        classes = SystemBlockAspectIT.TestApp.class,
        properties = {
                "srhr.task-blocker.enabled=true",
                "srhr.task-blocker.base-url=http://localhost:${wiremock.server.port}",
                "spring.application.name=test-service",
                "spring.cloud.openfeign.client.config.task-blocker.connect-timeout=2000",
                "spring.cloud.openfeign.client.config.task-blocker.read-timeout=2000"
        }
)
@EnableWireMock
class SystemBlockAspectIT {

    @SpringBootApplication
    @Import(TaskBlockerClientConfig.class)
    static class TestApp {
        @Bean
        TestTaskService testTaskService() {
            return new TestTaskService();
        }
    }

    /** Подопытный сервис: один метод с @SystemBlock, один без — для контроля. */
    static class TestTaskService {
        boolean executed = false;
        String returnValue = "ok";

        @SystemBlock(ttlHours = 1)
        public String cleanerTask() {
            executed = true;
            return returnValue;
        }
    }

    @Autowired
    TestTaskService taskService;

    @InjectWireMock
    WireMockServer wiremock;

    @BeforeEach
    void resetState() {
        taskService.executed = false;
        wiremock.resetAll();
    }

    // ===== Сценарий 1: успешный путь =====

    @Test
    void taskRunsAndReleasesLockWhenAcquired() {
        wiremock.stubFor(post(urlEqualTo("/system-block"))
                .willReturn(okJson("\"uuid-1234\"")));
        wiremock.stubFor(put(urlEqualTo("/system-block"))
                .willReturn(okJson("true")));

        String result = taskService.cleanerTask();

        assertThat(result).isEqualTo("ok");
        assertThat(taskService.executed).isTrue();

        // проверяем тело POST: формат DTO, имя сервиса+метода, формат TTL
        wiremock.verify(postRequestedFor(urlEqualTo("/system-block"))
                .withRequestBody(matchingJsonPath("$.operationCode",
                        equalTo("test-service cleanerTask")))
                .withRequestBody(matchingJsonPath("$.blockTTL",
                        equalTo("01:00:00"))));

        // проверяем PUT: blockId из ответа на POST
        wiremock.verify(putRequestedFor(urlEqualTo("/system-block"))
                .withRequestBody(matchingJsonPath("$.blockId",
                        equalTo("uuid-1234"))));
    }

    // ===== Сценарий 2: блокировка занята =====

    @Test
    void taskSkippedWhenLockBusy() {
        wiremock.stubFor(post(urlEqualTo("/system-block"))
                .willReturn(okJson("null")));               // блокировщик: занято

        String result = taskService.cleanerTask();

        assertThat(result).isNull();
        assertThat(taskService.executed).isFalse();
        wiremock.verify(0, putRequestedFor(urlEqualTo("/system-block")));  // unblock не звался
    }

    // ===== Сценарий 3: блокировщик недоступен =====

    @Test
    void taskSkippedWhenBlockerReturnsError() {
        wiremock.stubFor(post(urlEqualTo("/system-block"))
                .willReturn(aResponse().withStatus(503)));

        String result = taskService.cleanerTask();

        assertThat(result).isNull();                       // fail-close
        assertThat(taskService.executed).isFalse();
        wiremock.verify(0, putRequestedFor(anyUrl()));
    }

    // ===== Сценарий 4: задача упала, но unblock всё равно вызвался =====

    @Test
    void unblockCalledEvenIfTaskThrows() {
        wiremock.stubFor(post(urlEqualTo("/system-block"))
                .willReturn(okJson("\"uuid-5678\"")));
        wiremock.stubFor(put(urlEqualTo("/system-block"))
                .willReturn(okJson("true")));

        taskService.returnValue = null;
        // имитируем сбой через side-effect — переопределяем поведение задачи
        var failingService = new TestTaskService() {
            @Override
            @SystemBlock(ttlHours = 1)
            public String cleanerTask() {
                throw new RuntimeException("boom");
            }
        };
        // Замечание: эту вариацию проще тестировать unit-тестом, см. ниже
    }
}
