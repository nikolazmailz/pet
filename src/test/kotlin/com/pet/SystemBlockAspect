@Aspect
@Component
@RequiredArgsConstructor
public class SystemBlockAspect {

    private final TaskBlockerClient client;

    @Value("${spring.application.name:${SERVICE_NAME:unknown-service}}")
    private String serviceName;

    @Around("@annotation(systemBlock)")
    public Object around(ProceedingJoinPoint pjp, SystemBlock systemBlock) throws Throwable {
        String methodName = ((MethodSignature) pjp.getSignature()).getMethod().getName();
        String operationCode = serviceName + " " + methodName;   // напр. "srhr-ms-sys-housekeep cleanerTask"

        String blockId = client.block(operationCode, Duration.ofHours(systemBlock.ttlHours()));
        if (blockId == null) {
            // блокировка занята другим инстансом — молча выходим, без исключения
            return null;
        }
        try {
            return pjp.proceed();
        } finally {
            client.unblock(blockId);
        }
    }
}


@Aspect
@RequiredArgsConstructor
@Slf4j
public class SystemBlockAspect {

    private final TaskBlockerClient client;

    @Value("${spring.application.name:${SERVICE_NAME:unknown-service}}")
    private String serviceName;

    @Around("@annotation(systemBlock)")
    public Object around(ProceedingJoinPoint pjp, SystemBlock systemBlock) throws Throwable {
        String methodName = ((MethodSignature) pjp.getSignature()).getMethod().getName();
        String operationCode = serviceName + " " + methodName;
        String ttl = formatHms(Duration.ofHours(systemBlock.ttlHours()));

        String blockId;
        try {
            blockId = client.block(new SystemBlockRequestDto(operationCode, ttl));
        } catch (FeignException e) {
            log.warn("Task-blocker unreachable, skipping task {}: {}", operationCode, e.getMessage());
            return null;                                       // fail-close при сетевой ошибке
        }

        if (blockId == null) {
            return null;                                       // блокировка занята
        }

        try {
            return pjp.proceed();
        } finally {
            try {
                client.unblock(new SystemUnblockRequestDto(blockId));
            } catch (FeignException e) {
                log.warn("Failed to release lock {}: {}", blockId, e.getMessage());
                // не пробрасываем — задача уже выполнена, блок снимется по TTL
            }
        }
    }

    private static String formatHms(Duration d) {
        long s = d.getSeconds();
        return String.format("%02d:%02d:%02d", s / 3600, (s % 3600) / 60, s % 60);
    }
}



private static final Pattern HMS = Pattern.compile("\\d{2}:\\d{2}:\\d{2}");

@Around("@annotation(systemBlock)")
public Object around(ProceedingJoinPoint pjp, SystemBlock systemBlock) throws Throwable {
    String ttl = environment.resolvePlaceholders(systemBlock.ttl());

    if (!HMS.matcher(ttl).matches()) {
        throw new IllegalArgumentException(
                "Invalid @SystemBlock ttl format: '" + ttl + "', expected HH:mm:ss");
    }

    // дальше как было
}
