@Configuration
@EnableAspectJAutoProxy
public class TaskBlockerClientConfig {

    @Bean
    @ConditionalOnMissingBean
    public RestTemplate taskBlockerRestTemplate() {
        return new RestTemplateBuilder()
                .setConnectTimeout(Duration.ofSeconds(2))
                .setReadTimeout(Duration.ofSeconds(5))
                .build();
    }
}



@Configuration
@EnableAspectJAutoProxy
@ConditionalOnProperty(prefix = "srhr.task-blocker", name = "enabled",
                       havingValue = "true", matchIfMissing = false)
public class TaskBlockerClientConfig {

    @Bean public RestTemplate taskBlockerRestTemplate() { ... }
    @Bean public TaskBlockerClient taskBlockerClient(RestTemplate rt) { ... }
    @Bean public SystemBlockAspect systemBlockAspect(TaskBlockerClient c) { ... }
}



@Configuration
@EnableAspectJAutoProxy
public class TaskBlockerClientConfig {

    @Bean
    @ConditionalOnMissingBean
    public RestTemplate taskBlockerRestTemplate(TaskBlockerProperties properties) { ... }

    @Bean
    public TaskBlockerClient taskBlockerClient(RestTemplate rt, TaskBlockerProperties props) {
        return new TaskBlockerClient(rt, props);
    }

    @Bean
    public SystemBlockAspect systemBlockAspect(TaskBlockerClient client) {
        return new SystemBlockAspect(client);
    }
}
