package ru.ntdev.srhr.mod.commons.taskblocker.application.aspect;

import feign.FeignException;
import feign.Request;
import feign.Response;
import org.aspectj.lang.ProceedingJoinPoint;
import org.aspectj.lang.reflect.MethodSignature;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.ArgumentCaptor;
import org.springframework.test.util.ReflectionTestUtils;

import ru.ntdev.srhr.mod.commons.taskblocker.annotation.SystemBlock;
import ru.ntdev.srhr.mod.commons.taskblocker.infra.client.TaskBlockerClient;
import ru.ntdev.srhr.mod.commons.taskblocker.infra.client.dto.SystemBlockRequestDto;
import ru.ntdev.srhr.mod.commons.taskblocker.infra.client.dto.SystemUnblockRequestDto;

import java.lang.reflect.Method;
import java.nio.charset.StandardCharsets;
import java.util.Map;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.anyString;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.never;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;

class SystemBlockAspectTest {

    private TaskBlockerClient client;
    private SystemBlockAspect aspect;
    private ProceedingJoinPoint pjp;
    private SystemBlock annotation;

    @BeforeEach
    void setUp() throws NoSuchMethodException {
        client = mock(TaskBlockerClient.class);
        aspect = new SystemBlockAspect(client);

        // @Value-поле serviceName инжектится Spring'ом, в unit-тесте подставляем сами
        ReflectionTestUtils.setField(aspect, "serviceName", "test-service");

        pjp = mock(ProceedingJoinPoint.class);
        var signature = mock(MethodSignature.class);
        Method method = SystemBlockAspectTest.class.getDeclaredMethod("dummyTaskMethod");
        when(pjp.getSignature()).thenReturn(signature);
        when(signature.getMethod()).thenReturn(method);

        annotation = mock(SystemBlock.class);
        when(annotation.ttlHours()).thenReturn(1L);
    }

    // ===== Сценарий 1: успешный захват блокировки =====

    @Test
    void taskRunsWhenLockAcquired() throws Throwable {
        when(client.block(any())).thenReturn("uuid-1234");
        when(pjp.proceed()).thenReturn("task-result");

        Object result = aspect.around(pjp, annotation);

        assertThat(result).isEqualTo("task-result");
        verify(pjp).proceed();
        verify(client).unblock(new SystemUnblockRequestDto("uuid-1234"));
    }

    @Test
    void operationCodeIsServiceNamePlusMethodName() throws Throwable {
        when(client.block(any())).thenReturn("uuid-1234");
        var captor = ArgumentCaptor.forClass(SystemBlockRequestDto.class);

        aspect.around(pjp, annotation);

        verify(client).block(captor.capture());
        assertThat(captor.getValue().operationCode())
                .isEqualTo("test-service dummyTaskMethod");
    }

    @Test
    void ttlIsFormattedAsHmsString() throws Throwable {
        when(annotation.ttlHours()).thenReturn(2L);
        when(client.block(any())).thenReturn("uuid-1234");
        var captor = ArgumentCaptor.forClass(SystemBlockRequestDto.class);

        aspect.around(pjp, annotation);

        verify(client).block(captor.capture());
        assertThat(captor.getValue().blockTTL()).isEqualTo("02:00:00");
    }

    // ===== Сценарий 2: блокировка занята =====

    @Test
    void taskSkippedWhenLockBusy() throws Throwable {
        when(client.block(any())).thenReturn(null);   // блокировщик отказал

        Object result = aspect.around(pjp, annotation);

        assertThat(result).isNull();
        verify(pjp, never()).proceed();                // задача не запустилась
        verify(client, never()).unblock(any());        // и unblock не звался
    }

    // ===== Сценарий 3: задача упала с исключением =====

    @Test
    void unblockCalledEvenIfTaskThrows() throws Throwable {
        when(client.block(any())).thenReturn("uuid-1234");
        when(pjp.proceed()).thenThrow(new RuntimeException("boom"));

        assertThatThrownBy(() -> aspect.around(pjp, annotation))
                .isInstanceOf(RuntimeException.class)
                .hasMessage("boom");

        verify(client).unblock(new SystemUnblockRequestDto("uuid-1234"));  // finally сработал
    }

    // ===== Сценарий 4: блокировщик недоступен (FeignException на block) =====

    @Test
    void taskSkippedWhenBlockerUnreachable() throws Throwable {
        when(client.block(any())).thenThrow(feignException(503));

        Object result = aspect.around(pjp, annotation);

        assertThat(result).isNull();                   // fail-close
        verify(pjp, never()).proceed();
        verify(client, never()).unblock(any());
    }

    // ===== Сценарий 5: блокировщик недоступен при unblock — задача всё равно выполняется =====

    @Test
    void taskCompletesEvenIfUnblockFails() throws Throwable {
        when(client.block(any())).thenReturn("uuid-1234");
        when(pjp.proceed()).thenReturn("task-result");
        when(client.unblock(any())).thenThrow(feignException(503));

        Object result = aspect.around(pjp, annotation);

        assertThat(result).isEqualTo("task-result");   // результат не теряется
        verify(pjp).proceed();
        verify(client).unblock(any());                 // попытка была
        // исключение проглочено — блок снимется по TTL
    }

    // ===== вспомогательное =====

    private static FeignException feignException(int status) {
        Request request = Request.create(
                Request.HttpMethod.POST, "/system-block",
                Map.of(), null, StandardCharsets.UTF_8, null);
        Response response = Response.builder()
                .status(status)
                .request(request)
                .build();
        return FeignException.errorStatus("block", response);
    }

    @SuppressWarnings("unused")
    private void dummyTaskMethod() { /* нужен только как Method-объект */ }
}
